id49679a63-86b3-11f1-937c-a78dceb78abb","identifier":"/us/usc/t7/s7932/d/1"},"text":null,"children":[{"tag":"num","attrib":{"value":"1"},"text":"(1)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" in the case of dry peas, United States feed peas;","children":[],"tail":"\n"}],"tail":"\n"},{"tag":"paragraph","attrib":{"id":"id49679a64-86b3-11f1-937c-a78dceb78abb","identifier":"/us/usc/t7/s7932/d/2"},"text":null,"children":[{"tag":"num","attrib":{"value":"2"},"text":"(2)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" in the case of lentils, United States number 3 lentils; and","children":[],"tail":"\n"}],"tail":"\n"},{"tag":"paragraph","attrib":{"id":"id49679a65-86b3-11f1-937c-a78dceb78abb","identifier":"/us/usc/t7/s7932/d/3"},"text":null,"children":[{"tag":"num","attrib":{"value":"3"},"text":"(3)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" in the case of small chickpeas, United States number 3 small chickpeas that drop below a 20/64 screen.","children":[],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"sourceCredit","attrib":{"id":"id49679a66-86b3-11f1-937c-a78dceb78abb"},"text":"(","children":[{"tag":"ref","attrib":{"href":"/us/pl/107/171/tI/s1202"},"text":"Pub. L. 107–171, title I, § 1202","children":[],"tail":", "},{"tag":"date","attrib":{"date":"2002-05-13"},"text":"May 13, 2002","children":[],"tail":", "},{"tag":"ref","attrib":{"href":"/us/stat/116/155"},"text":"116 Stat. 155","children":[],"tail":"; "},{"tag":"ref","attrib":{"href":"/us/pl/108/7/dA/tVII/s763/b"},"text":"Pub. L. 108–7, div. A, title VII, § 763(b)","children":[],"tail":", "},{"tag":"date","attrib":{"date":"2003-02-20"},"text":"Feb. 20, 2003","children":[],"tail":", "},{"tag":"ref","attrib":{"href":"/us/stat/117/46"},"text":"117 Stat. 46","children":[],"tail":".)"}],"tail":"\n"},{"tag":"notes","attrib":{"type":"uscNote","id":"id49679a67-86b3-11f1-937c-a78dceb78abb"},"text":"\n","children":[{"tag":"note","attrib":{"role":"crossHeading","top