{"tag":"section","attrib":{"id":"id486aea39-86b3-11f1-937c-a78dceb78abb","identifier":"/us/usc/t7/s2009n"},"text":null,"children":[{"tag":"num","attrib":{"value":"2009n"},"text":"§ 2009n.","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Rural Community Development Initiative","children":[],"tail":null},{"tag":"subsection","attrib":{"id":"id486aea3a-86b3-11f1-937c-a78dceb78abb","identifier":"/us/usc/t7/s2009n/a"},"text":null,"children":[{"tag":"num","attrib":{"value":"a"},"text":"(a)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Definitions","children":[],"tail":null},{"tag":"chapeau","attrib":{},"text":"In this section:","children":[],"tail":null},{"tag":"paragraph","attrib":{"id":"id486aea3b-86b3-11f1-937c-a78dceb78abb","identifier":"/us/usc/t7/s2009n/a/1"},"text":null,"children":[{"tag":"num","attrib":{"value":"1"},"text":"(1)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Eligible entity","children":[],"tail":null},{"tag":"chapeau","attrib":{},"text":"The term “eligible entity” means—","children":[],"tail":null},{"tag":"subparagraph","attrib":{"id":"id486aea3c-86b3-11f1-937c-a78dceb78abb","identifier":"/us/usc/t7/s2009n/a/1/A"},"text":null,"children":[{"tag":"num","attrib":{"value":"A"},"text":"(A)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" a private, nonprofit community-based housing or community development organization;","children":[],"tail":"\n"}],"tail":"\n"},{"tag":"subparagraph","attrib":{"id":"id486aea3d-86b3-11f1-937c-a78dceb78abb","identifier":"/us/usc/t7/s2009n/a/1/B"},"text":null,"children":[{"tag":"num","attrib":{"value":"B"},"text":"(B)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" a rural community; or","children":[],"tail":"\n"}],"tail":"\n"},{"tag":"subparagraph","attrib":{"id":"id486aea3e-86b3-11f1-937c-a78dceb78abb","identifier":"/us/usc/t7/s2009n/a/1/C"},"text":null,"children":[{"tag":"num","attrib":{"value":"C"},"text":"(C)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" a federally recognized Indian tribe.","children":[],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"paragraph","attrib":{"id":"id486aea3f-86b3-11f1-937c-a78dceb78abb","identifier":"/us/usc/t7/s2009n/a/2"},"text":null,"children":[{"tag":"num","attrib":{"value":"2"},"text":"(2)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Eligible intermediary","children":[],"tail":null},{"tag":"chapeau","attrib":{},"text":"The term “eligible intermediary” means a qualified—","children":[],"tail":null},{"tag":"subparagraph","attrib":{"id":"id486aea40-86b3-11f1-937c-a78dceb78abb","identifier":"/us/usc/t7/s2009n/a/2/A"},"text":null,"children":[{"tag":"num","attrib":{"value":"A"},"text":"(A)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" private, nonprofit organization; or","children":[],"tail":"\n"}],"tail":"\n"},{"tag":"subparagraph","attrib":{"id":"id486aea41-86b3-11f1-937c-a78dceb78abb","identifier":"/us/usc/t7/s2009n/a/2/B"},"text":null,"children":[{"tag":"num","attrib":{"value":"B"},"text":"(B)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" public organization.","children":[],"tail":"\n"}],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"subsection","attrib":{"id":"id486aea42-86b3-11f1-937c-a78dceb78abb","identifier":"/us/usc/t7/s2009n/b"},"text":null,"children":[{"tag":"num","attrib":{"value":"b"},"text":"(b)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Establishment","children":[],"tail":null},{"tag":"content","attrib":{},"text":null,"children":[{"tag":"p","attrib":{},"text":"The Secretary shall establish a Rural Community Development Initiative, under which the Secretary shall provide grants, subject to the availability of appropriations, to eligible intermediaries to carry out programs to provide financial and technical assistance to eligible entities to develop the capacity and ability of eligible entities to carry out projects to improve housing, community facilities, and community and economic development projects in rural areas.","children":[],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"subsection","attrib":{"id":"id486aea43-86b3-11f1-937c-a78dceb78abb","identifier":"/us/usc/t7/s2009n/c"},"text":null,"children":[{"tag":"num","attrib":{"value":"c"},"text":"(c)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Amount of grants","children":[],"tail":null},{"tag":"content","attrib":{},"text":null,"children":[{"tag":"p","attrib":{},"text":"The amount of a grant provided to an eligible intermediary under this section shall be not more than $500,000.","children":[],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"subsection","attrib":{"id":"id486aea44-86b3-11f1-937c-a78dceb78abb","identifier":"/us/usc/t7/s2009n/d"},"text":null,"children":[{"tag":"num","attrib":{"value":"d"},"text":"(d)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Matching funds","children":[],"tail":null},{"tag":"paragraph","attrib":{"id":"id486aea45-86b3-11f1-937c-a78dceb78abb","identifier":"/us/usc/t7/s2009n/d/1"},"text":null,"children":[{"tag":"num","attrib":{"value":"1"},"text":"(1)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" In general","children":[],"tail":null},{"tag":"content","attrib":{},"text":null,"children":[{"tag":"p","attrib":{},"text":"An eligible intermediary receiving a grant under this section shall provide matching funds from other sources, including Federal funds for related activities, in an amount not less than the amount of the grant.","children":[],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"paragraph","attrib":{"id":"id486d3336-86b3-11f1-937c-a78dceb78abb","identifier":"/us/usc/t7/s2009n/d/2"},"text":null,"children":[{"tag":"num","attrib":{"value":"2"},"text":"(2)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Waiver","children":[],"tail":null},{"tag":"content","attrib":{},"text":null,"children":[{"tag":"p","attrib":{},"text":"The Secretary may waive paragraph (1) with respect to a project that would be carried out in a persistently poor rural region, as determined by the Secretary.","children":[],"tail":"\n"}],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"sourceCredit","attrib":{"id":"id486d3337-86b3-11f1-937c-a78dceb78abb"},"text":"(","children":[{"tag":"ref","attrib":{"href":"/us/pl/87/128/tIII/s381O"},"text":"Pub. L. 87–128, title III, § 381O","children":[],"tail":", as added "},{"tag":"ref","attrib":{"href":"/us/pl/119/101/tV/s502/h"},"text":"Pub. L. 119–101, title V, § 502(h)","children":[],"tail":", "},{"tag":"date","attrib":{"date":"2026-07-11"},"text":"July 11, 2026","children":[],"tail":", "},{"tag":"ref","attrib":{"href":"/us/stat/140/923"},"text":"140 Stat. 923","children":[],"tail":".)"}],"tail":"\n"},{"tag":"notes","attrib":{"type":"uscNote","id":"id486d3338-86b3-11f1-937c-a78dceb78abb"},"text":"\n","children":[{"tag":"note","attrib":{"role":"crossHeading","topic":"editorialNotes","id":"id486d3339-86b3-11f1-937c-a78dceb78abb"},"text":null,"children":[{"tag":"heading","attrib":{},"text":null,"children":[{"tag":"b","attrib":{},"text":"Editorial Notes","children":[],"tail":null}],"tail":null}],"tail":"\n"},{"tag":"note","attrib":{"topic":"priorProvisions","id":"id486d333a-86b3-11f1-937c-a78dceb78abb"},"text":null,"children":[{"tag":"heading","attrib":{},"text":"Prior Provisions","children":[],"tail":null},{"tag":"p","attrib":{},"text":"A prior section 2009n, ","children":[{"tag":"ref","attrib":{"href":"/us/pl/87/128/tIII/s381O"},"text":"Pub. L. 87–128, title III, § 381O","children":[],"tail":", as added "},{"tag":"ref","attrib":{"href":"/us/pl/104/127/tVII/s761"},"text":"Pub. L. 104–127, title VII, § 761","children":[],"tail":", "},{"tag":"date","attrib":{"date":"1996-04-04"},"text":"Apr. 4, 1996","children":[],"tail":", "},{"tag":"ref","attrib":{"href":"/us/stat/110/1147"},"text":"110 Stat. 1147","children":[],"tail":", related to rural venture capital demonstration program, prior to repeal by "},{"tag":"ref","attrib":{"href":"/us/pl/107/171/tVI/s6026/b"},"text":"Pub. L. 107–171, title VI, § 6026(b)","children":[],"tail":", "},{"tag":"date","attrib":{"date":"2002-05-13"},"text":"May 13, 2002","children":[],"tail":", "},{"tag":"ref","attrib":{"href":"/us/stat/116/372"},"text":"116 Stat. 372","children":[],"tail":"."}],"tail":"\n"}],"tail":"\n"}],"tail":"\n"}],"tail":null}
