{"tag":"section","attrib":{"id":"id47d49d3b-86b3-11f1-937c-a78dceb78abb","identifier":"/us/usc/t7/s1368"},"text":null,"children":[{"tag":"num","attrib":{"value":"1368"},"text":"§ 1368.","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Effect of increase on other quotas","children":[],"tail":null},{"tag":"content","attrib":{},"text":"\n","children":[{"tag":"p","attrib":{},"text":"Notwithstanding any increase of any farm marketing quota for any farm as a result of review of the determination thereof under this subpart, the marketing quotas for other farms shall not be affected.","children":[],"tail":"\n"}],"tail":null},{"tag":"sourceCredit","attrib":{"id":"id47d49d3c-86b3-11f1-937c-a78dceb78abb"},"text":"(","children":[{"tag":"ref","attrib":{"href":"/us/act/1938-02-16/ch30"},"text":"Feb. 16, 1938, ch. 30","children":[],"tail":", title III, § 368, "},{"tag":"ref","attrib":{"href":"/us/stat/52/64"},"text":"52 Stat. 64","children":[],"tail":".)"}],"tail":"\n"}],"tail":null}
