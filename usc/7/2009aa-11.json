{"tag":"section","attrib":{"id":"id486d3452-86b3-11f1-937c-a78dceb78abb","identifier":"/us/usc/t7/s2009aa–11"},"text":null,"children":[{"tag":"num","attrib":{"value":"2009aa–11"},"text":"§ 2009aa–11.","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Annual report","children":[],"tail":null},{"tag":"content","attrib":{},"text":"\n","children":[{"tag":"p","attrib":{},"text":"Not later than 180 days after the end of each fiscal year, the Authority shall submit to the President and to Congress a report describing the activities carried out under this subchapter.","children":[],"tail":"\n"}],"tail":null},{"tag":"sourceCredit","attrib":{"id":"id486d3453-86b3-11f1-937c-a78dceb78abb"},"text":"(","children":[{"tag":"ref","attrib":{"href":"/us/pl/87/128/tIII/s382L"},"text":"Pub. L. 87–128, title III, § 382L","children":[],"tail":", as added "},{"tag":"ref","attrib":{"href":"/us/pl/106/554/s1/a/4/dB/tV/s503"},"text":"Pub. L. 106–554, § 1(a)(4) [div. B, title V, § 503]","children":[],"tail":", "},{"tag":"date","attrib":{"date":"2000-12-21"},"text":"Dec. 21, 2000","children":[],"tail":", "},{"tag":"ref","attrib":{"href":"/us/stat/114/2763"},"text":"114 Stat. 2763","children":[],"tail":", 2763A–280.)"}],"tail":"\n"}],"tail":null}
