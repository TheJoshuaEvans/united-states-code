{"tag":"section","attrib":{"id":"id6b863089-86b3-11f1-8c1e-ca5e0ea6b57b","identifier":"/us/usc/t15/s1677"},"text":null,"children":[{"tag":"num","attrib":{"value":"1677"},"text":"§ 1677.","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Effect on State laws","children":[],"tail":"\n"},{"tag":"chapeau","attrib":{},"text":"This subchapter does not annul, alter, or affect, or exempt any person from complying with, the laws of any State","children":[],"tail":null},{"tag":"paragraph","attrib":{"id":"id6b86308a-86b3-11f1-8c1e-ca5e0ea6b57b","identifier":"/us/usc/t15/s1677/1"},"text":null,"children":[{"tag":"num","attrib":{"value":"1"},"text":"(1)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" prohibiting garnishments or providing for more limited garnishment than are allowed under this subchapter, or","children":[],"tail":"\n"}],"tail":"\n"},{"tag":"paragraph","attrib":{"id":"id6b86308b-86b3-11f1-8c1e-ca5e0ea6b57b","identifier":"/us/usc/t15/s1677/2"},"text":null,"children":[{"tag":"num","attrib":{"value":"2"},"text":"(2)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" prohibiting the discharge of any employee by reason of the fact that his earnings have been subjected to garnishment for more than one indebtedness.","children":[],"tail":"\n"}],"tail":"\n"},{"tag":"sourceCredit","attrib":{"id":"id6b86308c-86b3-11f1-8c1e-ca5e0ea6b57b"},"text":"(","children":[{"tag":"ref","attrib":{"href":"/us/pl/90/321/tIII/s307"},"text":"Pub. L. 90–321, title III, § 307","children":[],"tail":", "},{"tag":"date","attrib":{"date":"1968-05-29"},"text":"May 29, 1968","children":[],"tail":", "},{"tag":"ref","attrib":{"href":"/us/stat/82/164"},"text":"82 Stat. 164","children":[],"tail":".)"}],"tail":"\n"}],"tail":null}
