{"tag":"section","attrib":{"id":"id6c6ff3b2-86b3-11f1-8c1e-ca5e0ea6b57b","identifier":"/us/usc/t15/s8533"},"text":null,"children":[{"tag":"num","attrib":{"value":"8533"},"text":"§ 8533.","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Unnecessary duplication","children":[],"tail":null},{"tag":"content","attrib":{},"text":"\n","children":[{"tag":"p","attrib":{},"text":"In meeting the requirements under this subchapter, the Under Secretary shall avoid unnecessary duplication between public and private sources of data and the corresponding expenditure of funds and employment of personnel.","children":[],"tail":"\n"}],"tail":null},{"tag":"sourceCredit","attrib":{"id":"id6c6ff3b3-86b3-11f1-8c1e-ca5e0ea6b57b"},"text":"(","children":[{"tag":"ref","attrib":{"href":"/us/pl/115/25/tIII/s303"},"text":"Pub. L. 115–25, title III, § 303","children":[],"tail":", "},{"tag":"date","attrib":{"date":"2017-04-18"},"text":"Apr. 18, 2017","children":[],"tail":", "},{"tag":"ref","attrib":{"href":"/us/stat/131/105"},"text":"131 Stat. 105","children":[],"tail":".)"}],"tail":"\n"}],"tail":null}
