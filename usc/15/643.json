{"tag":"section","attrib":{"id":"id6ae3fd00-86b3-11f1-8c1e-ca5e0ea6b57b","identifier":"/us/usc/t15/s643"},"text":null,"children":[{"tag":"num","attrib":{"value":"643"},"text":"§ 643.","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Fair charge for use of Government-owned property","children":[],"tail":null},{"tag":"content","attrib":{},"text":"\n","children":[{"tag":"p","attrib":{},"text":"To the fullest extent the Administration deems practicable, it shall make a fair charge for the use of Government-owned property and make and let contracts on a basis that will result in a recovery of the direct costs incurred by the Administration.","children":[],"tail":"\n"}],"tail":null},{"tag":"sourceCredit","attrib":{"id":"id6ae3fd01-86b3-11f1-8c1e-ca5e0ea6b57b"},"text":"(","children":[{"tag":"ref","attrib":{"href":"/us/pl/85/536/s2/s14"},"text":"Pub. L. 85–536, § 2[14]","children":[],"tail":", "},{"tag":"date","attrib":{"date":"1958-07-18"},"text":"July 18, 1958","children":[],"tail":", "},{"tag":"ref","attrib":{"href":"/us/stat/72/395"},"text":"72 Stat. 395","children":[],"tail":".)"}],"tail":"\n"},{"tag":"notes","attrib":{"type":"uscNote","id":"id6ae3fd02-86b3-11f1-8c1e-ca5e0ea6b57b"},"text":"\n","children":[{"tag":"note","attrib":{"role":"crossHeading","topic":"editorialNotes","id":"id6ae3fd03-86b3-11f1-8c1e-ca5e0ea6b57b"},"text":null,"children":[{"tag":"heading","attrib":{},"text":null,"children":[{"tag":"b","attrib":{},"text":"Editorial Notes","children":[],"tail":null}],"tail":null}],"tail":"\n"},{"tag":"note","attrib":{"topic":"priorProvisions","id":"id6ae3fd04-86b3-11f1-8c1e-ca5e0ea6b57b"},"text":null,"children":[{"tag":"heading","attrib":{},"text":"Prior Provisions","children":[],"tail":null},{"tag":"p","attrib":{},"text":"Prior similar provisions were contained in section 220 of ","children":[{"tag":"ref","attrib":{"href":"/us/act/1953-07-30/ch282/tII"},"text":"act July 30, 1953, ch. 282, title II","children":[],"tail":", "},{"tag":"ref","attrib":{