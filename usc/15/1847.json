{"tag":"section","attrib":{"id":"id6bac55e4-86b3-11f1-8c1e-ca5e0ea6b57b","identifier":"/us/usc/t15/s1847"},"text":null,"children":[{"tag":"num","attrib":{"value":"1847"},"text":"§ 1847.","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Maximum obligation","children":[],"tail":null},{"tag":"content","attrib":{},"text":"\n","children":[{"tag":"p","attrib":{},"text":"The maximum obligation of the Board under all outstanding loans guaranteed by it shall not exceed at any time $250,000,000.","children":[],"tail":"\n"}],"tail":null},{"tag":"sourceCredit","attrib":{"id":"id6bac55e5-86b3-11f1-8c1e-ca5e0ea6b57b"},"text":"(","children":[{"tag":"ref","attrib":{"href":"/us/pl/92/70/s8"},"text":"Pub. L. 92–70, § 8","children":[],"tail":", "},{"tag":"date","attrib":{"date":"1971-08-09"},"text":"Aug. 9, 1971","children":[],"tail":", "},{"tag":"ref","attrib":{"href":"/us/stat/85/181"},"text":"85 Stat. 181","children":[],"tail":".)"}],"tail":"\n"}],"tail":null}
