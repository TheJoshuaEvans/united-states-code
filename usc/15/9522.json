{"tag":"section","attrib":{"id":"id6c96198e-86b3-11f1-8c1e-ca5e0ea6b57b","identifier":"/us/usc/t15/s9522"},"text":null,"children":[{"tag":"num","attrib":{"value":"9522"},"text":"§ 9522.","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Purpose","children":[],"tail":"\n"},{"tag":"chapeau","attrib":{},"text":"The purpose of the MBDA Business Center Program shall be to create a national network of public-private partnerships that—","children":[],"tail":null},{"tag":"paragraph","attrib":{"id":"id6c96198f-86b3-11f1-8c1e-ca5e0ea6b57b","identifier":"/us/usc/t15/s9522/1"},"text":null,"children":[{"tag":"num","attrib":{"value":"1"},"text":"(1)","children":[],"tail":null},{"tag":"chapeau","attrib":{},"text":" assist minority business enterprises in—","children":[],"tail":null},{"tag":"subparagraph","attrib":{"id":"id6c961990-86b3-11f1-8c1e-ca5e0ea6b57b","identifier":"/us/usc/t15/s9522/1/A"},"text":null,"children":[{"tag":"num","attrib":{"value":"A"},"text":"(A)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" accessing capital, contracts, and grants; and","children":[],"tail":"\n"}],"tail":"\n"},{"tag":"subparagraph","attrib":{"id":"id6c961991-86b3-11f1-8c1e-ca5e0ea6b57b","identifier":"/us/usc/t15/s9522/1/B"},"text":null,"children":[{"tag":"num","attrib":{"value":"B"},"text":"(B)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" creating and maintaining jobs;","children":[],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"paragraph","attrib":{"id":"id6c961992-86b3-11f1-8c1e-ca5e0ea6b57b","identifier":"/us/usc/t15/s9522/2"},"text":null,"children":[{"tag":"num","attrib":{"value":"2"},"text":"(2)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" provide counseling and mentoring to minority business enterprises; and","children":[],"tail":"\n"}],"tail":"\n"},{"tag":"paragraph","attrib":{"id":"id6c961993-86b3-11f1-8c1e-ca5e0ea6b57b","identifier":"/us/usc/t15/s9522/3"},"text":null,"children":[{"tag":"num","attrib":{"va