{"tag":"section","attrib":{"id":"id6a9a223e-86b3-11f1-8c1e-ca5e0ea6b57b","identifier":"/us/usc/t15/s383"},"text":null,"children":[{"tag":"num","attrib":{"value":"383"},"text":"§ 383.","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" “Net income tax” defined","children":[],"tail":null},{"tag":"content","attrib":{},"text":"\n","children":[{"tag":"p","attrib":{},"text":"For purposes of this chapter, the term “net income tax” means any tax imposed on, or measured by, net income.","children":[],"tail":"\n"}],"tail":null},{"tag":"sourceCredit","attrib":{"id":"id6a9a223f-86b3-11f1-8c1e-ca5e0ea6b57b"},"text":"(","children":[{"tag":"ref","attrib":{"href":"/us/pl/86/272/tI/s103"},"text":"Pub. L. 86–272, title I, § 103","children":[],"tail":", "},{"tag":"date","attrib":{"date":"1959-09-14"},"text":"Sept. 14, 1959","children":[],"tail":", "},{"tag":"ref","attrib":{"href":"/us/stat/73/556"},"text":"73 Stat. 556","children":[],"tail":".)"}],"tail":"\n"}],"tail":null}
