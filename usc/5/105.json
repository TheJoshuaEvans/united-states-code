{"tag":"section","attrib":{"id":"id0106f611-810c-11f1-88fc-c715e7e6606c","identifier":"/us/usc/t5/s105"},"text":null,"children":[{"tag":"num","attrib":{"value":"105"},"text":"§ 105.","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Executive agency","children":[],"tail":null},{"tag":"content","attrib":{},"text":"\n","children":[{"tag":"p","attrib":{},"text":"For the purpose of this title, “Executive agency” means an Executive department, a Government corporation, and an independent establishment.","children":[],"tail":"\n"}],"tail":null},{"tag":"sourceCredit","attrib":{"id":"id0106f612-810c-11f1-88fc-c715e7e6606c"},"text":"(","children":[{"tag":"ref","attrib":{"href":"/us/pl/89/554"},"text":"Pub. L. 89–554","children":[],"tail":", "},{"tag":"date","attrib":{"date":"1966-09-06"},"text":"Sept. 6, 1966","children":[],"tail":", "},{"tag":"ref","attrib":{"href":"/us/stat/80/379"},"text":"80 Stat. 379","children":[],"tail":".)"}],"tail":"\n"},{"tag":"notes","attrib":{"type":"uscNote","id":"id01096713-810c-11f1-88fc-c715e7e6606c"},"text":"\n","children":[{"tag":"note","attrib":{"topic":"historicalAndRevision","id":"id01096714-810c-11f1-88fc-c715e7e6606c"},"text":null,"children":[{"tag":"heading","attrib":{},"text":"Historical and Revision Notes","children":[],"tail":null},{"tag":"p","attrib":{},"text":"The section is supplied to avoid the necessity for defining “Executive agency” each time it is used in this title.","children":[],"tail":"\n"}],"tail":"\n"}],"tail":"\n"}],"tail":null}
