{"tag":"section","attrib":{"id":"id015a6d67-810c-11f1-88fc-c715e7e6606c","identifier":"/us/usc/t5/s607"},"text":null,"children":[{"tag":"num","attrib":{"value":"607"},"text":"§ 607.","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Preparation of analyses","children":[],"tail":null},{"tag":"content","attrib":{},"text":"\n","children":[{"tag":"p","attrib":{},"text":"In complying with the provisions of sections 603 and 604 of this title, an agency may provide either a quantifiable or numerical description of the effects of a proposed rule or alternatives to the proposed rule, or more general descriptive statements if quantification is not practicable or reliable.","children":[],"tail":"\n"}],"tail":null},{"tag":"sourceCredit","attrib":{"id":"id015a6d68-810c-11f1-88fc-c715e7e6606c"},"text":"(Added ","children":[{"tag":"ref","attrib":{"href":"/us/pl/96/354/s3/a"},"text":"Pub. L. 96–354, § 3(a)","children":[],"tail":", "},{"tag":"date","attrib":{"date":"1980-09-19"},"text":"Sept. 19, 1980","children":[],"tail":", "},{"tag":"ref","attrib":{"href":"/us/stat/94/1168"},"text":"94 Stat. 1168","children":[],"tail":".)"}],"tail":"\n"},{"tag":"notes","attrib":{"type":"uscNote","id":"id015a6d69-810c-11f1-88fc-c715e7e6606c"},"text":"\n","children":[{"tag":"note","attrib":{"role":"crossHeading","topic":"statutoryNotes","id":"id015a6d6a-810c-11f1-88fc-c715e7e6606c"},"text":null,"children":[{"tag":"heading","attrib":{},"text":null,"children":[{"tag":"b","attrib":{},"text":"Statutory Notes and Related Subsidiaries","children":[],"tail":null}],"tail":null}],"tail":"\n"},{"tag":"note","attrib":{"topic":"effectiveDate","id":"id015a6d6b-810c-11f1-88fc-c715e7e6606c"},"text":null,"children":[{"tag":"heading","attrib":{},"text":"Effective Date","children":[],"tail":null},{"tag":"p","attrib":{},"text":"Section effective ","children":[{"tag":"date","attrib":{"date":"1981-01-01"},"text":"Jan. 1, 1981","children":[],"tail":", see "},{"tag":"ref","attrib":{"href":"/us/pl/96/354/s4"},"text":"section 4 of Pub. L. 96–354","children":[],"tail":", set out as a note under "},{"tag":"ref","attrib":{"href":"/us/usc/t5/s601"},"text":"section 601 of this title","children":[],"tail":"."}],"tail":"\n"}],"tail":"\n"}],"tail":"\n"}],"tail":null}
