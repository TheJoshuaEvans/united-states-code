{"tag":"section","attrib":{"id":"id02ce7020-810c-11f1-88fc-c715e7e6606c","identifier":"/us/usc/t5/s8985"},"text":null,"children":[{"tag":"num","attrib":{"value":"8985"},"text":"§ 8985.","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Information to individuals eligible to enroll","children":[],"tail":null},{"tag":"subsection","attrib":{"id":"id02ce7021-810c-11f1-88fc-c715e7e6606c","identifier":"/us/usc/t5/s8985/a"},"text":null,"children":[{"tag":"num","attrib":{"value":"a"},"text":"(a)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" The qualified companies at the direction and with the approval of the Office, shall make available to each individual eligible to enroll in a vision benefits plan information on services and benefits (including maximums, limitations, and exclusions), that the Office considers necessary to enable the individual to make an informed decision about electing coverage.","children":[],"tail":"\n"}],"tail":"\n"},{"tag":"subsection","attrib":{"id":"id02ce7022-810c-11f1-88fc-c715e7e6606c","identifier":"/us/usc/t5/s8985/b"},"text":null,"children":[{"tag":"num","attrib":{"value":"b"},"text":"(b)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" The Office shall make available to each individual eligible to enroll in a vision benefits plan, information on services and benefits provided by qualified companies participating under chapter 89.","children":[],"tail":"\n"}],"tail":"\n"},{"tag":"sourceCredit","attrib":{"id":"id02ce7023-810c-11f1-88fc-c715e7e6606c"},"text":"(Added ","children":[{"tag":"ref","attrib":{"href":"/us/pl/108/496/s3"},"text":"Pub. L. 108–496, § 3","children":[],"tail":", "},{"tag":"date","attrib":{"date":"2004-12-23"},"text":"Dec. 23, 2004","children":[],"tail":", "},{"tag":"ref","attrib":{"href":"/us/stat/118/4008"},"text":"118 Stat. 4008","children":[],"tail":".)"}],"tail":"\n"},{"tag":"notes","attrib":{"type":"uscNote","id":"id02ce7024-810c-11f1-88fc-c715e7e6606c"},"text":"\n","children":[{"tag":"note","attrib":{"role":"crossHeading","topic":"statutoryNotes","id":"id02ce7025-810c-11f1-88fc-c715e7e6606c"},"text":null,"children":[{"tag":"heading","attrib":{},"text":null,"children":[{"tag":"b","attrib":{},"text":"Statutory Notes and Related Subsidiaries","children":[],"tail":null}],"tail":null}],"tail":"\n"},{"tag":"note","attrib":{"topic":"effectiveDate","id":"id02ce7026-810c-11f1-88fc-c715e7e6606c"},"text":null,"children":[{"tag":"heading","attrib":{},"text":"Effective Date","children":[],"tail":null},{"tag":"p","attrib":{},"text":"Section effective ","children":[{"tag":"date","attrib":{"date":"2004-12-23"},"text":"Dec. 23, 2004","children":[],"tail":", and applicable to contracts that take effect with respect to the calendar year 2006, see "},{"tag":"ref","attrib":{"href":"/us/pl/108/496/s7"},"text":"section 7 of Pub. L. 108–496","children":[],"tail":", set out as a note under "},{"tag":"ref","attrib":{"href":"/us/usc/t5/s8951"},"text":"section 8951 of this title","children":[],"tail":"."}],"tail":"\n"}],"tail":"\n"}],"tail":"\n"}],"tail":null}
