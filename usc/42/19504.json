{"tag":"section","attrib":{"id":"id9d736844-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19504"},"text":null,"children":[{"tag":"num","attrib":{"value":"19504"},"text":"§ 19504.","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Grants for planning and implementation associated with affordable housing","children":[],"tail":null},{"tag":"subsection","attrib":{"id":"id9d736845-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19504/a"},"text":null,"children":[{"tag":"num","attrib":{"value":"a"},"text":"(a)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Definitions","children":[],"tail":null},{"tag":"chapeau","attrib":{},"text":"In this section:","children":[],"tail":null},{"tag":"paragraph","attrib":{"id":"id9d736846-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19504/a/1"},"text":null,"children":[{"tag":"num","attrib":{"value":"1"},"text":"(1)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Eligible entity","children":[],"tail":null},{"tag":"chapeau","attrib":{},"text":"The term “eligible entity” means—","children":[],"tail":null},{"tag":"subparagraph","attrib":{"id":"id9d736847-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19504/a/1/A"},"text":null,"children":[{"tag":"num","attrib":{"value":"A"},"text":"(A)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" a State, insular area, metropolitan city, or urban county, as those terms are defined in ","children":[{"tag":"ref","attrib":{"href":"/us/usc/t42/s5302"},"text":"section 5302 of this title","children":[],"tail":"; or"}],"tail":"\n"}],"tail":"\n"},{"tag":"subparagraph","attrib":{"id":"id9d736848-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19504/a/1/B"},"text":null,"children":[{"tag":"num","attrib":{"value":"B"},"text":"(B)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" a regional planning agency or consortia of regional planning agencies.","children":[],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"paragraph","attrib":{"id":"id9d736849-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19504/a/2"},"text":null,"children":[{"tag":"num","attrib":{"value":"2"},"text":"(2)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Housing plan","children":[],"tail":null},{"tag":"chapeau","attrib":{},"text":"The term “housing plan” means a plan to, with respect to an area within the jurisdiction of an eligible entity—","children":[],"tail":null},{"tag":"subparagraph","attrib":{"id":"id9d73684a-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19504/a/2/A"},"text":null,"children":[{"tag":"num","attrib":{"value":"A"},"text":"(A)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" increase the amount of available housing to meet the demand for such housing and any projected increase in the demand for such housing;","children":[],"tail":"\n"}],"tail":"\n"},{"tag":"subparagraph","attrib":{"id":"id9d73684b-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19504/a/2/B"},"text":null,"children":[{"tag":"num","attrib":{"value":"B"},"text":"(B)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" increase the affordability of housing;","children":[],"tail":"\n"}],"tail":"\n"},{"tag":"subparagraph","attrib":{"id":"id9d73684c-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19504/a/2/C"},"text":null,"children":[{"tag":"num","attrib":{"value":"C"},"text":"(C)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" increase the accessibility of housing for people with disabilities, including location-efficient housing;","children":[],"tail":"\n"}],"tail":"\n"},{"tag":"subparagraph","attrib":{"id":"id9d73684d-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19504/a/2/D"},"text":null,"children":[{"tag":"num","attrib":{"value":"D"},"text":"(D)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" preserve or improve the quality of housing;","children":[],"tail":"\n"}],"tail":"\n"},{"tag":"subparagraph","attrib":{"id":"id9d73684e-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19504/a/2/E"},"text":null,"children":[{"tag":"num","attrib":{"value":"E"},"text":"(E)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" reduce barriers to housing development; and","children":[],"tail":"\n"}],"tail":"\n"},{"tag":"subparagraph","attrib":{"id":"id9d73684f-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19504/a/2/F"},"text":null,"children":[{"tag":"num","attrib":{"value":"F"},"text":"(F)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" coordinate with transportation-related agencies.","children":[],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"paragraph","attrib":{"id":"id9d736850-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19504/a/3"},"text":null,"children":[{"tag":"num","attrib":{"value":"3"},"text":"(3)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Housing strategy","children":[],"tail":null},{"tag":"content","attrib":{},"text":null,"children":[{"tag":"p","attrib":{},"text":"The term “housing strategy” means a housing strategy required under ","children":[{"tag":"ref","attrib":{"href":"/us/usc/t42/s12705"},"text":"section 12705 of this title","children":[],"tail":"."}],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"paragraph","attrib":{"id":"id9d736851-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19504/a/4"},"text":null,"children":[{"tag":"num","attrib":{"value":"4"},"text":"(4)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Secretary","children":[],"tail":null},{"tag":"content","attrib":{},"text":null,"children":[{"tag":"p","attrib":{},"text":"The term “Secretary” means the Secretary of Housing and Urban Development.","children":[],"tail":"\n"}],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"subsection","attrib":{"id":"id9d736852-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19504/b"},"text":null,"children":[{"tag":"num","attrib":{"value":"b"},"text":"(b)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Establishment","children":[],"tail":null},{"tag":"content","attrib":{},"text":null,"children":[{"tag":"p","attrib":{},"text":"Not later than 1 year after ","children":[{"tag":"date","attrib":{"date":"2026-07-11"},"text":"July 11, 2026","children":[],"tail":", the Secretary shall establish a program to award grants on a competitive basis to eligible entities to assist planning and implementation activities associated with affordable housing, except that such grant awards may not be used for construction, alteration, or repair work."}],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"subsection","attrib":{"id":"id9d736853-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19504/c"},"text":null,"children":[{"tag":"num","attrib":{"value":"c"},"text":"(c)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Use of amounts","children":[],"tail":null},{"tag":"paragraph","attrib":{"id":"id9d736854-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19504/c/1"},"text":null,"children":[{"tag":"num","attrib":{"value":"1"},"text":"(1)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" By regional planning agencies","children":[],"tail":null},{"tag":"chapeau","attrib":{},"text":"If an eligible entity that receives amounts under this section is an eligible entity described in subsection (a)(1)(B), the eligible entity shall use those amounts to assist planning activities with respect to affordable housing, including—","children":[],"tail":null},{"tag":"subparagraph","attrib":{"id":"id9d736855-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19504/c/1/A"},"text":null,"children":[{"tag":"num","attrib":{"value":"A"},"text":"(A)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" the development of housing plans;","children":[],"tail":"\n"}],"tail":"\n"},{"tag":"subparagraph","attrib":{"id":"id9d736856-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19504/c/1/B"},"text":null,"children":[{"tag":"num","attrib":{"value":"B"},"text":"(B)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" the substantial improvement of State or local housing strategies;","children":[],"tail":"\n"}],"tail":"\n"},{"tag":"subparagraph","attrib":{"id":"id9d736857-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19504/c/1/C"},"text":null,"children":[{"tag":"num","attrib":{"value":"C"},"text":"(C)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" the development of new regulatory requirements and processes;","children":[],"tail":"\n"}],"tail":"\n"},{"tag":"subparagraph","attrib":{"id":"id9d736858-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19504/c/1/D"},"text":null,"children":[{"tag":"num","attrib":{"value":"D"},"text":"(D)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" updating zoning codes;","children":[],"tail":"\n"}],"tail":"\n"},{"tag":"subparagraph","attrib":{"id":"id9d736859-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19504/c/1/E"},"text":null,"children":[{"tag":"num","attrib":{"value":"E"},"text":"(E)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" increasing the capacity to conduct housing inspections;","children":[],"tail":"\n"}],"tail":"\n"},{"tag":"subparagraph","attrib":{"id":"id9d73685a-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19504/c/1/F"},"text":null,"children":[{"tag":"num","attrib":{"value":"F"},"text":"(F)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" increasing the capacity to reduce barriers to housing supply elasticity and housing affordability;","children":[],"tail":"\n"}],"tail":"\n"},{"tag":"subparagraph","attrib":{"id":"id9d73685b-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19504/c/1/G"},"text":null,"children":[{"tag":"num","attrib":{"value":"G"},"text":"(G)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" the development of local or regional plans for community development; and","children":[],"tail":"\n"}],"tail":"\n"},{"tag":"subparagraph","attrib":{"id":"id9d73685c-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19504/c/1/H"},"text":null,"children":[{"tag":"num","attrib":{"value":"H"},"text":"(H)","children":[],"tail":null},{"tag":"chapeau","attrib":{},"text":" the substantial improvement of community development strategies, including strategies designed to—","children":[],"tail":null},{"tag":"clause","attrib":{"id":"id9d73685d-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19504/c/1/H/i"},"text":null,"children":[{"tag":"num","attrib":{"value":"i"},"text":"(i)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" increase the availability of affordable housing and access to affordable housing;","children":[],"tail":"\n"}],"tail":"\n"},{"tag":"clause","attrib":{"id":"id9d73685e-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19504/c/1/H/ii"},"text":null,"children":[{"tag":"num","attrib":{"value":"ii"},"text":"(ii)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" increase access to public transportation; and","children":[],"tail":"\n"}],"tail":"\n"},{"tag":"clause","attrib":{"id":"id9d73685f-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19504/c/1/H/iii"},"text":null,"children":[{"tag":"num","attrib":{"value":"iii"},"text":"(iii)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" advance sustainable or location-efficient community development goals.","children":[],"tail":"\n"}],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"paragraph","attrib":{"id":"id9d736860-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19504/c/2"},"text":null,"children":[{"tag":"num","attrib":{"value":"2"},"text":"(2)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" By States, insular areas, metropolitan cities, and urban counties","children":[],"tail":null},{"tag":"chapeau","attrib":{},"text":"If an eligible entity that receives amounts under this section is an eligible entity described in subsection (a)(1)(A), the eligible entity shall use those amounts to—","children":[],"tail":null},{"tag":"subparagraph","attrib":{"id":"id9d736861-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19504/c/2/A"},"text":null,"children":[{"tag":"num","attrib":{"value":"A"},"text":"(A)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" implement and administer housing strategies and housing plans;","children":[],"tail":"\n"}],"tail":"\n"},{"tag":"subparagraph","attrib":{"id":"id9d736862-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19504/c/2/B"},"text":null,"children":[{"tag":"num","attrib":{"value":"B"},"text":"(B)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" implement and administer any plans to increase housing choice, address disparities in housing needs, and provide greater access to opportunity;","children":[],"tail":"\n"}],"tail":"\n"},{"tag":"subparagraph","attrib":{"id":"id9d736863-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19504/c/2/C"},"text":null,"children":[{"tag":"num","attrib":{"value":"C"},"text":"(C)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" fund any community investments that support goals identified in a housing strategy or housing plan;","children":[],"tail":"\n"}],"tail":"\n"},{"tag":"subparagraph","attrib":{"id":"id9d736864-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19504/c/2/D"},"text":null,"children":[{"tag":"num","attrib":{"value":"D"},"text":"(D)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" implement and administer regulatory requirements and processes with respect to reformed zoning codes;","children":[],"tail":"\n"}],"tail":"\n"},{"tag":"subparagraph","attrib":{"id":"id9d736865-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19504/c/2/E"},"text":null,"children":[{"tag":"num","attrib":{"value":"E"},"text":"(E)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" increase the capacity to conduct housing inspections;","children":[],"tail":"\n"}],"tail":"\n"},{"tag":"subparagraph","attrib":{"id":"id9d736866-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19504/c/2/F"},"text":null,"children":[{"tag":"num","attrib":{"value":"F"},"text":"(F)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" increase the capacity to reduce barriers to housing supply elasticity and housing affordability;","children":[],"tail":"\n"}],"tail":"\n"},{"tag":"subparagraph","attrib":{"id":"id9d736867-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19504/c/2/G"},"text":null,"children":[{"tag":"num","attrib":{"value":"G"},"text":"(G)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" implement and administer local or regional plans for community development; and","children":[],"tail":"\n"}],"tail":"\n"},{"tag":"subparagraph","attrib":{"id":"id9d736868-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19504/c/2/H"},"text":null,"children":[{"tag":"num","attrib":{"value":"H"},"text":"(H)","children":[],"tail":null},{"tag":"chapeau","attrib":{},"text":" fund any planning to increase—","children":[],"tail":null},{"tag":"clause","attrib":{"id":"id9d736869-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19504/c/2/H/i"},"text":null,"children":[{"tag":"num","attrib":{"value":"i"},"text":"(i)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" the availability of affordable housing and access to affordable housing;","children":[],"tail":"\n"}],"tail":"\n"},{"tag":"clause","attrib":{"id":"id9d73686a-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19504/c/2/H/ii"},"text":null,"children":[{"tag":"num","attrib":{"value":"ii"},"text":"(ii)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" access to public transportation; and","children":[],"tail":"\n"}],"tail":"\n"},{"tag":"clause","attrib":{"id":"id9d73686b-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19504/c/2/H/iii"},"text":null,"children":[{"tag":"num","attrib":{"value":"iii"},"text":"(iii)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" any location-efficient community development goals.","children":[],"tail":"\n"}],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"paragraph","attrib":{"id":"id9d73686c-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19504/c/3"},"text":null,"children":[{"tag":"num","attrib":{"value":"3"},"text":"(3)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Use for administrative costs","children":[],"tail":null},{"tag":"content","attrib":{},"text":null,"children":[{"tag":"p","attrib":{},"text":"A eligible entity that receives amounts under this section may not use more than 10 percent of those amounts for administrative costs.","children":[],"tail":"\n"}],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"subsection","attrib":{"id":"id9d73686d-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19504/d"},"text":null,"children":[{"tag":"num","attrib":{"value":"d"},"text":"(d)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Coordination","children":[],"tail":null},{"tag":"content","attrib":{},"text":null,"children":[{"tag":"p","attrib":{},"text":"To the extent practicable, the Secretary shall coordinate with the Administrator of the Federal Transit Administration in carrying out this section.","children":[],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"subsection","attrib":{"id":"id9d73686e-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19504/e"},"text":null,"children":[{"tag":"num","attrib":{"value":"e"},"text":"(e)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Expiration of authority","children":[],"tail":null},{"tag":"content","attrib":{},"text":null,"children":[{"tag":"p","attrib":{},"text":"After the expiration of the 5-year period beginning on ","children":[{"tag":"date","attrib":{"date":"2026-07-11"},"text":"July 11, 2026","children":[],"tail":", the Secretary may not newly establish a program as described in this section."}],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"subsection","attrib":{"id":"id9d73686f-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19504/f"},"text":null,"children":[{"tag":"num","attrib":{"value":"f"},"text":"(f)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Sunset","children":[],"tail":null},{"tag":"content","attrib":{},"text":null,"children":[{"tag":"p","attrib":{},"text":"The program established under this section shall terminate on the date that is 5 years after ","children":[{"tag":"date","attrib":{"date":"2026-07-11"},"text":"July 11, 2026","children":[],"tail":"."}],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"sourceCredit","attrib":{"id":"id9d736870-86b3-11f1-9949-c831ab2bbedc"},"text":"(","children":[{"tag":"ref","attrib":{"href":"/us/pl/119/101/tII/s207"},"text":"Pub. L. 119–101, title II, § 207","children":[],"tail":", "},{"tag":"date","attrib":{"date":"2026-07-11"},"text":"July 11, 2026","children":[],"tail":", "},{"tag":"ref","attrib":{"href":"/us/stat/140/873"},"text":"140 Stat. 873","children":[],"tail":".)"}],"tail":"\n"}],"tail":null}
