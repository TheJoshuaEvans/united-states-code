<section xmlns="http://xml.house.gov/schemas/uslm/1.0" style="-uslm-lc:I80" id="id9c5ec33b-86b3-11f1-9949-c831ab2bbedc" identifier="/us/usc/t42/s12408"><num value="12408">§ 12408.</num><heading> Authorization of appropriations</heading>
<chapeau style="-uslm-lc:I11" class="indent0">There is hereby authorized to be appropriated to carry out the purposes of this chapter (in addition to any amounts made available for such purposes under other Acts)—</chapeau><paragraph style="-uslm-lc:I12" class="indent1" id="id9c5ec33c-86b3-11f1-9949-c831ab2bbedc" identifier="/us/usc/t42/s12408/1"><num value="1">(1)</num><content> $3,000,000 for the fiscal year 1992;</content>
</paragraph>
<paragraph style="-uslm-lc:I12" class="indent1" id="id9c5ec33d-86b3-11f1-9949-c831ab2bbedc" identifier="/us/usc/t42/s12408/2"><num value="2">(2)</num><content> $7,000,000 for the fiscal year 1993;</content>
</paragraph>
<paragraph style="-uslm-lc:I12" class="indent1" id="id9c5ec33e-86b3-11f1-9949-c831ab2bbedc" identifier="/us/usc/t42/s12408/3"><num value="3">(3)</num><content> $10,000,000 for the fiscal year 1994;</content>
</paragraph>
<paragraph style="-uslm-lc:I12" class="indent1" id="id9c5ec33f-86b3-11f1-9949-c831ab2bbedc" identifier="/us/usc/t42/s12408/4"><num value="4">(4)</num><content> $14,500,000 for fiscal year 1996;</content>
</paragraph>
<paragraph style="-uslm-lc:I12" class="indent1" id="id9c5ec340-86b3-11f1-9949-c831ab2bbedc" identifier="/us/usc/t42/s12408/5"><num value="5">(5)</num><content> $20,000,000 for fiscal year 1997;</content>
</paragraph>
<paragraph style="-uslm-lc:I12" class="indent1" id="id9c5ec341-86b3-11f1-9949-c831ab2bbedc" identifier="/us/usc/t42/s12408/6"><num value="6">(6)</num><content> $25,000,000 for fiscal year 1998;</content>
</paragraph>
<paragraph style="-uslm-lc:I12" class="indent1" id="id9c5ec342-86b3-11f1-9949-c831ab2bbedc" identifier="/us/usc/t42/s12408/7"><num value="7">(7)</num><content> $30,000,000 for fiscal year 1999;</content>
</paragraph>
<paragraph style="-uslm-lc:I12" class="indent1" id="id9c5ec343-86b3-11f1-9949-c831ab2bbedc" identifier="/us/usc/t42/s12408/8"><num value="8">(8)</num><content> $35,000,000 for fiscal year 2000; and</content>
</paragraph>
<paragraph style="-uslm-lc:I12" class="indent1" id="id9c5ec344-86b3-11f1-9949-c831ab2bbedc" identifier="/us/usc/t42/s12408/9"><num value="9">(9)</num><content> $40,000,000 for fiscal year 2001.</content>
</paragraph>
