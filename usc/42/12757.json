{"tag":"section","attrib":{"id":"id9c8e5fb2-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s12757"},"text":null,"children":[{"tag":"num","attrib":{"value":"12757"},"text":"§ 12757.","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Revitalizing empty structures into desirable environments","children":[],"tail":null},{"tag":"subsection","attrib":{"id":"id9c8e5fb3-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s12757/a"},"text":null,"children":[{"tag":"num","attrib":{"value":"a"},"text":"(a)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Definitions","children":[],"tail":null},{"tag":"chapeau","attrib":{},"text":"In this section:","children":[],"tail":null},{"tag":"paragraph","attrib":{"id":"id9c8e5fb4-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s12757/a/1"},"text":null,"children":[{"tag":"num","attrib":{"value":"1"},"text":"(1)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Attainable housing","children":[],"tail":null},{"tag":"content","attrib":{},"text":null,"children":[{"tag":"p","attrib":{},"text":"The term “attainable housing” means housing that serves households earning not more than 120 percent of the area median income, if the majority of the housing units are affordable to households earning not more than 60 percent of the area median income.","children":[],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"paragraph","attrib":{"id":"id9c8e5fb5-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s12757/a/2"},"text":null,"children":[{"tag":"num","attrib":{"value":"2"},"text":"(2)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Converted housing unit","children":[],"tail":null},{"tag":"content","attrib":{},"text":null,"children":[{"tag":"p","attrib":{},"text":"The term “converted housing unit” means a housing unit that is created using a covered grant.","children":[],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"paragraph","attrib":{"id":"id9c8e5fb6-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s12757/a/3"},"text":null,"children":[{"tag":"num","attrib":{"value":"3"},"text":"(3)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Covered grant","children":[],"tail":null},{"tag":"content","attrib":{},"text":null,"children":[{"tag":"p","attrib":{},"text":"The term “covered grant” means a grant awarded under the Pilot Program.","children":[],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"paragraph","attrib":{"id":"id9c8e5fb7-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s12757/a/4"},"text":null,"children":[{"tag":"num","attrib":{"value":"4"},"text":"(4)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Eligible entity","children":[],"tail":null},{"tag":"content","attrib":{},"text":null,"children":[{"tag":"p","attrib":{},"text":"The term “eligible entity” means a participating jurisdiction.","children":[],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"paragraph","attrib":{"id":"id9c8e5fb8-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s12757/a/5"},"text":null,"children":[{"tag":"num","attrib":{"value":"5"},"text":"(5)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Pilot Program","children":[],"tail":null},{"tag":"content","attrib":{},"text":null,"children":[{"tag":"p","attrib":{},"text":"The term “Pilot Program” means the pilot program established under subsection (b).","children":[],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"paragraph","attrib":{"id":"id9c8e5fb9-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s12757/a/6"},"text":null,"children":[{"tag":"num","attrib":{"value":"6"},"text":"(6)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Vacant and abandoned building","children":[],"tail":null},{"tag":"chapeau","attrib":{},"text":"The term “vacant and abandoned building” means a property—","children":[],"tail":null},{"tag":"subparagraph","attrib":{"id":"id9c8e5fba-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s12757/a/6/A"},"text":null,"children":[{"tag":"num","attrib":{"value":"A"},"text":"(A)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" that was constructed for use as a warehouse, factory, mall, strip mall, or hotel, or for another industrial or commercial use; and","children":[],"tail":"\n"}],"tail":"\n"},{"tag":"subparagraph","attrib":{"id":"id9c8e5fbb-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s12757/a/6/B"},"text":null,"children":[{"tag":"num","attrib":{"value":"B"},"text":"(B)","children":[],"tail":null},{"tag":"clause","attrib":{"id":"id9c8e5fbc-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s12757/a/6/B/i"},"text":null,"children":[{"tag":"num","attrib":{"value":"i"},"text":"(i)","children":[],"tail":null},{"tag":"chapeau","attrib":{},"text":" with respect to which—","children":[],"tail":null},{"tag":"subclause","attrib":{"id":"id9c8e5fbd-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s12757/a/6/B/i/I"},"text":null,"children":[{"tag":"num","attrib":{"value":"I"},"text":"(I)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" a code enforcement inspection has determined that the property is not safe; and","children":[],"tail":"\n"}],"tail":"\n"},{"tag":"subclause","attrib":{"id":"id9c8e5fbe-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s12757/a/6/B/i/II"},"text":null,"children":[{"tag":"num","attrib":{"value":"II"},"text":"(II)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" not less than 90 days have elapsed since the owner was notified of the deficiencies in the property and the owner has taken no corrective action; or","children":[],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"clause","attrib":{"id":"id9c8e5fbf-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s12757/a/6/B/ii"},"text":null,"children":[{"tag":"num","attrib":{"value":"ii"},"text":"(ii)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" that is subject to a court-ordered receivership or nuisance abatement related to abandonment pursuant to State or local law or otherwise meets the definition of an abandoned property under State law.","children":[],"tail":"\n"}],"tail":"\n"}],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"subsection","attrib":{"id":"id9c8e5fc0-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s12757/b"},"text":null,"children":[{"tag":"num","attrib":{"value":"b"},"text":"(b)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Purpose of grant program","children":[],"tail":null},{"tag":"content","attrib":{},"text":null,"children":[{"tag":"p","attrib":{},"text":"Subject to the availability of funds appropriated for this subsection, the Secretary is authorized to establish a pilot program, spanning from fiscal years 2027 through 2031, which shall have the purpose of awarding grants on a competitive basis to eligible entities to convert vacant and abandoned buildings into attainable housing.","children":[],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"subsection","attrib":{"id":"id9c8e5fc1-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s12757/c"},"text":null,"children":[{"tag":"num","attrib":{"value":"c"},"text":"(c)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Amount of grant","children":[],"tail":null},{"tag":"paragraph","attrib":{"id":"id9c8e5fc2-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s12757/c/1"},"text":null,"children":[{"tag":"num","attrib":{"value":"1"},"text":"(1)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" In general","children":[],"tail":null},{"tag":"content","attrib":{},"text":null,"children":[{"tag":"p","attrib":{},"text":"For any fiscal year for which not less than $100,000,000 is made available to carry out the Pilot Program, the amount of a covered grant shall be not less than $1,000,000 and not more than $10,000,000.","children":[],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"paragraph","attrib":{"id":"id9c8e5fc3-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s12757/c/2"},"text":null,"children":[{"tag":"num","attrib":{"value":"2"},"text":"(2)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Fiscal years with lower funding","children":[],"tail":null},{"tag":"content","attrib":{},"text":null,"children":[{"tag":"p","attrib":{},"text":"For any fiscal year for which less than $100,000,000 is made available to carry out the Pilot Program pursuant to subsection (b), the Secretary shall seek to maximize the number of covered grants awarded.","children":[],"tail":"\n"}],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"subsection","attrib":{"id":"id9c8e5fc4-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s12757/d"},"text":null,"children":[{"tag":"num","attrib":{"value":"d"},"text":"(d)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Relation to formula allocation","children":[],"tail":null},{"tag":"content","attrib":{},"text":null,"children":[{"tag":"p","attrib":{},"text":"A covered grant awarded to an eligible entity shall be in addition to, and shall not affect, the formula allocation for the eligible entity under ","children":[{"tag":"ref","attrib":{"href":"/us/usc/t42/s12747"},"text":"section 12747 of this title","children":[],"tail":"."}],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"subsection","attrib":{"id":"id9c8e5fc5-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s12757/e"},"text":null,"children":[{"tag":"num","attrib":{"value":"e"},"text":"(e)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Priority","children":[],"tail":null},{"tag":"chapeau","attrib":{},"text":"In awarding covered grants, the Secretary shall give priority to an eligible entity that—","children":[],"tail":null},{"tag":"paragraph","attrib":{"id":"id9c8e5fc6-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s12757/e/1"},"text":null,"children":[{"tag":"num","attrib":{"value":"1"},"text":"(1)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" will use the covered grant in a community that is experiencing economic distress;","children":[],"tail":"\n"}],"tail":"\n"},{"tag":"paragraph","attrib":{"id":"id9c8e5fc7-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s12757/e/2"},"text":null,"children":[{"tag":"num","attrib":{"value":"2"},"text":"(2)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" will use the covered grant in a qualified opportunity zone (as defined in ","children":[{"tag":"ref","attrib":{"href":"/us/usc/t26/s1400Z–1/a"},"text":"section 1400Z–1(a) of title 26","children":[],"tail":");"}],"tail":"\n"}],"tail":"\n"},{"tag":"paragraph","attrib":{"id":"id9c8e5fc8-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s12757/e/3"},"text":null,"children":[{"tag":"num","attrib":{"value":"3"},"text":"(3)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" will use the covered grant to construct housing that will serve a need identified in the comprehensive housing affordability strategy and community development plan of the eligible entity under part 91 of title 24, Code of Federal Regulations, or any successor regulation (commonly referred to as a “consolidated plan”); or","children":[],"tail":"\n"}],"tail":"\n"},{"tag":"paragraph","attrib":{"id":"id9c8e5fc9-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s12757/e/4"},"text":null,"children":[{"tag":"num","attrib":{"value":"4"},"text":"(4)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" has enacted ordinances to reduce regulatory barriers to conversion of vacant and abandoned buildings to housing, which shall not include any alteration of an ordinance that governs safety and habitability.","children":[],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"subsection","attrib":{"id":"id9c8e5fca-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s12757/f"},"text":null,"children":[{"tag":"num","attrib":{"value":"f"},"text":"(f)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Use of funds","children":[],"tail":null},{"tag":"chapeau","attrib":{},"text":"An eligible entity may use a covered grant for—","children":[],"tail":null},{"tag":"paragraph","attrib":{"id":"id9c8e5fcb-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s12757/f/1"},"text":null,"children":[{"tag":"num","attrib":{"value":"1"},"text":"(1)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" property acquisition;","children":[],"tail":"\n"}],"tail":"\n"},{"tag":"paragraph","attrib":{"id":"id9c8e5fcc-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s12757/f/2"},"text":null,"children":[{"tag":"num","attrib":{"value":"2"},"text":"(2)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" demolition;","children":[],"tail":"\n"}],"tail":"\n"},{"tag":"paragraph","attrib":{"id":"id9c8e5fcd-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s12757/f/3"},"text":null,"children":[{"tag":"num","attrib":{"value":"3"},"text":"(3)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" health hazard remediation;","children":[],"tail":"\n"}],"tail":"\n"},{"tag":"paragraph","attrib":{"id":"id9c8e5fce-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s12757/f/4"},"text":null,"children":[{"tag":"num","attrib":{"value":"4"},"text":"(4)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" site preparation;","children":[],"tail":"\n"}],"tail":"\n"},{"tag":"paragraph","attrib":{"id":"id9c8e5fcf-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s12757/f/5"},"text":null,"children":[{"tag":"num","attrib":{"value":"5"},"text":"(5)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" construction, renovation, or rehabilitation; or","children":[],"tail":"\n"}],"tail":"\n"},{"tag":"paragraph","attrib":{"id":"id9c8e5fd0-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s12757/f/6"},"text":null,"children":[{"tag":"num","attrib":{"value":"6"},"text":"(6)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" the establishment, maintenance, or expansion of community land trusts or housing cooperatives.","children":[],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"subsection","attrib":{"id":"id9c8e5fd1-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s12757/g"},"text":null,"children":[{"tag":"num","attrib":{"value":"g"},"text":"(g)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Waiver authority","children":[],"tail":null},{"tag":"content","attrib":{},"text":null,"children":[{"tag":"p","attrib":{},"text":"In administering covered grants, the Secretary may waive, or specify alternative requirements for, any statute or regulation that the Secretary administers in connection with the obligation by the Secretary or the use by eligible entities of covered grant funds (except for requirements related to fair housing, nondiscrimination, labor standards, or the environment) if the Secretary makes a public finding that good cause exists for the waiver or alternative requirement.","children":[],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"subsection","attrib":{"id":"id9c8e5fd2-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s12757/h"},"text":null,"children":[{"tag":"num","attrib":{"value":"h"},"text":"(h)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Study; report","children":[],"tail":null},{"tag":"chapeau","attrib":{},"text":"Not later than 180 days after the termination of the Pilot Program, the Secretary shall study and submit to Congress a report on the impact of the Pilot Program on—","children":[],"tail":null},{"tag":"paragraph","attrib":{"id":"id9c8e5fd3-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s12757/h/1"},"text":null,"children":[{"tag":"num","attrib":{"value":"1"},"text":"(1)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" improving the tax base of local communities;","children":[],"tail":"\n"}],"tail":"\n"},{"tag":"paragraph","attrib":{"id":"id9c8e5fd4-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s12757/h/2"},"text":null,"children":[{"tag":"num","attrib":{"value":"2"},"text":"(2)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" increasing access to affordable housing, especially for elderly individuals, disabled individuals, and veterans;","children":[],"tail":"\n"}],"tail":"\n"},{"tag":"paragraph","attrib":{"id":"id9c8e5fd5-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s12757/h/3"},"text":null,"children":[{"tag":"num","attrib":{"value":"3"},"text":"(3)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" increasing home-ownership; and","children":[],"tail":"\n"}],"tail":"\n"},{"tag":"paragraph","attrib":{"id":"id9c8e5fd6-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s12757/h/4"},"text":null,"children":[{"tag":"num","attrib":{"value":"4"},"text":"(4)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" removing blight.","children":[],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"sourceCredit","attrib":{"id":"id9c8e5fd7-86b3-11f1-9949-c831ab2bbedc"},"text":"(","children":[{"tag":"ref","attrib":{"href":"/us/pl/101/625/tII/s227"},"text":"Pub. L. 101–625, title II, § 227","children":[],"tail":", as added "},{"tag":"ref","attrib":{"href":"/us/pl/119/101/tII/s210/a"},"text":"Pub. L. 119–101, title II, § 210(a)","children":[],"tail":", "},{"tag":"date","attrib":{"date":"2026-07-11"},"text":"July 11, 2026","children":[],"tail":", "},{"tag":"ref","attrib":{"href":"/us/stat/140/880"},"text":"140 Stat. 880","children":[],"tail":".)"}],"tail":"\n"},{"tag":"notes","attrib":{"type":"uscNote","id":"id9c8e5fd8-86b3-11f1-9949-c831ab2bbedc"},"text":"\n","children":[{"tag":"note","attrib":{"role":"crossHeading","topic":"statutoryNotes","id":"id9c8e5fd9-86b3-11f1-9949-c831ab2bbedc"},"text":null,"children":[{"tag":"heading","attrib":{},"text":null,"children":[{"tag":"b","attrib":{},"text":"Statutory Notes and Related Subsidiaries","children":[],"tail":null}],"tail":null}],"tail":"\n"},{"tag":"note","attrib":{"topic":"shortTitle","id":"id9c8e5fda-86b3-11f1-9949-c831ab2bbedc"},"text":null,"children":[{"tag":"heading","attrib":{},"text":"Short Title","children":[],"tail":null},{"tag":"p","attrib":{},"text":null,"children":[{"tag":"ref","attrib":{"href":"/us/pl/119/101/tII/s210"},"text":"Pub. L. 119–101, title II, § 210","children":[],"tail":", "},{"tag":"date","attrib":{"date":"2026-07-11"},"text":"July 11, 2026","children":[],"tail":", "},{"tag":"ref","attrib":{"href":"/us/stat/140/880"},"text":"140 Stat. 880","children":[],"tail":", which enacted this section, is popularly known as the “Revitalizing Empty Structures Into Desirable Environments (RESIDE) Act”."}],"tail":"\n"}],"tail":"\n"}],"tail":"\n"}],"tail":null}
