{"tag":"section","attrib":{"id":"id9d75b1c4-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19507"},"text":null,"children":[{"tag":"num","attrib":{"value":"19507"},"text":"§ 19507.","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Build Now Act","children":[],"tail":null},{"tag":"subsection","attrib":{"id":"id9d75b1c5-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19507/a"},"text":null,"children":[{"tag":"num","attrib":{"value":"a"},"text":"(a)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Definitions","children":[],"tail":null},{"tag":"chapeau","attrib":{},"text":"In this section:","children":[],"tail":null},{"tag":"paragraph","attrib":{"id":"id9d75b1c6-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19507/a/1"},"text":null,"children":[{"tag":"num","attrib":{"value":"1"},"text":"(1)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Covered recipient","children":[],"tail":null},{"tag":"content","attrib":{},"text":null,"children":[{"tag":"p","attrib":{},"text":"The term “covered recipient” means a metropolitan city or urban county, as those terms are defined in ","children":[{"tag":"ref","attrib":{"href":"/us/usc/t42/s5302"},"text":"section 5302 of this title","children":[],"tail":", that receives funds under section 106."}],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"paragraph","attrib":{"id":"id9d75b1c7-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19507/a/2"},"text":null,"children":[{"tag":"num","attrib":{"value":"2"},"text":"(2)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Current annual growth rate","children":[],"tail":null},{"tag":"chapeau","attrib":{},"text":"The term “current annual growth rate”, with respect to an eligible recipient and a fiscal year, means the average annual percentage increase in the number of housing units in the jurisdiction of the eligible recipient, as calculated by the Secretary, during the period—","children":[],"tail":null},{"tag":"subparagraph","attrib":{"id":"id9d75b1c8-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19507/a/2/A"},"text":null,"children":[{"tag":"num","attrib":{"value":"A"},"text":"(A)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" beginning with the third quarter of the sixth preceding fiscal year; and","children":[],"tail":"\n"}],"tail":"\n"},{"tag":"subparagraph","attrib":{"id":"id9d75b1c9-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19507/a/2/B"},"text":null,"children":[{"tag":"num","attrib":{"value":"B"},"text":"(B)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" ending with the third quarter of the preceding fiscal year.","children":[],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"paragraph","attrib":{"id":"id9d75b1ca-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19507/a/3"},"text":null,"children":[{"tag":"num","attrib":{"value":"3"},"text":"(3)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Eligible recipient","children":[],"tail":null},{"tag":"chapeau","attrib":{},"text":"The term “eligible recipient” means any covered recipient unless—","children":[],"tail":null},{"tag":"subparagraph","attrib":{"id":"id9d75b1cb-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19507/a/3/A"},"text":null,"children":[{"tag":"num","attrib":{"value":"A"},"text":"(A)","children":[],"tail":null},{"tag":"clause","attrib":{"id":"id9d75b1cc-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19507/a/3/A/i"},"text":null,"children":[{"tag":"num","attrib":{"value":"i"},"text":"(i)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" the median Small Area Fair Market Rent in the jurisdiction of the covered recipient is at or below the 60th percentile of median Small Area Fair Market Rents in the jurisdictions of all covered recipients; and","children":[],"tail":"\n"}],"tail":"\n"},{"tag":"clause","attrib":{"id":"id9d75b1cd-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19507/a/3/A/ii"},"text":null,"children":[{"tag":"num","attrib":{"value":"ii"},"text":"(ii)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" the median home value in the jurisdiction of the covered recipient is below the median home value for the United States;","children":[],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"subparagraph","attrib":{"id":"id9d75b1ce-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19507/a/3/B"},"text":null,"children":[{"tag":"num","attrib":{"value":"B"},"text":"(B)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" the annual rental vacancy rate in the jurisdiction of the covered recipient is greater than the national annual rental vacancy rate for the most recent year available, as published by the Bureau of the Census;","children":[],"tail":"\n"}],"tail":"\n"},{"tag":"subparagraph","attrib":{"id":"id9d75b1cf-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19507/a/3/C"},"text":null,"children":[{"tag":"num","attrib":{"value":"C"},"text":"(C)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" during the 3-year period preceding the date on which the Secretary allocates funds under section 106, the jurisdiction of the covered recipient has been the subject of a major disaster or emergency declaration under section 5170 or 5191, respectively, of this title; or","children":[],"tail":"\n"}],"tail":"\n"},{"tag":"subparagraph","attrib":{"id":"id9d75b1d0-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19507/a/3/D"},"text":null,"children":[{"tag":"num","attrib":{"value":"D"},"text":"(D)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" the covered recipient lacks the legal authority to enact or update zoning and permitting ordinances.","children":[],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"paragraph","attrib":{"id":"id9d75b1d1-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19507/a/4"},"text":null,"children":[{"tag":"num","attrib":{"value":"4"},"text":"(4)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Extremely high-growth recipient","children":[],"tail":null},{"tag":"content","attrib":{},"text":null,"children":[{"tag":"p","attrib":{},"text":"The term “extremely high-growth recipient” means an eligible recipient for which the current annual growth rate is at or above 4 percent.","children":[],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"paragraph","attrib":{"id":"id9d75b1d2-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19507/a/5"},"text":null,"children":[{"tag":"num","attrib":{"value":"5"},"text":"(5)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Housing growth improvement rate","children":[],"tail":null},{"tag":"chapeau","attrib":{},"text":"The term “housing growth improvement rate”, with respect to an eligible recipient and a fiscal year, means the quotient of—","children":[],"tail":null},{"tag":"subparagraph","attrib":{"id":"id9d75b1d3-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19507/a/5/A"},"text":null,"children":[{"tag":"num","attrib":{"value":"A"},"text":"(A)","children":[],"tail":null},{"tag":"clause","attrib":{"id":"id9d75b1d4-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19507/a/5/A/i"},"text":null,"children":[{"tag":"num","attrib":{"value":"i"},"text":"(i)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" the current annual growth rate of the eligible recipient, minus","children":[],"tail":"\n"}],"tail":"\n"},{"tag":"clause","attrib":{"id":"id9d75b1d5-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19507/a/5/A/ii"},"text":null,"children":[{"tag":"num","attrib":{"value":"ii"},"text":"(ii)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" the prior annual growth rate of the eligible recipient; and","children":[],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"subparagraph","attrib":{"id":"id9d75b1d6-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19507/a/5/B"},"text":null,"children":[{"tag":"num","attrib":{"value":"B"},"text":"(B)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" the sum obtained by adding the absolute values of the current annual growth rate and the prior annual growth rate of the eligible recipient.","children":[],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"paragraph","attrib":{"id":"id9d75b1d7-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19507/a/6"},"text":null,"children":[{"tag":"num","attrib":{"value":"6"},"text":"(6)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Prior annual growth rate","children":[],"tail":null},{"tag":"chapeau","attrib":{},"text":"The term “prior annual growth rate”, with respect to an eligible recipient and a fiscal year, means the average annual percentage increase in the number of housing units in the jurisdiction of the eligible recipient, as calculated by the Secretary, during the period—","children":[],"tail":null},{"tag":"subparagraph","attrib":{"id":"id9d75b1d8-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19507/a/6/A"},"text":null,"children":[{"tag":"num","attrib":{"value":"A"},"text":"(A)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" beginning with the third quarter of the 11th preceding fiscal year; and","children":[],"tail":"\n"}],"tail":"\n"},{"tag":"subparagraph","attrib":{"id":"id9d75b1d9-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19507/a/6/B"},"text":null,"children":[{"tag":"num","attrib":{"value":"B"},"text":"(B)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" ending with the third quarter of the sixth preceding fiscal year.","children":[],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"paragraph","attrib":{"id":"id9d75b1da-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19507/a/7"},"text":null,"children":[{"tag":"num","attrib":{"value":"7"},"text":"(7)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Secretary","children":[],"tail":null},{"tag":"content","attrib":{},"text":null,"children":[{"tag":"p","attrib":{},"text":"The term “Secretary” means the Secretary of Housing and Urban Development.","children":[],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"paragraph","attrib":{"id":"id9d75b1db-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19507/a/8"},"text":null,"children":[{"tag":"num","attrib":{"value":"8"},"text":"(8)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Section 106","children":[],"tail":null},{"tag":"content","attrib":{},"text":null,"children":[{"tag":"p","attrib":{},"text":"The term “section 106” means section 106 of the Housing and Community Development Act of 1974 (","children":[{"tag":"ref","attrib":{"href":"/us/usc/t42/s5306"},"text":"42 U.S.C. 5306","children":[],"tail":")."}],"tail":"\n"}],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"subsection","attrib":{"id":"id9d75b1dc-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19507/b"},"text":null,"children":[{"tag":"num","attrib":{"value":"b"},"text":"(b)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Adjustments to community development block grant allocations","children":[],"tail":null},{"tag":"paragraph","attrib":{"id":"id9d75b1dd-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19507/b/1"},"text":null,"children":[{"tag":"num","attrib":{"value":"1"},"text":"(1)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" In general","children":[],"tail":null},{"tag":"content","attrib":{},"text":null,"children":[{"tag":"p","attrib":{},"text":"In allocating amounts to an eligible recipient under section 106 for a fiscal year, the Secretary shall adjust the allocation based on the housing growth improvement rate of the eligible recipient, in accordance with paragraph (2) of this subsection.","children":[],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"paragraph","attrib":{"id":"id9d75b1de-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19507/b/2"},"text":null,"children":[{"tag":"num","attrib":{"value":"2"},"text":"(2)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Adjustments","children":[],"tail":null},{"tag":"subparagraph","attrib":{"id":"id9d75b1df-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19507/b/2/A"},"text":null,"children":[{"tag":"num","attrib":{"value":"A"},"text":"(A)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Housing growth improvement rate at or above median; extremely high-growth recipients","children":[],"tail":null},{"tag":"clause","attrib":{"id":"id9d75b1e0-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19507/b/2/A/i"},"text":null,"children":[{"tag":"num","attrib":{"value":"i"},"text":"(i)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" In general","children":[],"tail":null},{"tag":"content","attrib":{},"text":null,"children":[{"tag":"p","attrib":{},"text":"If, with respect to a fiscal year for which the allocation under section 106 is being determined, the housing growth improvement rate for an eligible recipient is at or above the median housing growth improvement rate for all eligible recipients other than extremely high-growth recipients, or if an eligible recipient is an extremely high-growth recipient, the Secretary shall allocate to the eligible recipient for that fiscal year, in addition to the amount that would otherwise be allocated to the eligible recipient under section 106, a bonus amount, as determined under clause (ii) of this subparagraph.","children":[],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"clause","attrib":{"id":"id9d75b1e1-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19507/b/2/A/ii"},"text":null,"children":[{"tag":"num","attrib":{"value":"ii"},"text":"(ii)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Bonus amount","children":[],"tail":null},{"tag":"chapeau","attrib":{},"text":"For purposes of clause (i), the bonus amount for an eligible recipient for a fiscal year shall be equal to the product of—","children":[],"tail":null},{"tag":"subclause","attrib":{"id":"id9d75b1e2-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19507/b/2/A/ii/I"},"text":null,"children":[{"tag":"num","attrib":{"value":"I"},"text":"(I)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" the aggregate amount by which allocations to eligible recipients are decreased under subparagraph (B) for that fiscal year; and","children":[],"tail":"\n"}],"tail":"\n"},{"tag":"subclause","attrib":{"id":"id9d75b1e3-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19507/b/2/A/ii/II"},"text":null,"children":[{"tag":"num","attrib":{"value":"II"},"text":"(II)","children":[],"tail":null},{"tag":"chapeau","attrib":{},"text":" the quotient of—","children":[],"tail":null},{"tag":"item","attrib":{"id":"id9d75b1e4-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19507/b/2/A/ii/II/aa"},"text":null,"children":[{"tag":"num","attrib":{"value":"aa"},"text":"(aa)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" the difference in the number of housing units, between the third quarter of the second preceding fiscal year and the third quarter of the preceding fiscal year, in the jurisdiction of the eligible recipient, as calculated by the Secretary; and","children":[],"tail":"\n"}],"tail":"\n"},{"tag":"item","attrib":{"id":"id9d75b1e5-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19507/b/2/A/ii/II/bb"},"text":null,"children":[{"tag":"num","attrib":{"value":"bb"},"text":"(bb)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" the difference in the number of housing units, between the third quarter of the second preceding fiscal year and the third quarter of the preceding fiscal year, in the jurisdictions of all eligible recipients that receive a bonus amount under this paragraph, as calculated by the Secretary.","children":[],"tail":"\n"}],"tail":"\n"}],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"subparagraph","attrib":{"id":"id9d75b1e6-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19507/b/2/B"},"text":null,"children":[{"tag":"num","attrib":{"value":"B"},"text":"(B)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Housing growth improvement rate below median","children":[],"tail":null},{"tag":"content","attrib":{},"text":null,"children":[{"tag":"p","attrib":{},"text":"If, with respect to a fiscal year for which the allocation under section 106 is being determined, the housing growth improvement rate for an eligible recipient is below the median housing growth improvement rate for all eligible recipients other than high-growth outliers, the Secretary shall decrease the amount that would otherwise be allocated to the eligible recipient under section 106 for that fiscal year by 10 percent.","children":[],"tail":"\n"}],"tail":"\n"}],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"subsection","attrib":{"id":"id9d75b1e7-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19507/c"},"text":null,"children":[{"tag":"num","attrib":{"value":"c"},"text":"(c)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Calculation of housing units","children":[],"tail":null},{"tag":"paragraph","attrib":{"id":"id9d75b1e8-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19507/c/1"},"text":null,"children":[{"tag":"num","attrib":{"value":"1"},"text":"(1)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Housing and urban development requirements","children":[],"tail":null},{"tag":"chapeau","attrib":{},"text":"In calculating the number of housing units in the jurisdiction of an eligible recipient under any provision of this section, the Secretary shall—","children":[],"tail":null},{"tag":"subparagraph","attrib":{"id":"id9d75b1e9-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19507/c/1/A"},"text":null,"children":[{"tag":"num","attrib":{"value":"A"},"text":"(A)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" use the Current Address Count Listing Files and other data products, as needed, of the Bureau of the Census tabulated from the Master Address File; and","children":[],"tail":"\n"}],"tail":"\n"},{"tag":"subparagraph","attrib":{"id":"id9d75b1ea-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19507/c/1/B"},"text":null,"children":[{"tag":"num","attrib":{"value":"B"},"text":"(B)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" make calculations at the block level, using boundaries that reflect the most current boundaries.","children":[],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"paragraph","attrib":{"id":"id9d75b1eb-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19507/c/2"},"text":null,"children":[{"tag":"num","attrib":{"value":"2"},"text":"(2)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Census Bureau and Postal Service requirements","children":[],"tail":null},{"tag":"content","attrib":{},"text":null,"children":[{"tag":"p","attrib":{},"text":"The Bureau of the Census and the United States Postal Service shall provide any relevant data to the Secretary upon request to assist the Secretary in making a calculation described in paragraph (1).","children":[],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"paragraph","attrib":{"id":"id9d75b1ec-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19507/c/3"},"text":null,"children":[{"tag":"num","attrib":{"value":"3"},"text":"(3)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Adjustment of calculation periods","children":[],"tail":null},{"tag":"content","attrib":{},"text":null,"children":[{"tag":"p","attrib":{},"text":"The Secretary may adjust the calculation periods under subparagraphs (A) and (B) of subsection (a)(2), subparagraphs (A) and (B) of subsection (a)(6), and items (aa) and (bb) of subsection (b)(2)(A)(ii)(II) by not more than 2 months to achieve alignment with the data provided by the Bureau of the Census.","children":[],"tail":"\n"}],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"subsection","attrib":{"id":"id9d75b1ed-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19507/d"},"text":null,"children":[{"tag":"num","attrib":{"value":"d"},"text":"(d)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Annual report on housing growth improvement rate","children":[],"tail":null},{"tag":"chapeau","attrib":{},"text":"Before allocating funds under section 106 for a fiscal year, the Secretary shall publish a report that—","children":[],"tail":null},{"tag":"paragraph","attrib":{"id":"id9d75b1ee-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19507/d/1"},"text":null,"children":[{"tag":"num","attrib":{"value":"1"},"text":"(1)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" includes the housing growth improvement rate for each eligible recipient; and","children":[],"tail":"\n"}],"tail":"\n"},{"tag":"paragraph","attrib":{"id":"id9d75b1ef-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19507/d/2"},"text":null,"children":[{"tag":"num","attrib":{"value":"2"},"text":"(2)","children":[],"tail":null},{"tag":"chapeau","attrib":{},"text":" lists, for the most recent fiscal year for which allocations were made under section 106—","children":[],"tail":null},{"tag":"subparagraph","attrib":{"id":"id9d75b1f0-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19507/d/2/A"},"text":null,"children":[{"tag":"num","attrib":{"value":"A"},"text":"(A)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" the eligible recipients that received a bonus amount under subsection (b)(2)(A); and","children":[],"tail":"\n"}],"tail":"\n"},{"tag":"subparagraph","attrib":{"id":"id9d75b1f1-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19507/d/2/B"},"text":null,"children":[{"tag":"num","attrib":{"value":"B"},"text":"(B)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" the eligible recipients for which the allocation under section 106 was decreased under subsection (b)(2)(B) of this section.","children":[],"tail":"\n"}],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"subsection","attrib":{"id":"id9d75b1f2-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19507/e"},"text":null,"children":[{"tag":"num","attrib":{"value":"e"},"text":"(e)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Notification; implementation dates","children":[],"tail":null},{"tag":"paragraph","attrib":{"id":"id9d75b1f3-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19507/e/1"},"text":null,"children":[{"tag":"num","attrib":{"value":"1"},"text":"(1)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Notification","children":[],"tail":null},{"tag":"subparagraph","attrib":{"id":"id9d75b1f4-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19507/e/1/A"},"text":null,"children":[{"tag":"num","attrib":{"value":"A"},"text":"(A)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" In general","children":[],"tail":null},{"tag":"content","attrib":{},"text":null,"children":[{"tag":"p","attrib":{},"text":"Not later than 60 days after ","children":[{"tag":"date","attrib":{"date":"2026-07-11"},"text":"July 11, 2026","children":[],"tail":", the Secretary shall notify each eligible recipient of the recipient’s housing growth improvement rate and whether that housing growth improvement rate is above, at, or below the median housing growth improvement rate for all eligible recipients other than extremely high-growth recipients."}],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"subparagraph","attrib":{"id":"id9d75b1f5-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19507/e/1/B"},"text":null,"children":[{"tag":"num","attrib":{"value":"B"},"text":"(B)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Guidance","children":[],"tail":null},{"tag":"content","attrib":{},"text":null,"children":[{"tag":"p","attrib":{},"text":"As part of the notification under subparagraph (A), the Secretary shall share guidance, including resources developed by the Department of Housing and Urban Development, on best practices and recommendations for policies to reduce regulatory barriers to housing and increase housing supply.","children":[],"tail":"\n"}],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"paragraph","attrib":{"id":"id9d75b1f6-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19507/e/2"},"text":null,"children":[{"tag":"num","attrib":{"value":"2"},"text":"(2)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Implementation dates","children":[],"tail":null},{"tag":"content","attrib":{},"text":null,"children":[{"tag":"p","attrib":{},"text":"Subsection (b) shall take effect beginning with the third full fiscal year after ","children":[{"tag":"date","attrib":{"date":"2026-07-11"},"text":"July 11, 2026","children":[],"tail":", and remain in effect through fiscal year 2043."}],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"paragraph","attrib":{"id":"id9d75b1f7-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19507/e/3"},"text":null,"children":[{"tag":"num","attrib":{"value":"3"},"text":"(3)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" No effect on previous appropriations","children":[],"tail":null},{"tag":"content","attrib":{},"text":null,"children":[{"tag":"p","attrib":{},"text":"This section shall not apply to amounts appropriated before ","children":[{"tag":"date","attrib":{"date":"2026-07-11"},"text":"July 11, 2026","children":[],"tail":"."}],"tail":"\n"}],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"sourceCredit","attrib":{"id":"id9d75b1f8-86b3-11f1-9949-c831ab2bbedc"},"text":"(","children":[{"tag":"ref","attrib":{"href":"/us/pl/119/101/tII/s213"},"text":"Pub. L. 119–101, title II, § 213","children":[],"tail":", "},{"tag":"date","attrib":{"date":"2026-07-11"},"text":"July 11, 2026","children":[],"tail":", "},{"tag":"ref","attrib":{"href":"/us/stat/140/885"},"text":"140 Stat. 885","children":[],"tail":".)"}],"tail":"\n"}],"tail":null}
