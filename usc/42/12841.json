{"tag":"section","attrib":{"id":"id9c934128-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s12841"},"text":null,"children":[{"tag":"num","attrib":{"value":"12841"},"text":"§ 12841.","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Nonapplicability of certain requirements for small projects","children":[],"tail":"\n"},{"tag":"chapeau","attrib":{},"text":"Notwithstanding any other provision of law, the requirements of ","children":[{"tag":"ref","attrib":{"href":"/us/usc/t12/s1701u"},"text":"section 1701u of title 12","children":[],"tail":", and any implementing regulations or guidance, shall not apply to an activity assisted under this subchapter that involves rehabilitation, construction, or other development of housing if—"}],"tail":null},{"tag":"paragraph","attrib":{"id":"id9c934129-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s12841/1"},"text":null,"children":[{"tag":"num","attrib":{"value":"1"},"text":"(1)","children":[],"tail":null},{"tag":"chapeau","attrib":{},"text":" the recipient of assistance under this subchapter is—","children":[],"tail":null},{"tag":"subparagraph","attrib":{"id":"id9c93412a-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s12841/1/A"},"text":null,"children":[{"tag":"num","attrib":{"value":"A"},"text":"(A)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" a State recipient pursuant to ","children":[{"tag":"ref","attrib":{"href":"/us/usc/t42/s12746"},"text":"section 12746 of this title","children":[],"tail":"; or"}],"tail":"\n"}],"tail":"\n"},{"tag":"subparagraph","attrib":{"id":"id9c93412b-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s12841/1/B"},"text":null,"children":[{"tag":"num","attrib":{"value":"B"},"text":"(B)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" a participating jurisdiction that received a total allocation of less than $3,000,000 in the most recent fiscal year pursuant to ","children":[{"tag":"ref","attrib":{"href":"/us/usc/t42/s12746"},"text":"section 12746 of this title","children":[],"tail":"; and"}],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"paragraph","attrib":{"id":"id9c93412c-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s12841/2"},"text":null,"children":[{"tag":"num","attrib":{"value":"2"},"text":"(2)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" the total number of dwelling units assisted as a part of such activity is not more than 50.","children":[],"tail":"\n"}],"tail":"\n"},{"tag":"sourceCredit","attrib":{"id":"id9c93412d-86b3-11f1-9949-c831ab2bbedc"},"text":"(","children":[{"tag":"ref","attrib":{"href":"/us/pl/101/625/tII/s291"},"text":"Pub. L. 101–625, title II, § 291","children":[],"tail":", as added "},{"tag":"ref","attrib":{"href":"/us/pl/119/101/tV/s501/n"},"text":"Pub. L. 119–101, title V, § 501(n)","children":[],"tail":", "},{"tag":"date","attrib":{"date":"2026-07-11"},"text":"July 11, 2026","children":[],"tail":", "},{"tag":"ref","attrib":{"href":"/us/stat/140/913"},"text":"140 Stat. 913","children":[],"tail":".)"}],"tail":"\n"}],"tail":null}
