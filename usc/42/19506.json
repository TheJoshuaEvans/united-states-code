{"tag":"section","attrib":{"id":"id9d7368a8-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19506"},"text":null,"children":[{"tag":"num","attrib":{"value":"19506"},"text":"§ 19506.","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Accelerating Home Building Act","children":[],"tail":null},{"tag":"subsection","attrib":{"id":"id9d7368a9-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19506/a"},"text":null,"children":[{"tag":"num","attrib":{"value":"a"},"text":"(a)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Definitions","children":[],"tail":null},{"tag":"chapeau","attrib":{},"text":"In this section:","children":[],"tail":null},{"tag":"paragraph","attrib":{"id":"id9d7368aa-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19506/a/1"},"text":null,"children":[{"tag":"num","attrib":{"value":"1"},"text":"(1)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Affordable housing","children":[],"tail":null},{"tag":"content","attrib":{},"text":null,"children":[{"tag":"p","attrib":{},"text":"The term “affordable housing” means housing for which the total monthly housing cost payment is not more than 30 percent of the monthly household income for a household earning not more than 80 percent of the area median income.","children":[],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"paragraph","attrib":{"id":"id9d7368ab-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19506/a/2"},"text":null,"children":[{"tag":"num","attrib":{"value":"2"},"text":"(2)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Covered structure","children":[],"tail":null},{"tag":"chapeau","attrib":{},"text":"The term “covered structure” means—","children":[],"tail":null},{"tag":"subparagraph","attrib":{"id":"id9d7368ac-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19506/a/2/A"},"text":null,"children":[{"tag":"num","attrib":{"value":"A"},"text":"(A)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" a low-rise or mid-rise structure with not more than 25 dwelling units; and","children":[],"tail":"\n"}],"tail":"\n"},{"tag":"subparagraph","attrib":{"id":"id9d7368ad-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19506/a/2/B"},"text":null,"children":[{"tag":"num","attrib":{"value":"B"},"text":"(B)","children":[],"tail":null},{"tag":"chapeau","attrib":{},"text":" includes—","children":[],"tail":null},{"tag":"clause","attrib":{"id":"id9d7368ae-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19506/a/2/B/i"},"text":null,"children":[{"tag":"num","attrib":{"value":"i"},"text":"(i)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" an accessory dwelling unit;","children":[],"tail":"\n"}],"tail":"\n"},{"tag":"clause","attrib":{"id":"id9d7368af-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19506/a/2/B/ii"},"text":null,"children":[{"tag":"num","attrib":{"value":"ii"},"text":"(ii)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" infill development;","children":[],"tail":"\n"}],"tail":"\n"},{"tag":"clause","attrib":{"id":"id9d7368b0-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19506/a/2/B/iii"},"text":null,"children":[{"tag":"num","attrib":{"value":"iii"},"text":"(iii)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" a duplex;","children":[],"tail":"\n"}],"tail":"\n"},{"tag":"clause","attrib":{"id":"id9d7368b1-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19506/a/2/B/iv"},"text":null,"children":[{"tag":"num","attrib":{"value":"iv"},"text":"(iv)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" a triplex;","children":[],"tail":"\n"}],"tail":"\n"},{"tag":"clause","attrib":{"id":"id9d7368b2-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19506/a/2/B/v"},"text":null,"children":[{"tag":"num","attrib":{"value":"v"},"text":"(v)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" a fourplex;","children":[],"tail":"\n"}],"tail":"\n"},{"tag":"clause","attrib":{"id":"id9d7368b3-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19506/a/2/B/vi"},"text":null,"children":[{"tag":"num","attrib":{"value":"vi"},"text":"(vi)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" a cottage court;","children":[],"tail":"\n"}],"tail":"\n"},{"tag":"clause","attrib":{"id":"id9d7368b4-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19506/a/2/B/vii"},"text":null,"children":[{"tag":"num","attrib":{"value":"vii"},"text":"(vii)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" a courtyard building;","children":[],"tail":"\n"}],"tail":"\n"},{"tag":"clause","attrib":{"id":"id9d7368b5-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19506/a/2/B/viii"},"text":null,"children":[{"tag":"num","attrib":{"value":"viii"},"text":"(viii)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" a townhouse;","children":[],"tail":"\n"}],"tail":"\n"},{"tag":"clause","attrib":{"id":"id9d7368b6-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19506/a/2/B/ix"},"text":null,"children":[{"tag":"num","attrib":{"value":"ix"},"text":"(ix)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" a multiplex; and","children":[],"tail":"\n"}],"tail":"\n"},{"tag":"clause","attrib":{"id":"id9d7368b7-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19506/a/2/B/x"},"text":null,"children":[{"tag":"num","attrib":{"value":"x"},"text":"(x)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" any other structure with not less than 2 dwelling units that the Secretary considers appropriate.","children":[],"tail":"\n"}],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"paragraph","attrib":{"id":"id9d7368b8-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19506/a/3"},"text":null,"children":[{"tag":"num","attrib":{"value":"3"},"text":"(3)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Eligible entity","children":[],"tail":null},{"tag":"chapeau","attrib":{},"text":"The term “eligible entity” means—","children":[],"tail":null},{"tag":"subparagraph","attrib":{"id":"id9d7368b9-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19506/a/3/A"},"text":null,"children":[{"tag":"num","attrib":{"value":"A"},"text":"(A)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" a unit of general local government, as defined in ","children":[{"tag":"ref","attrib":{"href":"/us/usc/t42/s5302/a"},"text":"section 5302(a) of this title","children":[],"tail":";"}],"tail":"\n"}],"tail":"\n"},{"tag":"subparagraph","attrib":{"id":"id9d7368ba-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19506/a/3/B"},"text":null,"children":[{"tag":"num","attrib":{"value":"B"},"text":"(B)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" a municipal membership organization; and","children":[],"tail":"\n"}],"tail":"\n"},{"tag":"subparagraph","attrib":{"id":"id9d7368bb-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19506/a/3/C"},"text":null,"children":[{"tag":"num","attrib":{"value":"C"},"text":"(C)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" an Indian tribe, as defined in ","children":[{"tag":"ref","attrib":{"href":"/us/usc/t42/s5302/a"},"text":"section 5302(a) of this title","children":[],"tail":"."}],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"paragraph","attrib":{"id":"id9d7368bc-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19506/a/4"},"text":null,"children":[{"tag":"num","attrib":{"value":"4"},"text":"(4)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" High opportunity area","children":[],"tail":null},{"tag":"content","attrib":{},"text":null,"children":[{"tag":"p","attrib":{},"text":"The term “high opportunity area” has the meaning given the term in section 1282.1 of title 12, Code of Federal Regulations, or any successor regulation.","children":[],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"paragraph","attrib":{"id":"id9d7368bd-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19506/a/5"},"text":null,"children":[{"tag":"num","attrib":{"value":"5"},"text":"(5)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Infill development","children":[],"tail":null},{"tag":"content","attrib":{},"text":null,"children":[{"tag":"p","attrib":{},"text":"The term “infill development” means residential development on small parcels in previously established areas for replacement with new or refurbished housing that utilizes existing utilities and infrastructure.","children":[],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"paragraph","attrib":{"id":"id9d7368be-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19506/a/6"},"text":null,"children":[{"tag":"num","attrib":{"value":"6"},"text":"(6)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Mixed-income housing","children":[],"tail":null},{"tag":"content","attrib":{},"text":null,"children":[{"tag":"p","attrib":{},"text":"The term “mixed-income housing” means a housing development that is comprised of housing units that promote differing levels of affordability in the community.","children":[],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"paragraph","attrib":{"id":"id9d7368bf-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19506/a/7"},"text":null,"children":[{"tag":"num","attrib":{"value":"7"},"text":"(7)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Prereviewed designs","children":[],"tail":null},{"tag":"content","attrib":{},"text":null,"children":[{"tag":"p","attrib":{},"text":"The term “prereviewed designs”, also known as pattern books, means sets of construction plans that are assessed and approved by localities for compliance with local building and permitting standards to streamline and expedite approval pathways for housing construction.","children":[],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"paragraph","attrib":{"id":"id9d7368c0-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19506/a/8"},"text":null,"children":[{"tag":"num","attrib":{"value":"8"},"text":"(8)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Rural area","children":[],"tail":null},{"tag":"content","attrib":{},"text":null,"children":[{"tag":"p","attrib":{},"text":"The term “rural area” means any area other than a city or town that has a population of less than 50,000 inhabitants.","children":[],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"paragraph","attrib":{"id":"id9d7368c1-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19506/a/9"},"text":null,"children":[{"tag":"num","attrib":{"value":"9"},"text":"(9)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Secretary","children":[],"tail":null},{"tag":"content","attrib":{},"text":null,"children":[{"tag":"p","attrib":{},"text":"The term “Secretary” means the Secretary of Housing and Urban Development.","children":[],"tail":"\n"}],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"subsection","attrib":{"id":"id9d7368c2-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19506/b"},"text":null,"children":[{"tag":"num","attrib":{"value":"b"},"text":"(b)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Authority","children":[],"tail":null},{"tag":"content","attrib":{},"text":null,"children":[{"tag":"p","attrib":{},"text":"The Secretary is authorized to award grants to eligible entities utilizing funds appropriated for such purpose to select prereviewed designs of covered structures of mixed-income housing for use in the jurisdiction of the eligible entity, except that such grant awards may not be used for construction, alteration, or repair work.","children":[],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"subsection","attrib":{"id":"id9d7368c3-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19506/c"},"text":null,"children":[{"tag":"num","attrib":{"value":"c"},"text":"(c)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Considerations","children":[],"tail":null},{"tag":"chapeau","attrib":{},"text":"In reviewing applications submitted by eligible entities for a grant under this section, the Secretary shall consider—","children":[],"tail":null},{"tag":"paragraph","attrib":{"id":"id9d7368c4-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19506/c/1"},"text":null,"children":[{"tag":"num","attrib":{"value":"1"},"text":"(1)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" the need for affordable housing in the service area of the eligible entity;","children":[],"tail":"\n"}],"tail":"\n"},{"tag":"paragraph","attrib":{"id":"id9d7368c5-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19506/c/2"},"text":null,"children":[{"tag":"num","attrib":{"value":"2"},"text":"(2)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" the presence of high opportunity areas in the jurisdiction of the eligible entity;","children":[],"tail":"\n"}],"tail":"\n"},{"tag":"paragraph","attrib":{"id":"id9d7368c6-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19506/c/3"},"text":null,"children":[{"tag":"num","attrib":{"value":"3"},"text":"(3)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" coordination between the eligible entity and a State agency; and","children":[],"tail":"\n"}],"tail":"\n"},{"tag":"paragraph","attrib":{"id":"id9d7368c7-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19506/c/4"},"text":null,"children":[{"tag":"num","attrib":{"value":"4"},"text":"(4)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" coordination between the eligible entity and State, local, and regional transportation planning authorities.","children":[],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"subsection","attrib":{"id":"id9d7368c8-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19506/d"},"text":null,"children":[{"tag":"num","attrib":{"value":"d"},"text":"(d)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Set-aside for rural areas","children":[],"tail":null},{"tag":"content","attrib":{},"text":null,"children":[{"tag":"p","attrib":{},"text":"Of the amount made available in each fiscal year for grants under this section, the Secretary shall ensure that not less than 10 percent shall be used for grants to eligible entities that are located in rural areas.","children":[],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"subsection","attrib":{"id":"id9d7368c9-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19506/e"},"text":null,"children":[{"tag":"num","attrib":{"value":"e"},"text":"(e)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Reports","children":[],"tail":null},{"tag":"chapeau","attrib":{},"text":"The Secretary shall require eligible entities receiving grants under this section to report on—","children":[],"tail":null},{"tag":"paragraph","attrib":{"id":"id9d75b1ba-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19506/e/1"},"text":null,"children":[{"tag":"num","attrib":{"value":"1"},"text":"(1)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" the impacts of the activities carried out using the grant amounts in improving the production and supply of affordable housing;","children":[],"tail":"\n"}],"tail":"\n"},{"tag":"paragraph","attrib":{"id":"id9d75b1bb-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19506/e/2"},"text":null,"children":[{"tag":"num","attrib":{"value":"2"},"text":"(2)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" the prereviewed designs selected using the grant amounts in their communities;","children":[],"tail":"\n"}],"tail":"\n"},{"tag":"paragraph","attrib":{"id":"id9d75b1bc-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19506/e/3"},"text":null,"children":[{"tag":"num","attrib":{"value":"3"},"text":"(3)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" the number of permits issued for housing development utilizing prereviewed designs; and","children":[],"tail":"\n"}],"tail":"\n"},{"tag":"paragraph","attrib":{"id":"id9d75b1bd-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19506/e/4"},"text":null,"children":[{"tag":"num","attrib":{"value":"4"},"text":"(4)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" the number of housing units produced in developments utilizing the prereviewed designs.","children":[],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"subsection","attrib":{"id":"id9d75b1be-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19506/f"},"text":null,"children":[{"tag":"num","attrib":{"value":"f"},"text":"(f)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Availability of information","children":[],"tail":null},{"tag":"chapeau","attrib":{},"text":"The Secretary shall—","children":[],"tail":null},{"tag":"paragraph","attrib":{"id":"id9d75b1bf-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19506/f/1"},"text":null,"children":[{"tag":"num","attrib":{"value":"1"},"text":"(1)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" to the extent possible, encourage localities to make publicly available through a website information on the prereviewed designs selected and submitted to the Secretary by eligible entities receiving grants under this section, including information on the benefits of use of those designs; and","children":[],"tail":"\n"}],"tail":"\n"},{"tag":"paragraph","attrib":{"id":"id9d75b1c0-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19506/f/2"},"text":null,"children":[{"tag":"num","attrib":{"value":"2"},"text":"(2)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" collect, identify, and disseminate best practices regarding such designs and make such information publicly available on the website of the Department of Housing and Urban Development.","children":[],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"subsection","attrib":{"id":"id9d75b1c1-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19506/g"},"text":null,"children":[{"tag":"num","attrib":{"value":"g"},"text":"(g)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Design adoption and repayment","children":[],"tail":null},{"tag":"content","attrib":{},"text":null,"children":[{"tag":"p","attrib":{},"text":"The Secretary may require an eligible entity to return to the Secretary any grant funds received under this section if the selected prereviewed designs submitted under this section have not been adopted during the 5-year period following receipt of the grant, unless that period is extended by the Secretary.","children":[],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"subsection","attrib":{"id":"id9d75b1c2-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19506/h"},"text":null,"children":[{"tag":"num","attrib":{"value":"h"},"text":"(h)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Technical assistance","children":[],"tail":null},{"tag":"content","attrib":{},"text":null,"children":[{"tag":"p","attrib":{},"text":"The Secretary may set aside not more than 5 percent of amounts appropriated in a fiscal year to provide technical assistance to grant recipients under this section and pregrant technical assistance to prospective applicants.","children":[],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"sourceCredit","attrib":{"id":"id9d75b1c3-86b3-11f1-9949-c831ab2bbedc"},"text":"(","children":[{"tag":"ref","attrib":{"href":"/us/pl/119/101/tII/s209"},"text":"Pub. L. 119–101, title II, § 209","children":[],"tail":", "},{"tag":"date","attrib":{"date":"2026-07-11"},"text":"July 11, 2026","children":[],"tail":", "},{"tag":"ref","attrib":{"href":"/us/stat/140/878"},"text":"140 Stat. 878","children":[],"tail":".)"}],"tail":"\n"}],"tail":null}
