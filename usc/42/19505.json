{"tag":"section","attrib":{"id":"id9d736871-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19505"},"text":null,"children":[{"tag":"num","attrib":{"value":"19505"},"text":"§ 19505.","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Innovation fund","children":[],"tail":null},{"tag":"subsection","attrib":{"id":"id9d736872-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19505/a"},"text":null,"children":[{"tag":"num","attrib":{"value":"a"},"text":"(a)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Definitions","children":[],"tail":null},{"tag":"chapeau","attrib":{},"text":"In this section:","children":[],"tail":null},{"tag":"paragraph","attrib":{"id":"id9d736873-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19505/a/1"},"text":null,"children":[{"tag":"num","attrib":{"value":"1"},"text":"(1)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Attainable housing","children":[],"tail":null},{"tag":"content","attrib":{},"text":null,"children":[{"tag":"p","attrib":{},"text":"The term “attainable housing” means housing that serves households earning not more than 120 percent of the area median income, if the majority of the housing units are affordable to households earning not more than 60 percent of the area median income.","children":[],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"paragraph","attrib":{"id":"id9d736874-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19505/a/2"},"text":null,"children":[{"tag":"num","attrib":{"value":"2"},"text":"(2)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Eligible entity","children":[],"tail":null},{"tag":"chapeau","attrib":{},"text":"The term “eligible entity” means—","children":[],"tail":null},{"tag":"subparagraph","attrib":{"id":"id9d736875-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19505/a/2/A"},"text":null,"children":[{"tag":"num","attrib":{"value":"A"},"text":"(A)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" a metropolitan city or urban county, as those terms are defined in section 102 of the Housing and Community Development Act of 1974 (","children":[{"tag":"ref","attrib":{"href":"/us/usc/t42/s5302"},"text":"42 U.S.C. 5302","children":[],"tail":"), that has demonstrated an objective improvement in housing supply growth, as determined by the Secretary, whose methodology for determining such growth is published in the Federal Register to allow for public comment not less than 90 days before the date on which the notice of funding opportunity is made available; or"}],"tail":"\n"}],"tail":"\n"},{"tag":"subparagraph","attrib":{"id":"id9d736876-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19505/a/2/B"},"text":null,"children":[{"tag":"num","attrib":{"value":"B"},"text":"(B)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" a unit of general local government or an Indian tribe, as those terms are defined in section 102 of the Housing and Community Development Act of 1974 (","children":[{"tag":"ref","attrib":{"href":"/us/usc/t42/s5302"},"text":"42 U.S.C. 5302","children":[],"tail":"), that has demonstrated an objective improvement in housing supply growth, as determined by the Secretary, whose methodology for determining such improvement is published in the Federal Register to allow for public comment not less than 90 days before the date on which the notice of funding opportunity is made available."}],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"paragraph","attrib":{"id":"id9d736877-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19505/a/3"},"text":null,"children":[{"tag":"num","attrib":{"value":"3"},"text":"(3)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Secretary","children":[],"tail":null},{"tag":"content","attrib":{},"text":null,"children":[{"tag":"p","attrib":{},"text":"The term “Secretary” means the Secretary of Housing and Urban Development.","children":[],"tail":"\n"}],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"subsection","attrib":{"id":"id9d736878-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19505/b"},"text":null,"children":[{"tag":"num","attrib":{"value":"b"},"text":"(b)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Establishment of a grant program","children":[],"tail":null},{"tag":"paragraph","attrib":{"id":"id9d736879-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19505/b/1"},"text":null,"children":[{"tag":"num","attrib":{"value":"1"},"text":"(1)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Establishment","children":[],"tail":null},{"tag":"content","attrib":{},"text":null,"children":[{"tag":"p","attrib":{},"text":"Not later than 1 year after ","children":[{"tag":"date","attrib":{"date":"2026-07-11"},"text":"July 11, 2026","children":[],"tail":", the Secretary shall establish a program to award grants on a competitive basis to eligible entities that have increased their local housing supply."}],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"paragraph","attrib":{"id":"id9d73687a-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19505/b/2"},"text":null,"children":[{"tag":"num","attrib":{"value":"2"},"text":"(2)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" List of eligible entities","children":[],"tail":null},{"tag":"content","attrib":{},"text":null,"children":[{"tag":"p","attrib":{},"text":"The Secretary shall make a list of eligible entities publicly available on the website of the Department of Housing and Urban Development.","children":[],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"paragraph","attrib":{"id":"id9d73687b-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19505/b/3"},"text":null,"children":[{"tag":"num","attrib":{"value":"3"},"text":"(3)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Eligible purposes","children":[],"tail":null},{"tag":"chapeau","attrib":{},"text":"An eligible entity receiving a grant under this section may use funds to—","children":[],"tail":null},{"tag":"subparagraph","attrib":{"id":"id9d73687c-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19505/b/3/A"},"text":null,"children":[{"tag":"num","attrib":{"value":"A"},"text":"(A)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" carry out any of the activities described in section 105 of the Housing and Community Development Act of 1974 (","children":[{"tag":"ref","attrib":{"href":"/us/usc/t42/s5305"},"text":"42 U.S.C. 5305","children":[],"tail":");"}],"tail":"\n"}],"tail":"\n"},{"tag":"subparagraph","attrib":{"id":"id9d73687d-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19505/b/3/B"},"text":null,"children":[{"tag":"num","attrib":{"value":"B"},"text":"(B)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" carry out any of the activities permitted under the Local and Regional Project Assistance Program established under ","children":[{"tag":"ref","attrib":{"href":"/us/usc/t49/s6702"},"text":"section 6702 of title 49","children":[],"tail":"; and"}],"tail":"\n"}],"tail":"\n"},{"tag":"subparagraph","attrib":{"id":"id9d73687e-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19505/b/3/C"},"text":null,"children":[{"tag":"num","attrib":{"value":"C"},"text":"(C)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" carry out initiatives of the eligible entity that facilitate the expansion of the supply of attainable housing and that supplement initiatives the eligible entity has carried out, or is in the process of carrying out, as specified in the application submitted under paragraph (4).","children":[],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"paragraph","attrib":{"id":"id9d73687f-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19505/b/4"},"text":null,"children":[{"tag":"num","attrib":{"value":"4"},"text":"(4)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Application","children":[],"tail":null},{"tag":"subparagraph","attrib":{"id":"id9d736880-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19505/b/4/A"},"text":null,"children":[{"tag":"num","attrib":{"value":"A"},"text":"(A)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" In general","children":[],"tail":null},{"tag":"chapeau","attrib":{},"text":"An eligible entity seeking a grant under this section shall submit to the Secretary an application that provides—","children":[],"tail":null},{"tag":"clause","attrib":{"id":"id9d736881-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19505/b/4/A/i"},"text":null,"children":[{"tag":"num","attrib":{"value":"i"},"text":"(i)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" a description of each purpose for which the eligible entity will use the grant, and an attestation that the grant will be used only for 1 or more eligible purposes described in paragraph (3);","children":[],"tail":"\n"}],"tail":"\n"},{"tag":"clause","attrib":{"id":"id9d736882-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19505/b/4/A/ii"},"text":null,"children":[{"tag":"num","attrib":{"value":"ii"},"text":"(ii)","children":[],"tail":null},{"tag":"chapeau","attrib":{},"text":" data on characteristics of increased housing supply during the 3-year period ending on the date on which the application is submitted, which may include whether such housing—","children":[],"tail":null},{"tag":"subclause","attrib":{"id":"id9d736883-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19505/b/4/A/ii/I"},"text":null,"children":[{"tag":"num","attrib":{"value":"I"},"text":"(I)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" serves households at a range of income levels; and","children":[],"tail":"\n"}],"tail":"\n"},{"tag":"subclause","attrib":{"id":"id9d736884-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19505/b/4/A/ii/II"},"text":null,"children":[{"tag":"num","attrib":{"value":"II"},"text":"(II)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" has improved the quality and affordability of housing in the jurisdiction of the eligible entity;","children":[],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"clause","attrib":{"id":"id9d736885-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19505/b/4/A/iii"},"text":null,"children":[{"tag":"num","attrib":{"value":"iii"},"text":"(iii)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" a description of how each eligible purpose described in clause (i) may address a community need or advance an objective, or an aspect of an objective, included in the comprehensive housing affordability strategy and community development plan of the eligible entity under part 91 of title 24, Code of Federal Regulations, or any successor regulation (commonly referred to as a “consolidated plan”); and","children":[],"tail":"\n"}],"tail":"\n"},{"tag":"clause","attrib":{"id":"id9d736886-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19505/b/4/A/iv"},"text":null,"children":[{"tag":"num","attrib":{"value":"iv"},"text":"(iv)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" a description of how the eligible entity has carried out, or is in the process of carrying out, initiatives that facilitate the expansion of the supply of housing.","children":[],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"subparagraph","attrib":{"id":"id9d736887-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19505/b/4/B"},"text":null,"children":[{"tag":"num","attrib":{"value":"B"},"text":"(B)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Initiatives","children":[],"tail":null},{"tag":"chapeau","attrib":{},"text":"Initiatives that meet the criteria described in paragraph (3)(C) include, but shall not be limited to—","children":[],"tail":null},{"tag":"clause","attrib":{"id":"id9d736888-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19505/b/4/B/i"},"text":null,"children":[{"tag":"num","attrib":{"value":"i"},"text":"(i)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" increasing by-right uses, including duplex, triplex, quadplex, and multifamily buildings, in areas of opportunity;","children":[],"tail":"\n"}],"tail":"\n"},{"tag":"clause","attrib":{"id":"id9d736889-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19505/b/4/B/ii"},"text":null,"children":[{"tag":"num","attrib":{"value":"ii"},"text":"(ii)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" revising or eliminating off-street parking requirements to reduce the cost of housing production;","children":[],"tail":"\n"}],"tail":"\n"},{"tag":"clause","attrib":{"id":"id9d73688a-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19505/b/4/B/iii"},"text":null,"children":[{"tag":"num","attrib":{"value":"iii"},"text":"(iii)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" revising minimum lot size requirements, floor area ratio requirements, set-back requirements, building heights, and bans or limits on construction that allow for denser and more affordable development;","children":[],"tail":"\n"}],"tail":"\n"},{"tag":"clause","attrib":{"id":"id9d73688b-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19505/b/4/B/iv"},"text":null,"children":[{"tag":"num","attrib":{"value":"iv"},"text":"(iv)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" instituting incentives to promote dense development for communities where increased density is needed;","children":[],"tail":"\n"}],"tail":"\n"},{"tag":"clause","attrib":{"id":"id9d73688c-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19505/b/4/B/v"},"text":null,"children":[{"tag":"num","attrib":{"value":"v"},"text":"(v)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" passing zoning overlays or other ordinances that enable the development of mixed-income housing;","children":[],"tail":"\n"}],"tail":"\n"},{"tag":"clause","attrib":{"id":"id9d73688d-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19505/b/4/B/vi"},"text":null,"children":[{"tag":"num","attrib":{"value":"vi"},"text":"(vi)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" streamlining regulatory requirements and shortening processes, increasing code enforcement and permitting capacity, reforming zoning codes, or other initiatives that reduce barriers to increasing housing supply and affordability;","children":[],"tail":"\n"}],"tail":"\n"},{"tag":"clause","attrib":{"id":"id9d73688e-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19505/b/4/B/vii"},"text":null,"children":[{"tag":"num","attrib":{"value":"vii"},"text":"(vii)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" eliminating restrictions against accessory dwelling units and expanding their by-right use;","children":[],"tail":"\n"}],"tail":"\n"},{"tag":"clause","attrib":{"id":"id9d73688f-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19505/b/4/B/viii"},"text":null,"children":[{"tag":"num","attrib":{"value":"viii"},"text":"(viii)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" using local tax incentives or public financing to promote development of attainable housing;","children":[],"tail":"\n"}],"tail":"\n"},{"tag":"clause","attrib":{"id":"id9d736890-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19505/b/4/B/ix"},"text":null,"children":[{"tag":"num","attrib":{"value":"ix"},"text":"(ix)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" streamlining environmental regulations;","children":[],"tail":"\n"}],"tail":"\n"},{"tag":"clause","attrib":{"id":"id9d736891-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19505/b/4/B/x"},"text":null,"children":[{"tag":"num","attrib":{"value":"x"},"text":"(x)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" eliminating unnecessary manufactured-housing or cooperative housing regulations and restrictions;","children":[],"tail":"\n"}],"tail":"\n"},{"tag":"clause","attrib":{"id":"id9d736892-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19505/b/4/B/xi"},"text":null,"children":[{"tag":"num","attrib":{"value":"xi"},"text":"(xi)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" minimizing the impact of overburdensome energy and water efficiency standards on housing costs; and","children":[],"tail":"\n"}],"tail":"\n"},{"tag":"clause","attrib":{"id":"id9d736893-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19505/b/4/B/xii"},"text":null,"children":[{"tag":"num","attrib":{"value":"xii"},"text":"(xii)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" other activities that reduce the cost of construction, as determined by the Secretary.","children":[],"tail":"\n"}],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"paragraph","attrib":{"id":"id9d736894-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19505/b/5"},"text":null,"children":[{"tag":"num","attrib":{"value":"5"},"text":"(5)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Grants","children":[],"tail":null},{"tag":"subparagraph","attrib":{"id":"id9d736895-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19505/b/5/A"},"text":null,"children":[{"tag":"num","attrib":{"value":"A"},"text":"(A)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" In general","children":[],"tail":null},{"tag":"content","attrib":{},"text":null,"children":[{"tag":"p","attrib":{},"text":"The Secretary shall make not fewer than 25 grants on an annual basis (unless amounts appropriated to provide grant amounts consistent with subsection (b) are insufficient, in which case fewer grants may be awarded), with strong consideration of different geographical areas and a relatively even spread of rural, suburban, and urban communities.","children":[],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"subparagraph","attrib":{"id":"id9d736896-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19505/b/5/B"},"text":null,"children":[{"tag":"num","attrib":{"value":"B"},"text":"(B)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Limitations on awards","children":[],"tail":null},{"tag":"chapeau","attrib":{},"text":"No grant awarded under this paragraph may be—","children":[],"tail":null},{"tag":"clause","attrib":{"id":"id9d736897-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19505/b/5/B/i"},"text":null,"children":[{"tag":"num","attrib":{"value":"i"},"text":"(i)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" more than $10,000,000; or","children":[],"tail":"\n"}],"tail":"\n"},{"tag":"clause","attrib":{"id":"id9d736898-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19505/b/5/B/ii"},"text":null,"children":[{"tag":"num","attrib":{"value":"ii"},"text":"(ii)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" less than $250,000.","children":[],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"subparagraph","attrib":{"id":"id9d736899-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19505/b/5/C"},"text":null,"children":[{"tag":"num","attrib":{"value":"C"},"text":"(C)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Priority","children":[],"tail":null},{"tag":"chapeau","attrib":{},"text":"When awarding grants under this paragraph, the Secretary shall give priority to an eligible entity that has—","children":[],"tail":null},{"tag":"clause","attrib":{"id":"id9d73689a-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19505/b/5/C/i"},"text":null,"children":[{"tag":"num","attrib":{"value":"i"},"text":"(i)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" demonstrated the use of innovative policies, interventions, or programs for increasing housing supply; and","children":[],"tail":"\n"}],"tail":"\n"},{"tag":"clause","attrib":{"id":"id9d73689b-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19505/b/5/C/ii"},"text":null,"children":[{"tag":"num","attrib":{"value":"ii"},"text":"(ii)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" demonstrated a marked improvement in housing supply growth, as needed.","children":[],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"subparagraph","attrib":{"id":"id9d73689c-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19505/b/5/D"},"text":null,"children":[{"tag":"num","attrib":{"value":"D"},"text":"(D)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Grant administration and terms","children":[],"tail":null},{"tag":"content","attrib":{},"text":null,"children":[{"tag":"p","attrib":{},"text":"Projects assisted under this section for activities described in sector 23 of the North American Industry Classification System shall be treated as projects assisted under the Community Development Block Grant program under title I of the Housing and Community Development Act of 1974 (","children":[{"tag":"ref","attrib":{"href":"/us/usc/t42/s5301"},"text":"42 U.S.C. 5301","children":[],"tail":" et seq.)."}],"tail":"\n"}],"tail":"\n"}],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"subsection","attrib":{"id":"id9d73689d-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19505/c"},"text":null,"children":[{"tag":"num","attrib":{"value":"c"},"text":"(c)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Rules of construction","children":[],"tail":null},{"tag":"chapeau","attrib":{},"text":"Nothing in this section shall be construed—","children":[],"tail":null},{"tag":"paragraph","attrib":{"id":"id9d73689e-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19505/c/1"},"text":null,"children":[{"tag":"num","attrib":{"value":"1"},"text":"(1)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" to authorize the Secretary to mandate, supersede, or preempt any local zoning or land use policy; or","children":[],"tail":"\n"}],"tail":"\n"},{"tag":"paragraph","attrib":{"id":"id9d73689f-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19505/c/2"},"text":null,"children":[{"tag":"num","attrib":{"value":"2"},"text":"(2)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" to affect the requirements of ","children":[{"tag":"ref","attrib":{"href":"/us/usc/t42/s12705/c/1"},"text":"section 12705(c)(1) of this title","children":[],"tail":"."}],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"subsection","attrib":{"id":"id9d7368a0-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19505/d"},"text":null,"children":[{"tag":"num","attrib":{"value":"d"},"text":"(d)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Sunset","children":[],"tail":null},{"tag":"content","attrib":{},"text":null,"children":[{"tag":"p","attrib":{},"text":"The program established under this section shall terminate on the date that is 7 years after ","children":[{"tag":"date","attrib":{"date":"2026-07-11"},"text":"July 11, 2026","children":[],"tail":"."}],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"subsection","attrib":{"id":"id9d7368a1-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19505/e"},"text":null,"children":[{"tag":"num","attrib":{"value":"e"},"text":"(e)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Authorization of appropriations","children":[],"tail":null},{"tag":"paragraph","attrib":{"id":"id9d7368a2-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19505/e/1"},"text":null,"children":[{"tag":"num","attrib":{"value":"1"},"text":"(1)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" In general","children":[],"tail":null},{"tag":"content","attrib":{},"text":null,"children":[{"tag":"p","attrib":{},"text":"There is authorized to be appropriated to carry out this section $200,000,000 for each of fiscal years 2027 through 2031.","children":[],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"paragraph","attrib":{"id":"id9d7368a3-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19505/e/2"},"text":null,"children":[{"tag":"num","attrib":{"value":"2"},"text":"(2)","children":