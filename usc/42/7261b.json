{"tag":"section","attrib":{"id":"id9b135874-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s7261b"},"text":null,"children":[{"tag":"num","attrib":{"value":"7261b"},"text":"§ 7261b.","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Technology transfer to small businesses","children":[],"tail":null},{"tag":"paragraph","attrib":{"id":"id9b135875-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s7261b/1"},"text":null,"children":[{"tag":"num","attrib":{"value":"1"},"text":"(1)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" The Secretary of Energy shall establish a program to facilitate and encourage the transfer of technology to small businesses and shall issue guidelines relating to the program not later than ","children":[{"tag":"date","attrib":{"date":"1993-05-01"},"text":"May 1, 1993","children":[],"tail":"."}],"tail":"\n"}],"tail":"\n"},{"tag":"paragraph","attrib":{"id":"id9b135876-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s7261b/2"},"text":null,"children":[{"tag":"num","attrib":{"value":"2"},"text":"(2)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" For the purposes of this section, the term “small business” means a business concern that meets the applicable size standards prescribed pursuant to ","children":[{"tag":"ref","attrib":{"href":"/us/usc/t15/s632/a"},"text":"section 632(a) of title 15","children":[],"tail":"."}],"tail":"\n"}],"tail":"\n"},{"tag":"sourceCredit","attrib":{"id":"id9b135877-86b3-11f1-9949-c831ab2bbedc"},"text":"(","children":[{"tag":"ref","attrib":{"href":"/us/pl/102/484/dC/tXXXI/s3135/b"},"text":"Pub. L. 102–484, div. C, title XXXI, § 3135(b)","children":[],"tail":", "},{"tag":"date","attrib":{"date":"1992-10-23"},"text":"Oct. 23, 1992","children":[],"tail":", "},{"tag":"ref","attrib":{"href":"/us/stat/106/2641"},"text":"106 Stat. 2641","children":[],"tail":".)"}],"tail":"\n"},{"tag":"notes","attrib":{"type":"uscNote","id":"id9b135878-86b3-11f1-9949-c831ab2bbedc"},"text":"\n","children":[{"tag":"note","attrib":{"role":"crossHeading","topic":"editorialNotes","id":"id9b135879-86b3-11f1-9949-c831ab2bbedc"},"text":null,"children":[{"tag":"heading","attrib":{},"text":null,"children":[{"tag":"b","attrib":{},"text":"Editorial Notes","children":[],"tail":null}],"tail":null}],"tail":"\n"},{"tag":"note","attrib":{"topic":"codification","id":"id9b13587a-86b3-11f1-9949-c831ab2bbedc"},"text":null,"children":[{"tag":"heading","attrib":{},"text":"Codification","children":[],"tail":"\n"},{"tag":"p","attrib":{},"text":"Section was enacted as part of the National Defense Authorization Act for Fiscal Year 1993, and not as part of the Department of Energy Organization Act which comprises this chapter.","children":[],"tail":"\n"}],"tail":"\n"}],"tail":"\n"}],"tail":null}
