{"tag":"section","attrib":{"id":"id987c592f-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s1471a"},"text":null,"children":[{"tag":"num","attrib":{"value":"1471a"},"text":"§ 1471a.","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Exemption on construction or modification of residential housing located on an infill site","children":[],"tail":null},{"tag":"subsection","attrib":{"id":"id987c5930-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s1471a/a"},"text":null,"children":[{"tag":"num","attrib":{"value":"a"},"text":"(a)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Exemption","children":[],"tail":null},{"tag":"content","attrib":{},"text":null,"children":[{"tag":"p","attrib":{},"text":"In providing assistance under section 501, 502, 504, 515, 533, or 538 of the Housing Act of 1949 (","children":[{"tag":"ref","attrib":{"href":"/us/usc/t42/s1471"},"text":"42 U.S.C. 1471","children":[],"tail":", 1472, 1474, 1485, 1490m, or 1490p–2) for the construction or modification of residential housing located on an infill site, the Secretary of Agriculture shall not be required to carry out any study or report on the environmental effects of such assistance."}],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"subsection","attrib":{"id":"id987c5931-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s1471a/b"},"text":null,"children":[{"tag":"num","attrib":{"value":"b"},"text":"(b)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Report","children":[],"tail":null},{"tag":"chapeau","attrib":{},"text":"Not later than the date that is 5 years after ","children":[{"tag":"date","attrib":{"date":"2026-07-11"},"text":"July 11, 2026","children":[],"tail":", the Secretary of Agriculture shall submit, to the Committee on Financial Services of the House of Representatives and the Committee on Banking, Housing, and Urban Affairs of the Senate, a report that—"}],"tail":null},{"tag":"paragraph","attrib":{"id":"id987c5932-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s1471a/b/1"},"text":null,"children":[{"tag":"num","attrib":{"value":"1"},"text":"(1)","children":[],"tail":null},{"tag":"chapeau","attrib":{},"text":" determines whether the implementation of this section—","children":[],"tail":null},{"tag":"subparagraph","attrib":{"id":"id987c5933-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s1471a/b/1/A"},"text":null,"children":[{"tag":"num","attrib":{"value":"A"},"text":"(A)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" reduced the amount of time it takes to review an application for assistance under the sections of the Housing Act of 1949 identified in subsection (a); and","children":[],"tail":"\n"}],"tail":"\n"},{"tag":"subparagraph","attrib":{"id":"id987c5934-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s1471a/b/1/B"},"text":null,"children":[{"tag":"num","attrib":{"value":"B"},"text":"(B)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" reduced the administrative cost of providing such assistance;","children":[],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"paragraph","attrib":{"id":"id987c5935-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s1471a/b/2"},"text":null,"children":[{"tag":"num","attrib":{"value":"2"},"text":"(2)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" describes how the implementation of this section affects the affordable housing sector in rural America; and","children":[],"tail":"\n"}],"tail":"\n"},{"tag":"paragraph","attrib":{"id":"id987c5936-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s1471a/b/3"},"text":null,"children":[{"tag":"num","attrib":{"value":"3"},"text":"(3)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" includes any legislative recommendations from the Secretary of Agriculture.","children":[],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"subsection","attrib":{"id":"id987c5937-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s1471a/c"},"text":null,"children":[{"tag":"num","attrib":{"value":"c"},"text":"(c)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Definitions","children":[],"tail":null},{"tag":"chapeau","attrib":{},"text":"In this section:","children":[],"tail":null},{"tag":"paragraph","attrib":{"id":"id987c5938-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s1471a/c/1"},"text":null,"children":[{"tag":"num","attrib":{"value":"1"},"text":"(1)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Greenfield","children":[],"tail":null},{"tag":"content","attrib":{},"text":null,"children":[{"tag":"p","attrib":{},"text":"The term “greenfield” means a site that has not been developed, including a woodland, farmland, and an open field.","children":[],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"paragraph","attrib":{"id":"id987c5939-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s1471a/c/2"},"text":null,"children":[{"tag":"num","attrib":{"value":"2"},"text":"(2)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Infill site","children":[],"tail":null},{"tag":"chapeau","attrib":{},"text":"The term “infill site”—","children":[],"tail":null},{"tag":"subparagraph","attrib":{"id":"id987c593a-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s1471a/c/2/A"},"text":null,"children":[{"tag":"num","attrib":{"value":"A"},"text":"(A)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" means a site that is served by existing infrastructure, including water lines, sewer lines, and roads; and","children":[],"tail":"\n"}],"tail":"\n"},{"tag":"subparagraph","attrib":{"id":"id987c593b-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s1471a/c/2/B"},"text":null,"children":[{"tag":"num","attrib":{"value":"B"},"text":"(B)","children":[],"tail":null},{"tag":"chapeau","attrib":{},"text":" does not include—","children":[],"tail":null},{"tag":"clause","attrib":{"id":"id987c593c-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s1471a/c/2/B/i"},"text":null,"children":[{"tag":"num","attrib":{"value":"i"},"text":"(i)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" a site that is served by existing infrastructure that only consists of a road;","children":[],"tail":"\n"}],"tail":"\n"},{"tag":"clause","attrib":{"id":"id987c593d-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s1471a/c/2/B/ii"},"text":null,"children":[{"tag":"num","attrib":{"value":"ii"},"text":"(ii)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" a site within a census tract designated as very high or relatively high risk for wildfire, coastal flooding, and riverine flooding under the National Risk Index of the Federal Emergency Management Agency pursuant to ","children":[{"tag":"ref","attrib":{"href":"/us/usc/t42/s5136"},"text":"section 5136 of this title","children":[],"tail":"; and"}],"tail":"\n"}],"tail":"\n"},{"tag":"clause","attrib":{"id":"id987c593e-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s1471a/c/2/B/iii"},"text":null,"children":[{"tag":"num","attrib":{"value":"iii"},"text":"(iii)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" a greenfield.","children":[],"tail":"\n"}],"tail":"\n"}],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"sourceCredit","attrib":{"id":"id987c593f-86b3-11f1-9949-c831ab2bbedc"},"text":"(","children":[{"tag":"ref","attrib":{"href":"/us/pl/119/101/tI/s103"},"text":"Pub. L. 119–101, title I, § 103","children":[],"tail":", "},{"tag":"date","attrib":{"date":"2026-07-11"},"text":"July 11, 2026","children":[],"tail":", "},{"tag":"ref","attrib":{"href":"/us/stat/140/851"},"text":"140 Stat. 851","children":[],"tail":".)"}],"tail":"\n"},{"tag":"notes","attrib":{"type":"uscNote","id":"id987c5940-86b3-11f1-9949-c831ab2bbedc"},"text":"\n","children":[{"tag":"note","attrib":{"role":"crossHeading","topic":"editorialNotes","id":"id987c5941-86b3-11f1-9949-c831ab2bbedc"},"text":null,"children":[{"tag":"heading","attrib":{},"text":null,"children":[{"tag":"b","attrib":{},"text":"Editorial Notes","children":[],"tail":null}],"tail":null}],"tail":"\n"},{"tag":"note","attrib":{"topic":"referencesInText","id":"id987c5942-86b3-11f1-9949-c831ab2bbedc"},"text":"\n","children":[{"tag":"heading","attrib":{},"text":"References in Text","children":[],"tail":null},{"tag":"p","attrib":{},"text":"The Housing Act of 1949, referred to in subsec. (b)(1)(A), is ","children":[{"tag":"ref","attrib":{"href":"/us/act/1949-07-15/ch338"},"text":"act July 15, 1949, ch. 338","children":[],"tail":", "},{"tag":"ref","attrib":{"href":"/us/stat/63/413"},"text":"63 Stat. 413","children":[],"tail":", which is classified principally to this chapter. For complete classification of this Act to the Code, see Short Title note set out under "},{"tag":"ref","attrib":{"href":"/us/usc/t42/s1441"},"text":"section 1441 of this title","children":[],"tail":" and Tables."}],"tail":"\n"}],"tail":"\n"},{"tag":"note","attrib":{"topic":"codification","id":"id987c5943-86b3-11f1-9949-c831ab2bbedc"},"text":null,"children":[{"tag":"heading","attrib":{},"text":"Codification","children":[],"tail":"\n"},{"tag":"p","attrib":{},"text":"Section was enacted as part of the 21st Century ROAD to Housing Act, and not as part of the Housing Act of 1949 which comprises this chapter.","children":[],"tail":"\n"}],"tail":"\n"}],"tail":"\n"}],"tail":null}
