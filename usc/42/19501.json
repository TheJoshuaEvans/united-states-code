{"tag":"section","attrib":{"id":"id9d70f886-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19501"},"text":null,"children":[{"tag":"num","attrib":{"value":"19501"},"text":"§ 19501.","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Increasing housing in opportunity zones","children":[],"tail":null},{"tag":"subsection","attrib":{"id":"id9d70f887-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19501/a"},"text":null,"children":[{"tag":"num","attrib":{"value":"a"},"text":"(a)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Covered grant defined","children":[],"tail":null},{"tag":"content","attrib":{},"text":null,"children":[{"tag":"p","attrib":{},"text":"In this section, the term “covered grant” means any competitive grant relating to the construction, modification, rehabilitation, or preservation of housing, as determined by the Secretary of Housing and Urban Development.","children":[],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"subsection","attrib":{"id":"id9d70f888-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s19501/b"},"text":null,"children":[{"tag":"num","attrib":{"value":"b"},"text":"(b)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Priority","children":[],"tail":null},{"tag":"content","attrib":{},"text":null,"children":[{"tag":"p","attrib":{},"text":"When awarding a covered grant, the Secretary of Housing and Urban Development may give additional weight to applicants with proposed activities or projects that are located in or substantially and directly benefit a community designated as a qualified opportunity zone under ","children":[{"tag":"ref","attrib":{"href":"/us/usc/t26/s1400Z–1"},"text":"section 1400Z–1 of title 26","children":[],"tail":"."}],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"sourceCredit","attrib":{"id":"id9d70f889-86b3-11f1-9949-c831ab2bbedc"},"text":"(","children":[{"tag":"ref","attrib":{"href":"/us/pl/119/101/tII/s201"},"text":"Pub. L. 119–101, title II, § 201","children":[],"tail":", "},{"tag":"date","attrib":{"date":"2026-07-11"},"text":"July 11, 2026","children":[],"tail":", "},{"tag":"ref","attrib":{"href":"/us/stat/140/859"},"text":"140 Stat. 859","children":[],"tail":".)"}],"tail":"\n"}],"tail":null}
