{"tag":"section","attrib":{"id":"id9d41344c-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s18387"},"text":null,"children":[{"tag":"num","attrib":{"value":"18387"},"text":"§ 18387.","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Near-Earth object survey and policy with respect to threats posed","children":[],"tail":null},{"tag":"subsection","attrib":{"id":"id9d41344d-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s18387/a"},"text":null,"children":[{"tag":"num","attrib":{"value":"a"},"text":"(a)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Policy reaffirmation","children":[],"tail":null},{"tag":"content","attrib":{},"text":null,"children":[{"tag":"p","attrib":{},"text":"Congress reaffirms the policy set forth in ","children":[{"tag":"ref","attrib":{"href":"/us/usc/t51/s20102/g"},"text":"section 20102(g) of title 51","children":[],"tail":" relating to surveying near-Earth asteroids and comets."}],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"subsection","attrib":{"id":"id9d41344e-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s18387/b"},"text":null,"children":[{"tag":"num","attrib":{"value":"b"},"text":"(b)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Implementation","children":[],"tail":null},{"tag":"content","attrib":{},"text":null,"children":[{"tag":"p","attrib":{},"text":"The Director of the OSTP shall implement, before ","children":[{"tag":"date","attrib":{"date":"2012-09-30"},"text":"September 30, 2012","children":[],"tail":", a policy for notifying Federal agencies and relevant emergency response institutions of an impending near-Earth object threat if near-term public safety is at risk, and assign a Federal agency or agencies to be responsible for protecting the United States and working with the international community on such threats."}],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"sourceCredit","attrib":{"id":"id9d41344f-86b3-11f1-9949-c831ab2bbedc"},"text":"(","children":[{"tag":"ref","attrib":{"href":"/us/pl/111/267/tVIII/s808"},"text":"Pub. L. 111–267, title VIII, § 808","children":[],"tail":", "},{"tag":"date","attrib":{"date":"2010-10-11"},"text":"Oct. 11, 2010","children":[],"tail":", "},{"tag":"ref","attrib":{"href":"/us/stat/124/2834"},"text":"124 Stat. 2834","children":[],"tail":".)"}],"tail":"\n"},{"tag":"notes","attrib":{"type":"uscNote","id":"id9d413450-86b3-11f1-9949-c831ab2bbedc"},"text":"\n","children":[{"tag":"note","attrib":{"role":"crossHeading","topic":"editorialNotes","id":"id9d413451-86b3-11f1-9949-c831ab2bbedc"},"text":null,"children":[{"tag":"heading","attrib":{},"text":null,"children":[{"tag":"b","attrib":{},"text":"Editorial Notes","children":[],"tail":null}],"tail":null}],"tail":"\n"},{"tag":"note","attrib":{"topic":"codification","id":"id9d413452-86b3-11f1-9949-c831ab2bbedc"},"text":null,"children":[{"tag":"heading","attrib":{},"text":"Codification","children":[],"tail":"\n"},{"tag":"p","attrib":{},"text":"In subsec. (a), “","children":[{"tag":"ref","attrib":{"href":"/us/usc/t51/s20102/g"},"text":"section 20102(g) of title 51","children":[],"tail":"” substituted for “section 102(g) of the National Aeronautics and Space Act of 1958 ("},{"tag":"ref","attrib":{"href":"/us/usc/t42/s2451/g"},"text":"42 U.S.C. 2451(g)","children":[],"tail":")” on authority of "},{"tag":"ref","attrib":{"href":"/us/pl/111/314/s5/e"},"text":"Pub. L. 111–314, § 5(e)","children":[],"tail":", "},{"tag":"date","attrib":{"date":"2010-12-18"},"text":"Dec. 18, 2010","children":[],"tail":", "},{"tag":"ref","attrib":{"href":"/us/stat/124/3443"},"text":"124 Stat. 3443","children":[],"tail":", which Act enacted Title 51, National and Commercial Space Programs."}],"tail":"\n"}],"tail":"\n"}],"tail":"\n"}],"tail":null}
