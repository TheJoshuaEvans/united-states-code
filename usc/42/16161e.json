" the Idaho National Laboratory, the National Renewable Energy Laboratory, and other National Laboratories in a cross-cutting manner;","children":[],"tail":"\n"}],"tail":"\n"},{"tag":"subparagraph","attrib":{"id":"id9ce447f5-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s16161e/b/1/B"},"text":null,"children":[{"tag":"num","attrib":{"value":"B"},"text":"(B)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" institutions of higher education;","children":[],"tail":"\n"}],"tail":"\n"},{"tag":"subparagraph","attrib":{"id":"id9ce447f6-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s16161e/b/1/C"},"text":null,"children":[{"tag":"num","attrib":{"value":"C"},"text":"(C)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" research institutes;","children":[],"tail":"\n"}],"tail":"\n"},{"tag":"subparagraph","attrib":{"id":"id9ce447f7-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s16161e/b/1/D"},"text":null,"children":[{"tag":"num","attrib":{"value":"D"},"text":"(D)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" industrial researchers; and","children":[],"tail":"\n"}],"tail":"\n"},{"tag":"subparagraph","attrib":{"id":"id9ce447f8-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s16161e/b/1/E"},"text":null,"children":[{"tag":"num","attrib":{"value":"E"},"text":"(E)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" international researchers; and","children":[],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"paragraph","attrib":{"id":"id9ce447f9-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s16161e/b/2"},"text":null,"children":[{"tag":"num","attrib":{"value":"2"},"text":"(2)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" act as a clearinghouse to collect information from, and distribute information to, the National Laboratories and other entities described in subparagraphs (B) through (E) of paragraph (1).","children":[],"tail":"\n"}],"tail":"\n"}],"tail":"\n"