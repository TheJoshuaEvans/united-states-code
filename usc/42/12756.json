{"tag":"section","attrib":{"id":"id9c8e5fa5-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s12756"},"text":null,"children":[{"tag":"num","attrib":{"value":"12756"},"text":"§ 12756.","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Monitoring of compliance","children":[],"tail":null},{"tag":"subsection","attrib":{"id":"id9c8e5fa6-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s12756/a"},"text":null,"children":[{"tag":"num","attrib":{"value":"a"},"text":"(a)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Enforceable agreements","children":[],"tail":null},{"tag":"content","attrib":{},"text":null,"children":[{"tag":"p","attrib":{},"text":"Each participating jurisdiction, through binding contractual agreements with owners and otherwise, shall ensure long-term compliance with the provisions of this subchapter. Such measures shall provide for (1) enforcement of the provisions of this subchapter by the jurisdiction or by the intended beneficiaries, and (2) remedies for the breach of such provisions.","children":[],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"subsection","attrib":{"id":"id9c8e5fa7-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s12756/b"},"text":null,"children":[{"tag":"num","attrib":{"value":"b"},"text":"(b)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Periodic monitoring","children":[],"tail":null},{"tag":"paragraph","attrib":{"id":"id9c8e5fa8-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s12756/b/1"},"text":null,"children":[{"tag":"num","attrib":{"value":"1"},"text":"(1)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" In general","children":[],"tail":null},{"tag":"content","attrib":{},"text":null,"children":[{"tag":"p","attrib":{},"text":"Each participating jurisdiction, not less frequently than annually, shall review the activities of owners of affordable housing assisted under this subchapter for rental to assess compliance with the requirements of this subchapter.","children":[],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"paragraph","attrib":{"id":"id9c8e5fa9-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s12756/b/2"},"text":null,"children":[{"tag":"num","attrib":{"value":"2"},"text":"(2)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Onsite inspections","children":[],"tail":null},{"tag":"subparagraph","attrib":{"id":"id9c8e5faa-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s12756/b/2/A"},"text":null,"children":[{"tag":"num","attrib":{"value":"A"},"text":"(A)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Inspections by units of general local government","children":[],"tail":null},{"tag":"content","attrib":{},"text":null,"children":[{"tag":"p","attrib":{},"text":"A review conducted under paragraph (1) by a participating jurisdiction that is a unit of general local government shall include an onsite inspection to determine compliance with housing codes and other applicable regulations.","children":[],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"subparagraph","attrib":{"id":"id9c8e5fab-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s12756/b/2/B"},"text":null,"children":[{"tag":"num","attrib":{"value":"B"},"text":"(B)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Inspections by States","children":[],"tail":null},{"tag":"content","attrib":{},"text":null,"children":[{"tag":"p","attrib":{},"text":"A review conducted under paragraph (1) by a participating jurisdiction that is a State shall include an onsite inspection to determine compliance with a national standard as determined by the Secretary.","children":[],"tail":"\n"}],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"paragraph","attrib":{"id":"id9c8e5fac-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s12756/b/3"},"text":null,"children":[{"tag":"num","attrib":{"value":"3"},"text":"(3)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Inclusion in performance report and publication","children":[],"tail":null},{"tag":"content","attrib":{},"text":null,"children":[{"tag":"p","attrib":{},"text":"A participating jurisdiction shall include in the performance report of the participating jurisdiction submitted to the Secretary under ","children":[{"tag":"ref","attrib":{"href":"/us/usc/t42/s12708/a"},"text":"section 12708(a) of this title","children":[],"tail":", and make available to the public, the results of each review conducted under paragraph (1)."}],"tail":"\n"}],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"subsection","attrib":{"id":"id9c8e5fad-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s12756/c"},"text":null,"children":[{"tag":"num","attrib":{"value":"c"},"text":"(c)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Special procedures for certain projects","children":[],"tail":null},{"tag":"content","attrib":{},"text":null,"children":[{"tag":"p","attrib":{},"text":"In the case of small-scale or scattered site housing, the Secretary may provide for such streamlined procedures for achieving the purposes of this section as the Secretary determines to be appropriate.","children":[],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"sourceCredit","attrib":{"id":"id9c8e5fae-86b3-11f1-9949-c831ab2bbedc"},"text":"(","children":[{"tag":"ref","attrib":{"href":"/us/pl/101/625/tII/s226"},"text":"Pub. L. 101–625, title II, § 226","children":[],"tail":", "},{"tag":"date","attrib":{"date":"1990-11-28"},"text":"Nov. 28, 1990","children":[],"tail":", "},{"tag":"ref","attrib":{"href":"/us/stat/104/4114"},"text":"104 Stat. 4114","children":[],"tail":"; "},{"tag":"ref","attrib":{"href":"/us/pl/119/101/tV/s501/t/3"},"text":"Pub. L. 119–101, title V, § 501(t)(3)","children":[],"tail":", "},{"tag":"date","attrib":{"date":"2026-07-11"},"text":"July 11, 2026","children":[],"tail":", "},{"tag":"ref","attrib":{"href":"/us/stat/140/915"},"text":"140 Stat. 915","children":[],"tail":".)"}],"tail":"\n"},{"tag":"notes","attrib":{"type":"uscNote","id":"id9c8e5faf-86b3-11f1-9949-c831ab2bbedc"},"text":"\n","children":[{"tag":"note","attrib":{"role":"crossHeading","topic":"editorialNotes","id":"id9c8e5fb0-86b3-11f1-9949-c831ab2bbedc"},"text":null,"children":[{"tag":"heading","attrib":{},"text":null,"children":[{"tag":"b","attrib":{},"text":"Editorial Notes","children":[],"tail":null}],"tail":null}],"tail":"\n"},{"tag":"note","attrib":{"topic":"amendments","id":"id9c8e5fb1-86b3-11f1-9949-c831ab2bbedc"},"text":null,"children":[{"tag":"heading","attrib":{},"text":"Amendments","children":[],"tail":null},{"tag":"p","attrib":{},"text":"2026—Subsec. (b). ","children":[{"tag":"ref","attrib":{"href":"/us/pl/119/101"},"text":"Pub. L. 119–101","children":[],"tail":" inserted par. (1) designation and heading before “Each participating jurisdiction” and substituted pars. (2) and (3) for “Such review shall include on-site inspection to determine compliance with housing codes and other applicable regulations. The results of each review shall be included in the jurisdiction’s performance report submitted to the Secretary under "},{"tag":"ref","attrib":{"href":"/us/usc/t42/s12708/a"},"text":"section 12708(a) of this title","children":[],"tail":" and made available to the public.”"}],"tail":"\n"}],"tail":"\n"}],"tail":"\n"}],"tail":null}
