{"tag":"section","attrib":{"id":"id9c8732fd-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s12710"},"text":null,"children":[{"tag":"num","attrib":{"value":"12710"},"text":"§ 12710.","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Capacity study","children":[],"tail":null},{"tag":"subsection","attrib":{"id":"id9c8732fe-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s12710/a"},"text":null,"children":[{"tag":"num","attrib":{"value":"a"},"text":"(a)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" In general","children":[],"tail":null},{"tag":"content","attrib":{},"text":null,"children":[{"tag":"p","attrib":{},"text":"The Secretary shall ensure that the Department of Housing and Urban Development has adequate capacity and resources, including staff and training programs, to carry out its mission and responsibilities to implement the provisions of this Act, including the ability of the Department to carry out the multifamily mortgage insurance program, and the ability to respond to areas identified as “material weaknesses” by the Office of the Inspector General in financial audits or other reports.","children":[],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"subsection","attrib":{"id":"id9c8732ff-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s12710/b"},"text":null,"children":[{"tag":"num","attrib":{"value":"b"},"text":"(b)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Report","children":[],"tail":null},{"tag":"content","attrib":{},"text":null,"children":[{"tag":"p","attrib":{},"text":"Not later than 60 days after ","children":[{"tag":"date","attrib":{"date":"1990-11-28"},"text":"November 28, 1990","children":[],"tail":", and annually thereafter, the Secretary shall prepare and submit to the Committee on Banking, Housing, and Urban Affairs of the Senate and the Committee on Financial Services of the House of Representatives a study detailing the Department’s plan to maintain such capacity, together with any recommendations for legislative and administrative action as the Secretary determines to be appropriate."}],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"sourceCredit","attrib":{"id":"id9c873300-86b3-11f1-9949-c831ab2bbedc"},"text":"(","children":[{"tag":"ref","attrib":{"href":"/us/pl/101/625/tI/s110"},"text":"Pub. L. 101–625, title I, § 110","children":[],"tail":", "},{"tag":"date","attrib":{"date":"1990-11-28"},"text":"Nov. 28, 1990","children":[],"tail":", "},{"tag":"ref","attrib":{"href":"/us/stat/104/4093"},"text":"104 Stat. 4093","children":[],"tail":"; "},{"tag":"ref","attrib":{"href":"/us/pl/102/550/tIV/s407"},"text":"Pub. L. 102–550, title IV, § 407","children":[],"tail":", "},{"tag":"date","attrib":{"date":"1992-10-28"},"text":"Oct. 28, 1992","children":[],"tail":", "},{"tag":"ref","attrib":{"href":"/us/stat/106/3778"},"text":"106 Stat. 3778","children":[],"tail":"; "},{"tag":"ref","attrib":{"href":"/us/pl/119/101/tV/s501/v/2"},"text":"Pub. L. 119–101, title V, § 501(v)(2)","children":[],"tail":", "},{"tag":"date","attrib":{"date":"2026-07-11"},"text":"July 11, 2026","children":[],"tail":", "},{"tag":"ref","attrib":{"href":"/us/stat/140/917"},"text":"140 Stat. 917","children":[],"tail":".)"}],"tail":"\n"},{"tag":"notes","attrib":{"type":"uscNote","id":"id9c873301-86b3-11f1-9949-c831ab2bbedc"},"text":"\n","children":[{"tag":"note","attrib":{"role":"crossHeading","topic":"editorialNotes","id":"id9c873302-86b3-11f1-9949-c831ab2bbedc"},"text":null,"children":[{"tag":"heading","attrib":{},"text":null,"children":[{"tag":"b","attrib":{},"text":"Editorial Notes","children":[],"tail":null}],"tail":null}],"tail":"\n"},{"tag":"note","attrib":{"topic":"referencesInText","id":"id9c873303-86b3-11f1-9949-c831ab2bbedc"},"text":"\n","children":[{"tag":"heading","attrib":{},"text":"References in Text","children":[],"tail":null},{"tag":"p","attrib":{},"text":"This Act, referred to in subsec. (a), is ","children":[{"tag":"ref","attrib":{"href":"/us/pl/101/625"},"text":"Pub. L. 101–625","children":[],"tail":", "},{"tag":"date","attrib":{"date":"1990-11-28"},"text":"Nov. 28, 1990","children":[],"tail":", "},{"tag":"ref","attrib":{"href":"/us/stat/104/4079"},"text":"104 Stat. 4079","children":[],"tail":", known as the Cranston-Gonzalez National Affordable Housing Act. For complete classification of this Act to the Code, see Short Title note set out under "},{"tag":"ref","attrib":{"href":"/us/usc/t42/s12701"},"text":"section 12701 of this title","children":[],"tail":" and Tables."}],"tail":"\n"}],"tail":"\n"},{"tag":"note","attrib":{"topic":"amendments","id":"id9c873304-86b3-11f1-9949-c831ab2bbedc"},"text":null,"children":[{"tag":"heading","attrib":{},"text":"Amendments","children":[],"tail":null},{"tag":"p","attrib":{},"text":"2026—Subsec. (b). ","children":[{"tag":"ref","attrib":{"href":"/us/pl/119/101"},"text":"Pub. L. 119–101","children":[],"tail":" substituted “Committee on Financial Services” for “Committee on Banking, Finance and Urban Affairs”."}],"tail":"\n"},{"tag":"p","attrib":{},"text":"1992—Subsec. (a). ","children":[{"tag":"ref","attrib":{"href":"/us/pl/102/550"},"text":"Pub. L. 102–550","children":[],"tail":" struck out “, and” after “responsibilities” and substituted for period at end “and the ability to respond to areas identified as ‘material weaknesses’ by the Office of the Inspector General in financial audits or other reports.”"}],"tail":"\n"}],"tail":"\n"}],"tail":"\n"}],"tail":null}
