{"tag":"section","attrib":{"id":"id9a785052-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s5321"},"text":null,"children":[{"tag":"num","attrib":{"value":"5321"},"text":"§ 5321.","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Suspension of requirements for disaster areas","children":[],"tail":null},{"tag":"content","attrib":{},"text":"\n","children":[{"tag":"p","attrib":{},"text":"For funds designated under this chapter by a recipient to address the damage in an area for which the President has declared a major disaster, the Secretary may suspend all requirements for purposes of assistance under ","children":[{"tag":"ref","attrib":{"href":"/us/usc/t42/s5306"},"text":"section 5306 of this title","children":[],"tail":" for that area, except for those related to public notice of funding availability, nondiscrimination, fair housing, labor standards, environmental standards, and requirements that activities benefit persons of low- and moderate-income."}],"tail":"\n"}],"tail":null},{"tag":"sourceCredit","attrib":{"id":"id9a785053-86b3-11f1-9949-c831ab2bbedc"},"text":"(","children":[{"tag":"ref","attrib":{"href":"/us/pl/93/383/tI/s122"},"text":"Pub. L. 93–383, title I, § 122","children":[],"tail":", as added "},{"tag":"ref","attrib":{"href":"/us/pl/103/233/tII/s234"},"text":"Pub. L. 103–233, title II, § 234","children":[],"tail":", "},{"tag":"date","attrib":{"date":"1994-04-11"},"text":"Apr. 11, 1994","children":[],"tail":", "},{"tag":"ref","attrib":{"href":"/us/stat/108/369"},"text":"108 Stat. 369","children":[],"tail":"; amended "},{"tag":"ref","attrib":{"href":"/us/pl/119/101/tV/s504/d/3"},"text":"Pub. L. 119–101, title V, § 504(d)(3)","children":[],"tail":", "},{"tag":"date","attrib":{"date":"2026-07-11"},"text":"July 11, 2026","children":[],"tail":", "},{"tag":"ref","attrib":{"href":"/us/stat/140/933"},"text":"140 Stat. 933","children":[],"tail":".)"}],"tail":"\n"},{"tag":"notes","attrib":{"type":"uscNote","id":"id9a785054-86b3-11f1-9949-c831ab2bbedc"},"text":"\n","children":[{"tag":"note","attrib":{"role":"crossHeading","topic":"editorialNotes","id":"id9a785055-86b3-11f1-9949-c831ab2bbedc"},"text":null,"children":[{"tag":"heading","attrib":{},"text":null,"children":[{"tag":"b","attrib":{},"text":"Editorial Notes","children":[],"tail":null}],"tail":null}],"tail":"\n"},{"tag":"note","attrib":{"topic":"referencesInText","id":"id9a785056-86b3-11f1-9949-c831ab2bbedc"},"text":"\n","children":[{"tag":"heading","attrib":{},"text":"References in Text","children":[],"tail":null},{"tag":"p","attrib":{},"text":"This chapter, referred to in text, was in the original “this title”, meaning title I of ","children":[{"tag":"ref","attrib":{"href":"/us/pl/93/383"},"text":"Pub. L. 93–383","children":[],"tail":", "},{"tag":"date","attrib":{"date":"1974-08-22"},"text":"Aug. 22, 1974","children":[],"tail":", "},{"tag":"ref","attrib":{"href":"/us/stat/88/633"},"text":"88 Stat. 633","children":[],"tail":", which is classified principally to this chapter. For complete classification of title I to the Code, see Tables."}],"tail":"\n"}],"tail":"\n"},{"tag":"note","attrib":{"topic":"amendments","id":"id9a785057-86b3-11f1-9949-c831ab2bbedc"},"text":null,"children":[{"tag":"heading","attrib":{},"text":"Amendments","children":[],"tail":null},{"tag":"p","attrib":{},"text":"2026—","children":[{"tag":"ref","attrib":{"href":"/us/pl/119/101"},"text":"Pub. L. 119–101","children":[],"tail":" substituted “major disaster” for “disaster under title IV of the Robert T. Stafford Disaster Relief and Emergency Assistance Act”."}],"tail":"\n"}],"tail":"\n"},{"tag":"note","attrib":{"role":"crossHeading","topic":"statutoryNotes","id":"id9a785058-86b3-11f1-9949-c831ab2bbedc"},"text":null,"children":[{"tag":"heading","attrib":{},"text":null,"children":[{"tag":"b","attrib":{},"text":"Statutory Notes and Related Subsidiaries","children":[],"tail":null}],"tail":null}],"tail":"\n"},{"tag":"note","attrib":{"topic":"effectiveDate","id":"id9a785059-86b3-11f1-9949-c831ab2bbedc"},"text":null,"children":[{"tag":"heading","attrib":{},"text":"Effective Date","children":[],"tail":null},{"tag":"p","attrib":{},"text":"Section applicable with respect to any amounts made available to carry out subchapter II (§ 12721 et seq.) of chapter 130 of this title after ","children":[{"tag":"date","attrib":{"date":"1994-04-11"},"text":"Apr. 11, 1994","children":[],"tail":", and any amounts made available to carry out that subchapter before that date that remain uncommitted on that date, with Secretary to issue any regulations necessary to carry out this section not later than end of 45-day period beginning on that date, see "},{"tag":"ref","attrib":{"href":"/us/pl/103/233/s209"},"text":"section 209 of Pub. L. 103–233","children":[],"tail":", set out as an Effective Date of 1994 Amendment note under "},{"tag":"ref","attrib":{"href":"/us/usc/t42/s5301"},"text":"section 5301 of this title","children":[],"tail":"."}],"tail":"\n"}],"tail":"\n"}],"tail":"\n"}],"tail":null}
