{"tag":"section","attrib":{"id":"id9891de0d-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s1490v"},"text":null,"children":[{"tag":"num","attrib":{"value":"1490v"},"text":"§ 1490v.","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Annual report","children":[],"tail":null},{"tag":"subsection","attrib":{"id":"id9891de0e-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s1490v/a"},"text":null,"children":[{"tag":"num","attrib":{"value":"a"},"text":"(a)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" In general","children":[],"tail":null},{"tag":"chapeau","attrib":{},"text":"The Secretary shall submit to the appropriate committees of Congress and publish on the website of the Department of Agriculture an annual report on rural housing programs carried out under this subchapter, which shall include significant details on the health of Rural Housing Service programs, including—","children":[],"tail":null},{"tag":"paragraph","attrib":{"id":"id9891de0f-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s1490v/a/1"},"text":null,"children":[{"tag":"num","attrib":{"value":"1"},"text":"(1)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" raw data sortable by programs and by region regarding loan performance;","children":[],"tail":"\n"}],"tail":"\n"},{"tag":"paragraph","attrib":{"id":"id9891de10-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s1490v/a/2"},"text":null,"children":[{"tag":"num","attrib":{"value":"2"},"text":"(2)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" the housing stock of those programs, including information on why properties end participation in those programs, such as for maturation, prepayment, foreclosure, or other servicing issues; and","children":[],"tail":"\n"}],"tail":"\n"},{"tag":"paragraph","attrib":{"id":"id9891de11-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s1490v/a/3"},"text":null,"children":[{"tag":"num","attrib":{"value":"3"},"text":"(3)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" risk ratings for properties assisted under those programs.","children":[],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"subsection","attrib":{"id":"id9891de12-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s1490v/b"},"text":null,"children":[{"tag":"num","attrib":{"value":"b"},"text":"(b)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Protection of information","children":[],"tail":null},{"tag":"content","attrib":{},"text":null,"children":[{"tag":"p","attrib":{},"text":"The data included in each report required under subsection (a) may be aggregated or anonymized to protect participant financial or personal information.","children":[],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"sourceCredit","attrib":{"id":"id9891de13-86b3-11f1-9949-c831ab2bbedc"},"text":"(","children":[{"tag":"ref","attrib":{"href":"/us/act/1949-07-15/ch338"},"text":"July 15, 1949, ch. 338","children":[],"tail":", title V, § 546, as added "},{"tag":"ref","attrib":{"href":"/us/pl/119/101/tV/s502/i"},"text":"Pub. L. 119–101, title V, § 502(i)","children":[],"tail":", "},{"tag":"date","attrib":{"date":"2026-07-11"},"text":"July 11, 2026","children":[],"tail":", "},{"tag":"ref","attrib":{"href":"/us/stat/140/924"},"text":"140 Stat. 924","children":[],"tail":".)"}],"tail":"\n"}],"tail":null}
