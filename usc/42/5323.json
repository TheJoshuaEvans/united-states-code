{"tag":"section","attrib":{"id":"id9a785062-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s5323"},"text":null,"children":[{"tag":"num","attrib":{"value":"5323"},"text":"§ 5323.","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Preservation and reinvestment for community enhancement","children":[],"tail":null},{"tag":"subsection","attrib":{"id":"id9a785063-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s5323/a"},"text":null,"children":[{"tag":"num","attrib":{"value":"a"},"text":"(a)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Definitions","children":[],"tail":null},{"tag":"chapeau","attrib":{},"text":"In this section:","children":[],"tail":null},{"tag":"paragraph","attrib":{"id":"id9a785064-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s5323/a/1"},"text":null,"children":[{"tag":"num","attrib":{"value":"1"},"text":"(1)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Community development financial institution","children":[],"tail":null},{"tag":"content","attrib":{},"text":null,"children":[{"tag":"p","attrib":{},"text":"The term “community development financial institution” means an institution that has been certified as a community development financial institution (as defined in ","children":[{"tag":"ref","attrib":{"href":"/us/usc/t12/s4702"},"text":"section 4702 of title 12","children":[],"tail":") by the Secretary of the Treasury."}],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"paragraph","attrib":{"id":"id9a785065-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s5323/a/2"},"text":null,"children":[{"tag":"num","attrib":{"value":"2"},"text":"(2)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Eligible manufactured housing community","children":[],"tail":null},{"tag":"chapeau","attrib":{},"text":"The term “eligible manufactured housing community” means a manufactured housing community that—","children":[],"tail":null},{"tag":"subparagraph","attrib":{"id":"id9a785066-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s5323/a/2/A"},"text":null,"children":[{"tag":"num","attrib":{"value":"A"},"text":"(A)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" is affordable to low- and moderate-income persons, as determined by the Secretary, but not more than 120 percent of the area median income; and","children":[],"tail":"\n"}],"tail":"\n"},{"tag":"subparagraph","attrib":{"id":"id9a785067-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s5323/a/2/B"},"text":null,"children":[{"tag":"num","attrib":{"value":"B"},"text":"(B)","children":[],"tail":null},{"tag":"clause","attrib":{"id":"id9a785068-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s5323/a/2/B/i"},"text":null,"children":[{"tag":"num","attrib":{"value":"i"},"text":"(i)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" is owned by the residents of the manufactured housing community through a resident-controlled entity such as a resident-owned cooperative; or","children":[],"tail":"\n"}],"tail":"\n"},{"tag":"clause","attrib":{"id":"id9a785069-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s5323/a/2/B/ii"},"text":null,"children":[{"tag":"num","attrib":{"value":"ii"},"text":"(ii)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" will be maintained as such a community, and remain affordable for low- and moderate-income persons, to the maximum extent practicable and for the longest period feasible.","children":[],"tail":"\n"}],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"paragraph","attrib":{"id":"id9a78506a-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s5323/a/3"},"text":null,"children":[{"tag":"num","attrib":{"value":"3"},"text":"(3)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Eligible recipient","children":[],"tail":null},{"tag":"chapeau","attrib":{},"text":"The term “eligible recipient” means—","children":[],"tail":null},{"tag":"subparagraph","attrib":{"id":"id9a78506b-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s5323/a/3/A"},"text":null,"children":[{"tag":"num","attrib":{"value":"A"},"text":"(A)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" an eligible manufactured housing community;","children":[],"tail":"\n"}],"tail":"\n"},{"tag":"subparagraph","attrib":{"id":"id9a78506c-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s5323/a/3/B"},"text":null,"children":[{"tag":"num","attrib":{"value":"B"},"text":"(B)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" a unit of general local government;","children":[],"tail":"\n"}],"tail":"\n"},{"tag":"subparagraph","attrib":{"id":"id9a78506d-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s5323/a/3/C"},"text":null,"children":[{"tag":"num","attrib":{"value":"C"},"text":"(C)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" a housing authority;","children":[],"tail":"\n"}],"tail":"\n"},{"tag":"subparagraph","attrib":{"id":"id9a78506e-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s5323/a/3/D"},"text":null,"children":[{"tag":"num","attrib":{"value":"D"},"text":"(D)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" a resident-owned community;","children":[],"tail":"\n"}],"tail":"\n"},{"tag":"subparagraph","attrib":{"id":"id9a78506f-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s5323/a/3/E"},"text":null,"children":[{"tag":"num","attrib":{"value":"E"},"text":"(E)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" a resident-owned cooperative;","children":[],"tail":"\n"}],"tail":"\n"},{"tag":"subparagraph","attrib":{"id":"id9a785070-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s5323/a/3/F"},"text":null,"children":[{"tag":"num","attrib":{"value":"F"},"text":"(F)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" a nonprofit entity with housing expertise or a consortium of such entities;","children":[],"tail":"\n"}],"tail":"\n"},{"tag":"subparagraph","attrib":{"id":"id9a785071-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s5323/a/3/G"},"text":null,"children":[{"tag":"num","attrib":{"value":"G"},"text":"(G)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" a community development financial institution;","children":[],"tail":"\n"}],"tail":"\n"},{"tag":"subparagraph","attrib":{"id":"id9a785072-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s5323/a/3/H"},"text":null,"children":[{"tag":"num","attrib":{"value":"H"},"text":"(H)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" an Indian tribe;","children":[],"tail":"\n"}],"tail":"\n"},{"tag":"subparagraph","attrib":{"id":"id9a785073-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s5323/a/3/I"},"text":null,"children":[{"tag":"num","attrib":{"value":"I"},"text":"(I)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" a tribally designated housing entity;","children":[],"tail":"\n"}],"tail":"\n"},{"tag":"subparagraph","attrib":{"id":"id9a785074-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s5323/a/3/J"},"text":null,"children":[{"tag":"num","attrib":{"value":"J"},"text":"(J)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" the Department of Hawaiian Home Lands;","children":[],"tail":"\n"}],"tail":"\n"},{"tag":"subparagraph","attrib":{"id":"id9a785075-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s5323/a/3/K"},"text":null,"children":[{"tag":"num","attrib":{"value":"K"},"text":"(K)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" a State; or","children":[],"tail":"\n"}],"tail":"\n"},{"tag":"subparagraph","attrib":{"id":"id9a785076-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s5323/a/3/L"},"text":null,"children":[{"tag":"num","attrib":{"value":"L"},"text":"(L)","children":[],"tail":null},{"tag":"chapeau","attrib":{},"text":" any other entity that is—","children":[],"tail":null},{"tag":"clause","attrib":{"id":"id9a785077-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s5323/a/3/L/i"},"text":null,"children":[{"tag":"num","attrib":{"value":"i"},"text":"(i)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" an owner-operator of an eligible manufactured housing community; and","children":[],"tail":"\n"}],"tail":"\n"},{"tag":"clause","attrib":{"id":"id9a785078-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s5323/a/3/L/ii"},"text":null,"children":[{"tag":"num","attrib":{"value":"ii"},"text":"(ii)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" working with an eligible manufactured housing community.","children":[],"tail":"\n"}],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"paragraph","attrib":{"id":"id9a785079-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s5323/a/4"},"text":null,"children":[{"tag":"num","attrib":{"value":"4"},"text":"(4)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Indian tribe","children":[],"tail":null},{"tag":"content","attrib":{},"text":null,"children":[{"tag":"p","attrib":{},"text":"The term “Indian tribe” has the meaning given the term “Indian tribe” in ","children":[{"tag":"ref","attrib":{"href":"/us/usc/t25/s4103"},"text":"section 4103 of title 25","children":[],"tail":"."}],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"paragraph","attrib":{"id":"id9a78507a-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s5323/a/5"},"text":null,"children":[{"tag":"num","attrib":{"value":"5"},"text":"(5)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Manufactured housing community","children":[],"tail":null},{"tag":"chapeau","attrib":{},"text":"The term “manufactured housing community” means—","children":[],"tail":null},{"tag":"subparagraph","attrib":{"id":"id9a78507b-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s5323/a/5/A"},"text":null,"children":[{"tag":"num","attrib":{"value":"A"},"text":"(A)","children":[],"tail":null},{"tag":"chapeau","attrib":{},"text":" any community, court, park, or other land under unified ownership developed and accommodating, or equipped to accommodate, the placement of manufactured homes, where—","children":[],"tail":null},{"tag":"clause","attrib":{"id":"id9a78507c-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s5323/a/5/A/i"},"text":null,"children":[{"tag":"num","attrib":{"value":"i"},"text":"(i)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" spaces within such community are or will be primarily used for residential occupancy;","children":[],"tail":"\n"}],"tail":"\n"},{"tag":"clause","attrib":{"id":"id9a78507d-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s5323/a/5/A/ii"},"text":null,"children":[{"tag":"num","attrib":{"value":"ii"},"text":"(ii)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" all homes within the community are used for permanent occupancy; and","children":[],"tail":"\n"}],"tail":"\n"},{"tag":"clause","attrib":{"id":"id9a78507e-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s5323/a/5/A/iii"},"text":null,"children":[{"tag":"num","attrib":{"value":"iii"},"text":"(iii)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" a majority of such occupied spaces within the community are occupied by manufactured homes, which may include homes constructed prior to enactment of the Manufactured Home Construction and Safety Standards; or","children":[],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"subparagraph","attrib":{"id":"id9a78507f-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s5323/a/5/B"},"text":null,"children":[{"tag":"num","attrib":{"value":"B"},"text":"(B)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" any community that meets the definition of manufactured housing community used for programs similar to the program under this section.","children":[],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"paragraph","attrib":{"id":"id9a785080-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s5323/a/6"},"text":null,"children":[{"tag":"num","attrib":{"value":"6"},"text":"(6)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Resident health, safety, and accessibility activities","children":[],"tail":null},{"tag":"chapeau","attrib":{},"text":"The term “resident health, safety, and accessibility activities” means the reconstruction, repair, or replacement of manufactured housing and manufactured housing communities to—","children":[],"tail":null},{"tag":"subparagraph","attrib":{"id":"id9a785081-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s5323/a/6/A"},"text":null,"children":[{"tag":"num","attrib":{"value":"A"},"text":"(A)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" protect the health and safety of residents;","children":[],"tail":"\n"}],"tail":"\n"},{"tag":"subparagraph","attrib":{"id":"id9a785082-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s5323/a/6/B"},"text":null,"children":[{"tag":"num","attrib":{"value":"B"},"text":"(B)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" address weatherization and reduce utility costs; or","children":[],"tail":"\n"}],"tail":"\n"},{"tag":"subparagraph","attrib":{"id":"id9a785083-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s5323/a/6/C"},"text":null,"children":[{"tag":"num","attrib":{"value":"C"},"text":"(C)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" address accessibility needs for residents with disabilities.","children":[],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"paragraph","attrib":{"id":"id9a785084-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s5323/a/7"},"text":null,"children":[{"tag":"num","attrib":{"value":"7"},"text":"(7)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Tribally designated housing entity","children":[],"tail":null},{"tag":"content","attrib":{},"text":null,"children":[{"tag":"p","attrib":{},"text":"The term “tribally designated housing entity” has the meaning given the term in ","children":[{"tag":"ref","attrib":{"href":"/us/usc/t25/s4103"},"text":"section 4103 of title 25","children":[],"tail":"."}],"tail":"\n"}],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"subsection","attrib":{"id":"id9a785085-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s5323/b"},"text":null,"children":[{"tag":"num","attrib":{"value":"b"},"text":"(b)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Establishment","children":[],"tail":null},{"tag":"content","attrib":{},"text":null,"children":[{"tag":"p","attrib":{},"text":"There is authorized a competitive grant program that the Secretary shall, by notice, carry out to make awards utilizing funds appropriated for such purpose to eligible recipients to carry out eligible projects for development of or improvements to eligible manufactured housing communities.","children":[],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"subsection","attrib":{"id":"id9a785086-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s5323/c"},"text":null,"children":[{"tag":"num","attrib":{"value":"c"},"text":"(c)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Eligible projects","children":[],"tail":null},{"tag":"paragraph","attrib":{"id":"id9a785087-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s5323/c/1"},"text":null,"children":[{"tag":"num","attrib":{"value":"1"},"text":"(1)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" In general","children":[],"tail":null},{"tag":"chapeau","attrib":{},"text":"Amounts from grants under this section may be used for—","children":[],"tail":null},{"tag":"subparagraph","attrib":{"id":"id9a785088-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s5323/c/1/A"},"text":null,"children":[{"tag":"num","attrib":{"value":"A"},"text":"(A)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" community infrastructure, facilities, utilities, and other land improvements in or serving an eligible manufactured housing community;","children":[],"tail":"\n"}],"tail":"\n"},{"tag":"subparagraph","attrib":{"id":"id9a785089-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s5323/c/1/B"},"text":null,"children":[{"tag":"num","attrib":{"value":"B"},"text":"(B)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" reconstruction or repair of existing housing within an eligible manufactured housing community;","children":[],"tail":"\n"}],"tail":"\n"},{"tag":"subparagraph","attrib":{"id":"id9a78508a-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s5323/c/1/C"},"text":null,"children":[{"tag":"num","attrib":{"value":"C"},"text":"(C)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" replacement of homes within an eligible manufactured housing community;","children":[],"tail":"\n"}],"tail":"\n"},{"tag":"subparagraph","attrib":{"id":"id9a78508b-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s5323/c/1/D"},"text":null,"children":[{"tag":"num","attrib":{"value":"D"},"text":"(D)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" planning;","children":[],"tail":"\n"}],"tail":"\n"},{"tag":"subparagraph","attrib":{"id":"id9a78508c-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s5323/c/1/E"},"text":null,"children":[{"tag":"num","attrib":{"value":"E"},"text":"(E)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" resident health, safety, and accessibility activities in homes in an eligible manufactured housing community;","children":[],"tail":"\n"}],"tail":"\n"},{"tag":"subparagraph","attrib":{"id":"id9a78508d-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s5323/c/1/F"},"text":null,"children":[{"tag":"num","attrib":{"value":"F"},"text":"(F)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" land and site acquisition and infrastructure for expansion or construction of an eligible manufactured housing community;","children":[],"tail":"\n"}],"tail":"\n"},{"tag":"subparagraph","attrib":{"id":"id9a78508e-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s5323/c/1/G"},"text":null,"children":[{"tag":"num","attrib":{"value":"G"},"text":"(G)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" resident and community services, including relocation assistance, eviction prevention, and down payment assistance; and","children":[],"tail":"\n"}],"tail":"\n"},{"tag":"subparagraph","attrib":{"id":"id9a78508f-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s5323/c/1/H"},"text":null,"children":[{"tag":"num","attrib":{"value":"H"},"text":"(H)","children":[],"tail":null},{"tag":"chapeau","attrib":{},"text":" any other activity that—","children":[],"tail":null},{"tag":"clause","attrib":{"id":"id9a785090-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s5323/c/1/H/i"},"text":null,"children":[{"tag":"num","attrib":{"value":"i"},"text":"(i)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" is approved by the Secretary consistent with the requirements under this section;","children":[],"tail":"\n"}],"tail":"\n"},{"tag":"clause","attrib":{"id":"id9a785091-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s5323/c/1/H/ii"},"text":null,"children":[{"tag":"num","attrib":{"value":"ii"},"text":"(ii)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" improves the overall living conditions of an eligible manufactured housing community, which may include the addition or enhancement of shared spaces such as community centers, recreational areas, or other facilities that support resident well-being and community engagement; and","children":[],"tail":"\n"}],"tail":"\n"},{"tag":"clause","attrib":{"id":"id9a785092-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s5323/c/1/H/iii"},"text":null,"children":[{"tag":"num","attrib":{"value":"iii"},"text":"(iii)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" is necessary to protect the health and safety of the residents of the eligible manufactured housing community and the long-term affordability and sustainability of the community.","children":[],"tail":"\n"}],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"paragraph","attrib":{"id":"id9a785093-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s5323/c/2"},"text":null,"children":[{"tag":"num","attrib":{"value":"2"},"text":"(2)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Replacement","children":[],"tail":null},{"tag":"chapeau","attrib":{},"text":"For purposes of subparagraphs (B) and (C) of paragraph (1), grants under this section—","children":[],"tail":null},{"tag":"subparagraph","attrib":{"id":"id9a785094-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s5323/c/2/A"},"text":null,"children":[{"tag":"num","attrib":{"value":"A"},"text":"(A)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" may not be used for rehabilitation or modernization of units that were built before ","children":[{"tag":"date","attrib":{"date":"1976-06-15"},"text":"June 15, 1976","children":[],"tail":"; and"}],"tail":"\n"}],"tail":"\n"},{"tag":"subparagraph","attrib":{"id":"id9a785095-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s5323/c/2/B"},"text":null,"children":[{"tag":"num","attrib":{"value":"B"},"text":"(B)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" may only be used for disposition and replacement of units described in subparagraph (A), provided that any replacement housing complies with the Manufactured Home Construction and Safety Standards or is another allowed type of home, as determined by the Secretary.","children":[],"tail":"\n"}],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"subsection","attrib":{"id":"id9a785096-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s5323/d"},"text":null,"children":[{"tag":"num","attrib":{"value":"d"},"text":"(d)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Priority","children":[],"tail":null},{"tag":"content","attrib":{},"text":null,"children":[{"tag":"p","attrib":{},"text":"In awarding grants under this section, the Secretary shall prioritize applicants that will carry out activities that primarily benefit low- and moderate-income residents and preserve long-term housing affordability for residents of eligible manufactured housing communities.","children":[],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"subsection","attrib":{"id":"id9a785097-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s5323/e"},"text":null,"children":[{"tag":"num","attrib":{"value":"e"},"text":"(e)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Waivers","children":[],"tail":null},{"tag":"content","attrib":{},"text":null,"children":[{"tag":"p","attrib":{},"text":"The Secretary may waive or specify alternative requirements for any provision of law or regulation that the Secretary administers in connection with use of amounts made available under this section other than requirements related to fair housing, nondiscrimination, labor standards, and the environment, upon a finding that the waiver or alternative requirement is not inconsistent with the overall purposes of this section and that the waiver or alternative requirement is necessary to facilitate the use of amounts made available under this section.","children":[],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"subsection","attrib":{"id":"id9a785098-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s5323/f"},"text":null,"children":[{"tag":"num","attrib":{"value":"f"},"text":"(f)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Implementation","children":[],"tail":null},{"tag":"paragraph","attrib":{"id":"id9a785099-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s5323/f/1"},"text":null,"children":[{"tag":"num","attrib":{"value":"1"},"text":"(1)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" In general","children":[],"tail":null},{"tag":"content","attrib":{},"text":null,"children":[{"tag":"p","attrib":{},"text":"Any grant made under this section shall be made pursuant to criteria for selection of recipients of such grants that the Secretary shall by regulation establish and publish together with any notification of availability of amounts under this section.","children":[],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"paragraph","attrib":{"id":"id9a78509a-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s5323/f/2"},"text":null,"children":[{"tag":"num","attrib":{"value":"2"},"text":"(2)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Set-aside of grant amounts","children":[],"tail":null},{"tag":"content","attrib":{},"text":null,"children":[{"tag":"p","attrib":{},"text":"The Secretary may set aside amounts provided under this section for grants to Indian tribes, tribally designated housing entities, and the Department of Hawaiian Home Lands.","children":[],"tail":"\n"}],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"subsection","attrib":{"id":"id9a78509b-86b3-11f1-9949-c831ab2bbedc","identifier":"/us/usc/t42/s5323/g"},"text":null,"children":[{"tag":"num","attrib":{"value":"g"},"text":"(g)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Sunset","children":[],"tail":null},{"tag":"content","attrib":{},"text":null,"children":[{"tag":"p","attrib":{},"text":"The program established under this section shall terminate on the date that is 7 years after ","children":[{"tag":"date","attrib":{"date":"2026-07-11"},"text":"July 11, 2026","children":[],"tail":"."}],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"sourceCredit","attrib":{"id":"id9a78509c-86b3-11f1-9949-c831ab2bbedc"},"text":"(","children":[{"tag":"ref","attrib":{"href":"/us/pl/93/383/tI/s123"},"text":"Pub. L. 93–383, title I, § 123","children":[],"tail":", as added "},{"tag":"ref","attrib":{"href":"/us/pl/119/101/tIII/s304/a/2"},"text":"Pub. L. 119–101, title III, § 304(a)(2)","children":[],"tail":", "},{"tag":"date","attrib":{"date":"2026-07-11"},"text":"July 11, 2026","children":[],"tail":", "},{"tag":"ref","attrib":{"href":"/us/stat/140/894"},"text":"140 Stat. 894","children":[],"tail":".)"}],"tail":"\n"},{"tag":"notes","attrib":{"type":"uscNote","id":"id9a78509d-86b3-11f1-9949-c831ab2bbedc"},"text":"\n","children":[{"tag":"note","attrib":{"role":"crossHeading","topic":"statutoryNotes","id":"id9a78509e-86b3-11f1-9949-c831ab2bbedc"},"text":null,"children":[{"tag":"heading","attrib":{},"text":null,"children":[{"tag":"b","attrib":{},"text":"Statutory Notes and Related Subsidiaries","children":[],"tail":null}],"tail":null}],"tail":"\n"},{"tag":"note","attrib":{"topic":"miscellaneous","id":"id9a78509f-86b3-11f1-9949-c831ab2bbedc"},"text":null,"children":[{"tag":"heading","attrib":{},"text":"Application of Grant Program","children":[],"tail":null},{"tag":"p","attrib":{},"text":null,"children":[{"tag":"ref","attrib":{"href":"/us/pl/119/101/tIII/s304/b"},"text":"Pub. L. 119–101, title III, § 304(b)","children":[],"tail":", "},{"tag":"date","attrib":{"date":"2026-07-11"},"text":"July 11, 2026","children":[],"tail":", "},{"tag":"ref","attrib":{"href":"/us/stat/140/897"},"text":"140 Stat. 897","children":[],"tail":", provided that: "},{"tag":"quotedContent","attrib":{"origin":"/us/pl/119/101/tIII/s304/b"},"text":"“Grants made under section 123 of the Housing and Community Development Act of 1974 [","children":[{"tag":"ref","attrib":{"href":"/us/usc/t42/s5323"},"text":"42 U.S.C. 5323","children":[],"tail":"], as added by subsection (a)[(2)], after the date of enactment of this Act ["},{"tag":"date","attrib":{"date":"2026-07-11"},"text":"July 11, 2026","children":[],"tail":"] shall be carried out using amounts appropriated after the date of enactment of this Act.”"}],"tail":"\n"}],"tail":"\n"}],"tail":"\n"}],"tail":"\n"}],"tail":null}
