{"tag":"section","attrib":{"id":"id0cae0e69-810c-11f1-b7ce-bdea3d14cbdd","identifier":"/us/usc/t16/s760–5"},"text":null,"children":[{"tag":"num","attrib":{"value":"760–5"},"text":"§ 760–5.","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Establishment of fish hatchery at Paint Bank, Virginia","children":[],"tail":null},{"tag":"content","attrib":{},"text":"\n","children":[{"tag":"p","attrib":{},"text":"The Secretary of the Interior is authorized and directed to construct, equip, maintain, and operate a new fish hatchery in the vicinity of Paint Bank, Virginia.","children":[],"tail":"\n"}],"tail":null},{"tag":"sourceCredit","attrib":{"id":"id0cae0e6a-810c-11f1-b7ce-bdea3d14cbdd"},"text":"(","children":[{"tag":"ref","attrib":{"href":"/us/act/1956-08-03/ch943/s1"},"text":"Aug. 3, 1956, ch. 943, § 1","children":[],"tail":", "},{"tag":"ref","attrib":{"href":"/us/stat/70/1020"},"text":"70 Stat. 1020","children":[],"tail":".)"}],"tail":"\n"}],"tail":null}
