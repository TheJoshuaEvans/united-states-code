{"tag":"section","attrib":{"id":"id0cec0282-810c-11f1-b7ce-bdea3d14cbdd","identifier":"/us/usc/t16/s917d"},"text":null,"children":[{"tag":"num","attrib":{"value":"917d"},"text":"§ 917d.","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Authorization of appropriations","children":[],"tail":null},{"tag":"content","attrib":{},"text":"\n","children":[{"tag":"p","attrib":{},"text":"For the purpose of carrying out the provisions of this chapter, there is hereby authorized to be appropriated a sum not to exceed $1,000,000 for fiscal years 1978 and 1979.","children":[],"tail":"\n"}],"tail":null},{"tag":"sourceCredit","attrib":{"id":"id0cec0283-810c-11f1-b7ce-bdea3d14cbdd"},"text":"(","children":[{"tag":"ref","attrib":{"href":"/us/pl/94/532/s6"},"text":"Pub. L. 94–532, § 6","children":[],"tail":", "},{"tag":"date","attrib":{"date":"1976-10-17"},"text":"Oct. 17, 1976","children":[],"tail":", "},{"tag":"ref","attrib":{"href":"/us/stat/90/2492"},"text":"90 Stat. 2492","children":[],"tail":".)"}],"tail":"\n"}],"tail":null}
