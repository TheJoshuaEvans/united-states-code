{"tag":"section","attrib":{"id":"id0b69cec1-810c-11f1-b7ce-bdea3d14cbdd","identifier":"/us/usc/t16/s365"},"text":null,"children":[{"tag":"num","attrib":{"value":"365"},"text":"§ 365.","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Taxation, under State laws","children":[],"tail":null},{"tag":"content","attrib":{},"text":"\n","children":[{"tag":"p","attrib":{},"text":"The consent of the United States is given for the taxation, under the authority of the laws of the State of Arkansas applicable to the equal taxation of personal property in that State, as personal property of all structures and other property in private ownership on the Hot Springs National Park.","children":[],"tail":"\n"}],"tail":null},{"tag":"sourceCredit","attrib":{"id":"id0b69cec2-810c-11f1-b7ce-bdea3d14cbdd"},"text":"(","children":[{"tag":"ref","attrib":{"href":"/us/act/1891-03-03/ch533/s5"},"text":"Mar. 3, 1891, ch. 533, § 5","children":[],"tail":", "},{"tag":"ref","attrib":{"href":"/us/stat/26/844"},"text":"26 Stat. 844","children":[],"tail":"; "},{"tag":"ref","attrib":{"href":"/us/act/1921-03-04/ch161/s1"},"text":"Mar. 4, 1921, ch. 161, § 1","children":[],"tail":", "},{"tag":"ref","attrib":{"href":"/us/stat/41/1407"},"text":"41 Stat. 1407","children":[],"tail":".)"}],"tail":"\n"},{"tag":"notes","attrib":{"type":"uscNote","id":"id0b69cec3-810c-11f1-b7ce-bdea3d14cbdd"},"text":"\n","children":[{"tag":"note","attrib":{"role":"crossHeading","topic":"statutoryNotes","id":"id0b69cec4-810c-11f1-b7ce-bdea3d14cbdd"},"text":null,"children":[{"tag":"heading","attrib":{},"text":null,"children":[{"tag":"b","attrib":{},"text":"Statutory Notes and Related Subsidiaries","children":[],"tail":null}],"tail":null}],"tail":"\n"},{"tag":"note","attrib":{"topic":"changeOfName","id":"id0b69cec5-810c-11f1-b7ce-bdea3d14cbdd"},"text":"\n","children":[{"tag":"heading","attrib":{},"text":"Change of Name","children":[],"tail":"\n"},{"tag":"p","attrib":{},"text":"“Hot Springs National Park” substituted in text for “Hot Springs Reservation” pursuant to act ","children":[{"tag":"date","attrib":{"date":"1921-03-04"},"text":"Mar. 4, 1921","children":[],"tail":"."}],"tail":"\n"}],"tail":"\n"}],"tail":"\n"}],"tail":null}
