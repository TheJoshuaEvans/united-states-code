{"tag":"section","attrib":{"id":"id0bc92c86-810c-11f1-b7ce-bdea3d14cbdd","identifier":"/us/usc/t16/s430b"},"text":null,"children":[{"tag":"num","attrib":{"value":"430b"},"text":"§ 430b.","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Control; regulations for care and management","children":[],"tail":null},{"tag":"content","attrib":{},"text":"\n","children":[{"tag":"p","attrib":{},"text":"Such park shall be under the control and direction of the Secretary of the Interior. The Secretary is authorized to prescribe from time to time such regulations for the care and management of such park as he may deem necessary.","children":[],"tail":"\n"}],"tail":null},{"tag":"sourceCredit","attrib":{"id":"id0bc92c87-810c-11f1-b7ce-bdea3d14cbdd"},"text":"(","children":[{"tag":"ref","attrib":{"href":"/us/act/1931-03-03/ch437/s3"},"text":"Mar. 3, 1931, ch. 437, § 3","children":[],"tail":", "},{"tag":"ref","attrib":{"href":"/us/stat/46/1508"},"text":"46 Stat. 1508","children":[],"tail":"; Ex. Ord. No. 6166, § 2, "},{"tag":"date","attrib":{"date":"1933-06-10"},"text":"June 10, 1933","children":[],"tail":"; Ex. Ord. No. 6228, § 1, "},{"tag":"date","attrib":{"date":"1933-07-28"},"text":"July 28, 1933","children":[],"tail":".)"}],"tail":"\n"},{"tag":"notes","attrib":{"type":"uscNote","id":"id0bc92c88-810c-11f1-b7ce-bdea3d14cbdd"},"text":"\n","children":[{"tag":"note","attrib":{"role":"crossHeading","topic":"execDoc","id":"id0bc92c89-810c-11f1-b7ce-bdea3d14cbdd"},"text":null,"children":[{"tag":"heading","attrib":{},"text":null,"children":[{"tag":"b","attrib":{},"text":"Executive Documents","children":[],"tail":null}],"tail":null}],"tail":"\n"},{"tag":"note","attrib":{"topic":"transferOfFunctions","id":"id0bc92c8a-810c-11f1-b7ce-bdea3d14cbdd"},"text":"\n","children":[{"tag":"heading","attrib":{},"text":"Transfer of Functions","children":[],"tail":"\n"},{"tag":"p","attrib":{},"text":"Transfer of administrative functions of park, see note set out under ","children":[{"tag":"ref","attrib":{"href":"/us/usc/t16/s430a"},"text":"section 430a of this title","children":[],"tail":"."}],"tail":"\n"}],"tail":"\n"}],"tail":"\n"}],"tail":null}
