{"tag":"section","attrib":{"id":"id39e4bb72-3a72-11f1-89e5-b276cb722900","identifier":"/us/usc/t22/s284ee"},"text":null,"children":[{"tag":"num","attrib":{"value":"284ee"},"text":"§ 284ee.","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Twenty-first replenishment","children":[],"tail":null},{"tag":"subsection","attrib":{"id":"id39e4bb73-3a72-11f1-89e5-b276cb722900","identifier":"/us/usc/t22/s284ee/a"},"text":null,"children":[{"tag":"num","attrib":{"value":"a"},"text":"(a)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" In general","children":[],"tail":null},{"tag":"content","attrib":{},"text":null,"children":[{"tag":"p","attrib":{},"text":"The United States Governor of the International Development Association may contribute on behalf of the United States $3,198,552,000 to the twenty-first replenishment of the resources of the Association, subject to obtaining the necessary appropriations.","children":[],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"subsection","attrib":{"id":"id39e4bb74-3a72-11f1-89e5-b276cb722900","identifier":"/us/usc/t22/s284ee/b"},"text":null,"children":[{"tag":"num","attrib":{"value":"b"},"text":"(b)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Authorization of appropriations","children":[],"tail":null},{"tag":"content","attrib":{},"text":null,"children":[{"tag":"p","attrib":{},"text":"In order to pay for the United States contribution provided for in subsection (a), there are authorized to be appropriated, without fiscal year limitation, $3,198,552,000 for payment by the Secretary of the Treasury.","children":[],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"sourceCredit","attrib":{"id":"id39e4bb75-3a72-11f1-89e5-b276cb722900"},"text":"(","children":[{"tag":"ref","attrib":{"href":"/us/pl/86/565/s33"},"text":"Pub. L. 86–565, § 33","children":[],"tail":", as added "},{"tag":"ref","attrib":{"href":"/us/pl/119/75/dF/tVII/s7070/b/1"},"text":"Pub. L. 119–75, div. F, title VII, § 7070(b)(1)","children":[],"tail":", "},{"tag":"date","attrib":{"date":"2026-02-03"},"text":"Feb. 3, 2026","children":[],"tail":", "},{"tag":"ref","attrib":{"href":"/us/stat/140/623"},"text":"140 Stat. 623","children":[],"tail":".)"}],"tail":"\n"},{"tag":"notes","attrib":{"type":"uscNote","id":"id39e4bb76-3a72-11f1-89e5-b276cb722900"},"text":"\n","children":[{"tag":"note","attrib":{"topic":"prospectiveAmendment","id":"id39e4bb77-3a72-11f1-89e5-b276cb722900"},"text":null,"children":[{"tag":"heading","attrib":{},"text":"Termination of Section","children":[],"tail":null},{"tag":"p","attrib":{},"text":"For termination of section by ","children":[{"tag":"ref","attrib":{"href":"/us/pl/119/75/s7070/b/5"},"text":"section 7070(b)(5) of Pub. L. 119–75","children":[],"tail":", see Termination Date note below."}],"tail":"\n"}],"tail":"\n"},{"tag":"note","attrib":{"role":"crossHeading","topic":"statutoryNotes","id":"id39e4bb78-3a72-11f1-89e5-b276cb722900"},"text":null,"children":[{"tag":"heading","attrib":{},"text":null,"children":[{"tag":"b","attrib":{},"text":"Statutory Notes and Related Subsidiaries","children":[],"tail":null}],"tail":null}],"tail":"\n"},{"tag":"note","attrib":{"topic":"terminationDate","id":"id39e4bb79-3a72-11f1-89e5-b276cb722900"},"text":null,"children":[{"tag":"heading","attrib":{},"text":"Termination Date","children":[],"tail":null},{"tag":"p","attrib":{},"text":"Section to have no force or effect beginning 10 years after ","children":[{"tag":"date","attrib":{"date":"2026-02-03"},"text":"Feb. 3, 2026","children":[],"tail":", see "},{"tag":"ref","attrib":{"href":"/us/pl/119/75/s7070/b/5"},"text":"section 7070(b)(5) of Pub. L. 119–75","children":[],"tail":", set out as a note under section 262"},{"tag":"i","attrib":{},"text":"o","children":[],"tail":"–5 of this title."}],"tail":"\n"}],"tail":"\n"}],"tail":"\n"}],"tail":null}
