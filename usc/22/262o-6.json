{"tag":"section","attrib":{"id":"id39c34ff3-3a72-11f1-89e5-b276cb722900","identifier":"/us/usc/t22/s262o–6"},"text":null,"children":[{"tag":"num","attrib":{"value":"262o–6"},"text":"§ 262o–6.","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Establishment of Nuclear Energy Assistance Trust Funds","children":[],"tail":null},{"tag":"subsection","attrib":{"id":"id39c34ff4-3a72-11f1-89e5-b276cb722900","identifier":"/us/usc/t22/s262o–6/a"},"text":null,"children":[{"tag":"num","attrib":{"value":"a"},"text":"(a)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" In general","children":[],"tail":null},{"tag":"content","attrib":{},"text":null,"children":[{"tag":"p","attrib":{},"text":"The Secretary of the Treasury shall instruct the United States Governors of the International Bank for Reconstruction and Development, and, as the Secretary deems appropriate, of other international financial institutions (as defined in ","children":[{"tag":"ref","attrib":{"href":"/us/usc/t22/s262r/c/2"},"text":"section 262r(c)(2) of this title","children":[],"tail":") to use the voice, vote, and influence of the United States to establish at each such institution a trust fund to be known as the “Nuclear Energy Assistance Trust Fund” that meets the requirements of subsections (b) and (c) of this section."}],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"subsection","attrib":{"id":"id39c34ff5-3a72-11f1-89e5-b276cb722900","identifier":"/us/usc/t22/s262o–6/b"},"text":null,"children":[{"tag":"num","attrib":{"value":"b"},"text":"(b)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Purposes","children":[],"tail":null},{"tag":"chapeau","attrib":{},"text":"The purposes of such a trust fund shall be the following:","children":[],"tail":null},{"tag":"paragraph","attrib":{"id":"id39c34ff6-3a72-11f1-89e5-b276cb722900","identifier":"/us/usc/t22/s262o–6/b/1"},"text":null,"children":[{"tag":"num","attrib":{"value":"1"},"text":"(1)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" To provide financial and technical assistance to support the generation, transmission, and distribution of nuclear energy in borrowing countries.","children":[],"tail":"\n"}],"tail":"\n"},{"tag":"paragraph","attrib":{"id":"id39c34ff7-3a72-11f1-89e5-b276cb722900","identifier":"/us/usc/t22/s262o–6/b/2"},"text":null,"children":[{"tag":"num","attrib":{"value":"2"},"text":"(2)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" To ensure that the international financial institution makes financing available on competitive terms, including for the purpose of countering credit extended by the government of a country that is not a member of the OECD Arrangement on Officially Supported Export Credits.","children":[],"tail":"\n"}],"tail":"\n"},{"tag":"paragraph","attrib":{"id":"id39c34ff8-3a72-11f1-89e5-b276cb722900","identifier":"/us/usc/t22/s262o–6/b/3"},"text":null,"children":[{"tag":"num","attrib":{"value":"3"},"text":"(3)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" To exclusively support the adoption of nuclear energy technologies, including small modular reactors, that meet or exceed the quality and safety standards of technologies produced by the United States or a member country of the Organisation for Economic Co-operation and Development.","children":[],"tail":"\n"}],"tail":"\n"},{"tag":"paragraph","attrib":{"id":"id39c34ff9-3a72-11f1-89e5-b276cb722900","identifier":"/us/usc/t22/s262o–6/b/4"},"text":null,"children":[{"tag":"num","attrib":{"value":"4"},"text":"(4)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" To strengthen the capacity of the international financial institution to assess, implement, and evaluate nuclear energy projects.","children":[],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"subsection","attrib":{"id":"id39c34ffa-3a72-11f1-89e5-b276cb722900","identifier":"/us/usc/t22/s262o–6/c"},"text":null,"children":[{"tag":"num","attrib":{"value":"c"},"text":"(c)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Use of trust fund revenues","children":[],"tail":null},{"tag":"content","attrib":{},"text":null,"children":[{"tag":"p","attrib":{},"text":"The revenues of such a trust fund may be made available for activities for the purposes described in subsection (b), or the United States share of the revenues may be remitted to the general fund of the Treasury, as the Secretary finds appropriate.","children":[],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"subsection","attrib":{"id":"id39c34ffb-3a72-11f1-89e5-b276cb722900","identifier":"/us/usc/t22/s262o–6/d"},"text":null,"children":[{"tag":"num","attrib":{"value":"d"},"text":"(d)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Rule of interpretation","children":[],"tail":null},{"tag":"content","attrib":{},"text":null,"children":[{"tag":"p","attrib":{},"text":"This section shall not be interpreted to affect the ability of the United States Governor of, or the United States Executive Director at, an international financial institution (as so defined) to encourage the provision of financial or technical assistance from non-trust fund resources of the institution to support the generation or distribution of nuclear energy.","children":[],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"sourceCredit","attrib":{"id":"id39c34ffc-3a72-11f1-89e5-b276cb722900"},"text":"(","children":[{"tag":"ref","attrib":{"href":"/us/pl/95/118/tXV/s1507"},"text":"Pub. L. 95–118, title XV, § 1507","children":[],"tail":", as added "},{"tag":"ref","attrib":{"href":"/us/pl/119/75/dF/tVII/s7070/b/3"},"text":"Pub. L. 119–75, div. F, title VII, § 7070(b)(3)","children":[],"tail":", "},{"tag":"date","attrib":{"date":"2026-02-03"},"text":"Feb. 3, 2026","children":[],"tail":", "},{"tag":"ref","attrib":{"href":"/us/stat/140/624"},"text":"140 Stat. 624","children":[],"tail":".)"}],"tail":"\n"},{"tag":"notes","attrib":{"type":"uscNote","id":"id39c34ffd-3a72-11f1-89e5-b276cb722900"},"text":"\n","children":[{"tag":"note","attrib":{"topic":"prospectiveAmendment","id":"id39c34ffe-3a72-11f1-89e5-b276cb722900"},"text":null,"children":[{"tag":"heading","attrib":{},"text":"Termination of Section","children":[],"tail":null},{"tag":"p","attrib":{},"text":"For termination of section by ","children":[{"tag":"ref","attrib":{"href":"/us/pl/119/75/s7070/b/5"},"text":"section 7070(b)(5) of Pub. L. 119–75","children":[],"tail":", see Termination Date note below."}],"tail":"\n"}],"tail":"\n"},{"tag":"note","attrib":{"role":"crossHeading","topic":"statutoryNotes","id":"id39c34fff-3a72-11f1-89e5-b276cb722900"},"text":null,"children":[{"tag":"heading","attrib":{},"text":null,"children":[{"tag":"b","attrib":{},"text":"Statutory Notes and Related Subsidiaries","children":[],"tail":null}],"tail":null}],"tail":"\n"},{"tag":"note","attrib":{"topic":"terminationDate","id":"id39c35000-3a72-11f1-89e5-b276cb722900"},"text":null,"children":[{"tag":"heading","attrib":{},"text":"Termination Date","children":[],"tail":null},{"tag":"p","attrib":{},"text":"Section to have no force or effect beginning 10 years after ","children":[{"tag":"date","attrib":{"date":"2026-02-03"},"text":"Feb. 3, 2026","children":[],"tail":", see "},{"tag":"ref","attrib":{"href":"/us/pl/119/75/s7070/b/5"},"text":"section 7070(b)(5) of Pub. L. 119–75","children":[],"tail":", set out as a note under section 262"},{"tag":"i","attrib":{},"text":"o","children":[],"tail":"–5 of this title."}],"tail":"\n"}],"tail":"\n"}],"tail":"\n"}],"tail":null}
