{"tag":"section","attrib":{"id":"id3a2e958f-3a72-11f1-89e5-b276cb722900","identifier":"/us/usc/t22/s290i–13"},"text":null,"children":[{"tag":"num","attrib":{"value":"290i–13"},"text":"§ 290i–13.","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" General callable capital increase","children":[],"tail":null},{"tag":"subsection","attrib":{"id":"id3a2e9590-3a72-11f1-89e5-b276cb722900","identifier":"/us/usc/t22/s290i–13/a"},"text":null,"children":[{"tag":"num","attrib":{"value":"a"},"text":"(a)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Subscription authorized","children":[],"tail":null},{"tag":"paragraph","attrib":{"id":"id3a2e9591-3a72-11f1-89e5-b276cb722900","identifier":"/us/usc/t22/s290i–13/a/1"},"text":null,"children":[{"tag":"num","attrib":{"value":"1"},"text":"(1)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" In general","children":[],"tail":null},{"tag":"content","attrib":{},"text":null,"children":[{"tag":"p","attrib":{},"text":"The United States Governor of the Bank may subscribe on behalf of the United States to 800,000 additional shares of the capital stock of the Bank.","children":[],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"paragraph","attrib":{"id":"id3a2e9592-3a72-11f1-89e5-b276cb722900","identifier":"/us/usc/t22/s290i–13/a/2"},"text":null,"children":[{"tag":"num","attrib":{"value":"2"},"text":"(2)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Limitation","children":[],"tail":null},{"tag":"content","attrib":{},"text":null,"children":[{"tag":"p","attrib":{},"text":"Any subscription by the United States to the capital stock of the Bank shall be effective only to such extent and in such amounts as are provided in advance in appropriations Acts.","children":[],"tail":"\n"}],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"subsection","attrib":{"id":"id3a2e9593-3a72-11f1-89e5-b276cb722900","identifier":"/us/usc/t22/s290i–13/b"},"text":null,"children":[{"tag":"num","attrib":{"value":"b"},"text":"(b)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Authorization of appropriations","children":[],"tail":null},{"tag":"content","attrib":{},"text":null,"children":[{"tag":"p","attrib":{},"text":"For the increase in the United States subscription to the Bank under subsection (a), there is authorized to be appropriated, without fiscal year limitation, $7,800,000,000, for payment by the Secretary of the Treasury for callable shares of the Bank.","children":[],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"sourceCredit","attrib":{"id":"id3a2e9594-3a72-11f1-89e5-b276cb722900"},"text":"(","children":[{"tag":"ref","attrib":{"href":"/us/pl/97/35/tXIII/s1346"},"text":"Pub. L. 97–35, title XIII, § 1346","children":[],"tail":", as added "},{"tag":"ref","attrib":{"href":"/us/pl/119/75/dF/tVI/s7070/d"},"text":"Pub. L. 119–75, div. F, title VI, § 7070(d)","children":[],"tail":", "},{"tag":"date","attrib":{"date":"2026-02-03"},"text":"Feb. 3, 2026","children":[],"tail":", "},{"tag":"ref","attrib":{"href":"/us/stat/140/626"},"text":"140 Stat. 626","children":[],"tail":".)"}],"tail":"\n"}],"tail":null}
