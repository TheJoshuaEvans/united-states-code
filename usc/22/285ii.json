{"tag":"section","attrib":{"id":"id39e70541-3a72-11f1-89e5-b276cb722900","identifier":"/us/usc/t22/s285ii"},"text":null,"children":[{"tag":"num","attrib":{"value":"285ii"},"text":"§ 285ii.","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Asian Development Fund thirteenth replenishment","children":[],"tail":null},{"tag":"subsection","attrib":{"id":"id39e70542-3a72-11f1-89e5-b276cb722900","identifier":"/us/usc/t22/s285ii/a"},"text":null,"children":[{"tag":"num","attrib":{"value":"a"},"text":"(a)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" In general","children":[],"tail":null},{"tag":"content","attrib":{},"text":null,"children":[{"tag":"p","attrib":{},"text":"The United States Governor of the Fund may contribute on behalf of the United States $174,440,000 to the thirteenth replenishment of the resources of the Fund, subject to obtaining the necessary appropriations.","children":[],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"subsection","attrib":{"id":"id39e70543-3a72-11f1-89e5-b276cb722900","identifier":"/us/usc/t22/s285ii/b"},"text":null,"children":[{"tag":"num","attrib":{"value":"b"},"text":"(b)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Authorization of appropriations","children":[],"tail":null},{"tag":"content","attrib":{},"text":null,"children":[{"tag":"p","attrib":{},"text":"In order to pay for the United States contribution provided for in subsection (a), there are authorized to be appropriated, without fiscal year limitation, $174,440,000 for payment by the Secretary of the Treasury.","children":[],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"sourceCredit","attrib":{"id":"id39e70544-3a72-11f1-89e5-b276cb722900"},"text":"(","children":[{"tag":"ref","attrib":{"href":"/us/pl/89/369/s38"},"text":"Pub. L. 89–369, § 38","children":[],"tail":", as added "},{"tag":"ref","attrib":{"href":"/us/pl/119/75/dF/tVI/s7070/c"},"text":"Pub. L. 119–75, div. F, title VI, § 7070(c)","children":[],"tail":", "},{"tag":"date","attrib":{"date":"2026-02-03"},"text":"Feb. 3, 2026","children":[],"tail":", "},{"tag":"ref","attrib":{"href":"/us/stat/140/626"},"text":"140 Stat. 626","children":[],"tail":".)"}],"tail":"\n"}],"tail":null}
