{"tag":"section","attrib":{"id":"id39c34fe9-3a72-11f1-89e5-b276cb722900","identifier":"/us/usc/t22/s262o–5"},"text":null,"children":[{"tag":"num","attrib":{"value":"262o–5"},"text":"§ 262o–5.","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Multilateral development bank support for nuclear energy","children":[],"tail":"\n"},{"tag":"chapeau","attrib":{},"text":"The Secretary of the Treasury shall instruct the United States Executive Director at the International Bank for Reconstruction and Development, the European Bank for Reconstruction and Development, and, as the Secretary finds appropriate, any other multilateral development bank (as defined in ","children":[{"tag":"ref","attrib":{"href":"/us/usc/t22/s262m–7/g"},"text":"section 262m–7(g) of this title","children":[],"tail":") to use the voice, vote, and influence of the United States to advocate for—"}],"tail":null},{"tag":"paragraph","attrib":{"id":"id39c34fea-3a72-11f1-89e5-b276cb722900","identifier":"/us/usc/t22/s262o–5/1"},"text":null,"children":[{"tag":"num","attrib":{"value":"1"},"text":"(1)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" the removal of prohibitions at the respective bank against financial and technical assistance for the generation, transmission, and distribution of nuclear energy, to the extent that the prohibitions apply to nuclear technologies, including small modular reactors, that meet or exceed the quality and safety standards of technologies produced by the United States or a member country of the Organisation for Economic Co-operation and Development; and","children":[],"tail":"\n"}],"tail":"\n"},{"tag":"paragraph","attrib":{"id":"id39c34feb-3a72-11f1-89e5-b276cb722900","identifier":"/us/usc/t22/s262o–5/2"},"text":null,"children":[{"tag":"num","attrib":{"value":"2"},"text":"(2)","children":[],"tail":null},{"tag":"chapeau","attrib":{},"text":" increased internal capacity-building at the respective bank for the purpose of assessing—","children":[],"tail":null},{"tag":"subparagraph","attrib":{"id":"id39c34fec-3a72-11f1-89e5-b276cb722900","identifier":"/us/usc/t22/s262o–5/2/A"},"text":null,"children":[{"tag":"num","attrib":{"value":"A"},"text":"(A)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" the potential role of nuclear energy, including small modular reactors, in the energy systems of client countries; and","children":[],"tail":"\n"}],"tail":"\n"},{"tag":"subparagraph","attrib":{"id":"id39c34fed-3a72-11f1-89e5-b276cb722900","identifier":"/us/usc/t22/s262o–5/2/B"},"text":null,"children":[{"tag":"num","attrib":{"value":"B"},"text":"(B)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" the delivery of financial and technical assistance described in paragraph (1) to the countries.","children":[],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"sourceCredit","attrib":{"id":"id39c34fee-3a72-11f1-89e5-b276cb722900"},"text":"(","children":[{"tag":"ref","attrib":{"href":"/us/pl/95/118/tXV/s1506"},"text":"Pub. L. 95–118, title XV, § 1506","children":[],"tail":", as added "},{"tag":"ref","attrib":{"href":"/us/pl/119/75/dF/tVII/s7070/b/2"},"text":"Pub. L. 119–75, div. F, title VII, § 7070(b)(2)","children":[],"tail":", "},{"tag":"date","attrib":{"date":"2026-02-03"},"text":"Feb. 3, 2026","children":[],"tail":", "},{"tag":"ref","attrib":{"href":"/us/stat/140/624"},"text":"140 Stat. 624","children":[],"tail":".)"}],"tail":"\n"},{"tag":"notes","attrib":{"type":"uscNote","id":"id39c34fef-3a72-11f1-89e5-b276cb722900"},"text":"\n","children":[{"tag":"note","attrib":{"topic":"prospectiveAmendment","id":"id39c34ff0-3a72-11f1-89e5-b276cb722900"},"text":null,"children":[{"tag":"heading","attrib":{},"text":"Termination of Section","children":[],"tail":null},{"tag":"p","attrib":{},"text":"For termination of section by ","children":[{"tag":"ref","attrib":{"href":"/us/pl/119/75/s7070/b/5"},"text":"section 7070(b)(5) of Pub. L. 119–75","children":[],"tail":", see Termination Date note below."}],"tail":"\n"}],"tail":"\n"},{"tag":"note","attrib":{"role":"crossHeading","topic":"statutoryNotes","id":"id39c34ff1-3a72-11f1-89e5-b276cb722900"},"text":null,"children":[{"tag":"heading","attrib":{},"text":null,"children":[{"tag":"b","attrib":{},"text":"Statutory Notes and Related Subsidiaries","children":[],"tail":null}],"tail":null}],"tail":"\n"},{"tag":"note","attrib":{"topic":"terminationDate","id":"id39c34ff2-3a72-11f1-89e5-b276cb722900"},"text":null,"children":[{"tag":"heading","attrib":{},"text":"Termination Date","children":[],"tail":null},{"tag":"p","attrib":{},"text":null,"children":[{"tag":"ref","attrib":{"href":"/us/pl/119/75/dF/tVI/s7070/b/5"},"text":"Pub. L. 119–75, div. F, title VI, § 7070(b)(5)","children":[],"tail":", "},{"tag":"date","attrib":{"date":"2026-02-03"},"text":"Feb. 3, 2026","children":[],"tail":", "},{"tag":"ref","attrib":{"href":"/us/stat/140/625"},"text":"140 Stat. 625","children":[],"tail":", provided that: "},{"tag":"quotedContent","attrib":{"origin":"/us/pl/119/75/dF/tVI/s7070/b/5"},"text":"“The preceding provisions of this subsection [enacting this section, sections 262","children":[{"tag":"i","attrib":{},"text":"o","children":[],"tail":"–6 and 284ee of this title, and provisions set out as a note under "},{"tag":"ref","attrib":{"href":"/us/usc/t22/s262r"},"text":"section 262r of this title","children":[],"tail":"] and the amendments made by the preceding provisions of this subsection shall have no force or effect beginning 10 years after the date of the enactment of this Act ["},{"tag":"date","attrib":{"date":"2026-02-03"},"text":"Feb. 3, 2026","children":[],"tail":"].”"}],"tail":"\n"}],"tail":"\n"}],"tail":"\n"}],"tail":"\n"}],"tail":null}
