{"tag":"section","attrib":{"id":"id5db385bc-86b3-11f1-aae1-ab9d2cf5dce1","identifier":"/us/usc/t12/s1712a"},"text":null,"children":[{"tag":"num","attrib":{"value":"1712a"},"text":"§ 1712a.","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Indexing of FHA multifamily housing loan limits","children":[],"tail":null},{"tag":"subsection","attrib":{"id":"id5db385bd-86b3-11f1-aae1-ab9d2cf5dce1","identifier":"/us/usc/t12/s1712a/a"},"text":null,"children":[{"tag":"num","attrib":{"value":"a"},"text":"(a)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Method of indexing","children":[],"tail":null},{"tag":"chapeau","attrib":{},"text":"The dollar amounts set forth in—","children":[],"tail":null},{"tag":"paragraph","attrib":{"id":"id5db385be-86b3-11f1-aae1-ab9d2cf5dce1","identifier":"/us/usc/t12/s1712a/a/1"},"text":null,"children":[{"tag":"num","attrib":{"value":"1"},"text":"(1)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" ","children":[{"tag":"ref","attrib":{"href":"/us/usc/t12/s1713/c/3/A"},"text":"section 1713(c)(3)(A) of this title","children":[],"tail":";"}],"tail":"\n"}],"tail":"\n"},{"tag":"paragraph","attrib":{"id":"id5db385bf-86b3-11f1-aae1-ab9d2cf5dce1","identifier":"/us/usc/t12/s1712a/a/2"},"text":null,"children":[{"tag":"num","attrib":{"value":"2"},"text":"(2)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" ","children":[{"tag":"ref","attrib":{"href":"/us/usc/t12/s1715e/b/2/A"},"text":"section 1715e(b)(2)(A) of this title","children":[],"tail":";"}],"tail":"\n"}],"tail":"\n"},{"tag":"paragraph","attrib":{"id":"id5db385c0-86b3-11f1-aae1-ab9d2cf5dce1","identifier":"/us/usc/t12/s1712a/a/3"},"text":null,"children":[{"tag":"num","attrib":{"value":"3"},"text":"(3)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" ","children":[{"tag":"ref","attrib":{"href":"/us/usc/t12/s1715k/d/3/B/iii/I"},"text":"section 1715k(d)(3)(B)(iii)(I) of this title","children":[],"tail":";"}],"tail":"\n"}],"tail":"\n"},{"tag":"paragraph","attrib":{"id":"id5db385c1-86b3-11f1-aae1-ab9d2cf5dce1","identifier":"/us/usc/t12/s1712a/a/4"},"text":null,"children":[{"tag":"num","attrib":{"value":"4"},"text":"(4)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" section 1715","children":[{"tag":"i","attrib":{},"text":"l","children":[],"tail":"(d)(3)(ii)(I) of this title;"}],"tail":"\n"}],"tail":"\n"},{"tag":"paragraph","attrib":{"id":"id5db385c2-86b3-11f1-aae1-ab9d2cf5dce1","identifier":"/us/usc/t12/s1712a/a/5"},"text":null,"children":[{"tag":"num","attrib":{"value":"5"},"text":"(5)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" section 1715","children":[{"tag":"i","attrib":{},"text":"l","children":[],"tail":"(d)(4)(ii)(I) of this title;"}],"tail":"\n"}],"tail":"\n"},{"tag":"paragraph","attrib":{"id":"id5db385c3-86b3-11f1-aae1-ab9d2cf5dce1","identifier":"/us/usc/t12/s1712a/a/6"},"text":null,"children":[{"tag":"num","attrib":{"value":"6"},"text":"(6)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" ","children":[{"tag":"ref","attrib":{"href":"/us/usc/t12/s1715v/c/2/A"},"text":"section 1715v(c)(2)(A) of this title","children":[],"tail":"; and"}],"tail":"\n"}],"tail":"\n"},{"tag":"paragraph","attrib":{"id":"id5db385c4-86b3-11f1-aae1-ab9d2cf5dce1","identifier":"/us/usc/t12/s1712a/a/7"},"text":null,"children":[{"tag":"num","attrib":{"value":"7"},"text":"(7)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" ","children":[{"tag":"ref","attrib":{"href":"/us/usc/t12/s1715y/e/3/A"},"text":"section 1715y(e)(3)(A) of this title","children":[],"tail":";"},{"tag":"p","attrib":{},"text":"(collectively hereinafter referred to as the “Dollar Amounts”) shall be adjusted annually, commencing on ","children":[{"tag":"date","attrib":{"date":"2025-07-01"},"text":"July 1, 2025","children":[],"tail":". The adjustment of the Dollar Amounts shall be calculated by the Secretary using the percentage change in the Price Deflator Index of Multifamily Residential Units Under Construction released by the Bureau of the Census from March of the previous year to March of the year in which the adjustment is made, or by the Secretary using an alternative indicator after publishing information about such alternative indicator in the Federal Register for public comment if the Price Deflator Index of Multifamily Residential Units Under Construction is not available or published."}],"tail":"\n"}],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"subsection","attrib":{"id":"id5db385c5-86b3-11f1-aae1-ab9d2cf5dce1","identifier":"/us/usc/t12/s1712a/b"},"text":null,"children":[{"tag":"num","attrib":{"value":"b"},"text":"(b)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Publication","children":[],"tail":null},{"tag":"paragraph","attrib":{"id":"id5db385c6-86b3-11f1-aae1-ab9d2cf5dce1","identifier":"/us/usc/t12/s1712a/b/1"},"text":null,"children":[{"tag":"num","attrib":{"value":"1"},"text":"(1)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" In general","children":[],"tail":null},{"tag":"content","attrib":{},"text":null,"children":[{"tag":"p","attrib":{},"text":"The Secretary shall publish in the Federal Register any adjustments made to the Dollar Amounts.","children":[],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"paragraph","attrib":{"id":"id5db385c7-86b3-11f1-aae1-ab9d2cf5dce1","identifier":"/us/usc/t12/s1712a/b/2"},"text":null,"children":[{"tag":"num","attrib":{"value":"2"},"text":"(2)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Rounding","children":[],"tail":null},{"tag":"content","attrib":{},"text":null,"children":[{"tag":"p","attrib":{},"text":"The dollar amount of any adjustment described in paragraph (1) shall be rounded to the next lower dollar.","children":[],"tail":"\n"}],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"sourceCredit","attrib":{"id":"id5db385c8-86b3-11f1-aae1-ab9d2cf5dce1"},"text":"(","children":[{"tag":"ref","attrib":{"href":"/us/act/1934-06-27/ch847"},"text":"June 27, 1934, ch. 847","children":[],"tail":", title II, § 206A, as added "},{"tag":"ref","attrib":{"href":"/us/pl/107/326/s5/a"},"text":"Pub. L. 107–326, § 5(a)","children":[],"tail":", "},{"tag":"date","attrib":{"date":"2002-12-04"},"text":"Dec. 4, 2002","children":[],"tail":", "},{"tag":"ref","attrib":{"href":"/us/stat/116/2794"},"text":"116 Stat. 2794","children":[],"tail":"; amended "},{"tag":"ref","attrib":{"href":"/us/pl/119/101/tII/s211/a/1"},"text":"Pub. L. 119–101, title II, § 211(a)(1)","children":[],"tail":", "},{"tag":"date","attrib":{"date":"2026-07-11"},"text":"July 11, 2026","children":[],"tail":", "},{"tag":"ref","attrib":{"href":"/us/stat/140/881"},"text":"140 Stat. 881","children":[],"tail":".)"}],"tail":"\n"},{"tag":"notes","attrib":{"type":"uscNote","id":"id5db385c9-86b3-11f1-aae1-ab9d2cf5dce1"},"text":"\n","children":[{"tag":"note","attrib":{"role":"crossHeading","topic":"editorialNotes","id":"id5db385ca-86b3-11f1-aae1-ab9d2cf5dce1"},"text":null,"children":[{"tag":"heading","attrib":{},"text":null,"children":[{"tag":"b","attrib":{},"text":"Editorial Notes","children":[],"tail":null}],"tail":null}],"tail":"\n"},{"tag":"note","attrib":{"topic":"amendments","id":"id5db385cb-86b3-11f1-aae1-ab9d2cf5dce1"},"text":null,"children":[{"tag":"heading","attrib":{},"text":"Amendments","children":[],"tail":null},{"tag":"p","attrib":{},"text":"2026—Subsec. (a). ","children":[{"tag":"ref","attrib":{"href":"/us/pl/119/101/s211/a/1/A"},"text":"Pub. L. 119–101, § 211(a)(1)(A)","children":[],"tail":", substituted in concluding provisions “, commencing on "},{"tag":"date","attrib":{"date":"2025-07-01"},"text":"July 1, 2025","children":[],"tail":". The adjustment of the Dollar Amounts shall be calculated by the Secretary using the percentage change in the Price Deflator Index of Multifamily Residential Units Under Construction released by the Bureau of the Census from March of the previous year to March of the year in which the adjustment is made, or by the Secretary using an alternative indicator after publishing information about such alternative indicator in the Federal Register for public comment if the Price Deflator Index of Multifamily Residential Units Under Construction is not available or published.” for “(commencing in 2004) on the effective date of the Federal Reserve Board’s adjustment of the $400 figure in the Home Ownership and Equity Protection Act of 1994 (HOEPA). The adjustment of the Dollar Amounts shall be calculated using the percentage change in the Consumer Price Index for All Urban Consumers (CPI–U) as applied by the Federal Reserve Board for purposes of the above-described HOEPA adjustment.”"}],"tail":"\n"},{"tag":"p","attrib":{},"text":"Subsec. (b). ","children":[{"tag":"ref","attrib":{"href":"/us/pl/119/101/s211/a/1/B"},"text":"Pub. L. 119–101, § 211(a)(1)(B)","children":[],"tail":", amended subsec. (b) generally. Prior to amendment, text read as follows: “The Federal Reserve Board on a timely basis shall notify the Secretary, or his designee, in writing of the adjustment described in subsection (a) and of the effective date of such adjustment in order to permit the Secretary to undertake publication in the Federal Register of corresponding adjustments to the Dollar Amounts. The dollar amount of any adjustment shall be rounded to the next lower dollar.”"}],"tail":"\n"}],"tail":"\n"},{"tag":"note","attrib":{"role":"crossHeading","topic":"statutoryNotes","id":"id5db385cc-86b3-11f1-aae1-ab9d2cf5dce1"},"text":null,"children":[{"tag":"heading","attrib":{},"text":null,"children":[{"tag":"b","attrib":{},"text":"Statutory Notes and Related Subsidiaries","children":[],"tail":null}],"tail":null}],"tail":"\n"},{"tag":"note","attrib":{"topic":"miscellaneous","id":"id5db385cd-86b3-11f1-aae1-ab9d2cf5dce1"},"text":null,"children":[{"tag":"heading","attrib":{},"text":"Construction of 2026 Amendment","children":[],"tail":null},{"tag":"p","attrib":{},"text":null,"children":[{"tag":"ref","attrib":{"href":"/us/pl/119/101/tII/s211/b"},"text":"Pub. L. 119–101, title II, § 211(b)","children":[],"tail":", "},{"tag":"date","attrib":{"date":"2026-07-11"},"text":"July 11, 2026","children":[],"tail":", "},{"tag":"ref","attrib":{"href":"/us/stat/140/883"},"text":"140 Stat. 883","children":[],"tail":", provided that: "},{"tag":"quotedContent","attrib":{"origin":"/us/pl/119/101/tII/s211/b"},"text":"“Nothing in this section [amending this section and sections 1713, 1715e, 1715k, 1715","children":[{"tag":"i","attrib":{},"text":"l","children":[],"tail":", 1715v, and 1715y of this title] or the amendments made by this section may be construed to limit the authority of the Secretary of Housing and Urban Development to revise the statutory exceptions for high-cost percentage and high-cost areas annual indexing.”"}],"tail":"\n"}],"tail":"\n"}],"tail":"\n"}],"tail":"\n"}],"tail":null}
