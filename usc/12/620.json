{"tag":"section","attrib":{"id":"id5d2e01ae-86b3-11f1-aae1-ab9d2cf5dce1","identifier":"/us/usc/t12/s620"},"text":null,"children":[{"tag":"num","attrib":{"value":"620"},"text":"§ 620.","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Members of Board of Governors of the Federal Reserve System without interest in corporation","children":[],"tail":null},{"tag":"content","attrib":{},"text":"\n","children":[{"tag":"p","attrib":{},"text":"No member of the Board of Governors of the Federal Reserve System shall be an officer or director of any corporation organized under the provisions of this subchapter or of any corporation engaged in similar business organized under the laws of any State, nor hold stock in any such corporation, and before entering upon his duties as a member of the Board of Governors of the Federal Reserve System he shall certify under oath to the Secretary of the Treasury that he has complied with this requirement.","children":[],"tail":"\n"}],"tail":null},{"tag":"sourceCredit","attrib":{"id":"id5d2e01af-86b3-11f1-aae1-ab9d2cf5dce1"},"text":"(","children":[{"tag":"ref","attrib":{"href":"/us/act/1913-12-23/ch6/s25A"},"text":"Dec. 23, 1913, ch. 6, § 25A","children":[],"tail":" (par.), formerly § 25(a), as added "},{"tag":"ref","attrib":{"href":"/us/act/1919-12-24/ch18"},"text":"Dec. 24, 1919, ch. 18","children":[],"tail":", "},{"tag":"ref","attrib":{"href":"/us/stat/41/378"},"text":"41 Stat. 378","children":[],"tail":"; amended "},{"tag":"ref","attrib":{"href":"/us/act/1935-08-23/ch614"},"text":"Aug. 23, 1935, ch. 614","children":[],"tail":", title II, § 203(a), "},{"tag":"ref","attrib":{"href":"/us/stat/49/704"},"text":"49 Stat. 704","children":[],"tail":"; renumbered § 25A, "},{"tag":"ref","attrib":{"href":"/us/pl/102/242/tI/s142/e/2"},"text":"Pub. L. 102–242, title I, § 142(e)(2)","children":[],"tail":", "},{"tag":"date","attrib":{"date":"1991-12-19"},"text":"Dec. 19, 1991","children":[],"tail":", "},{"tag":"ref","attrib":{"href":"/us/stat/105/2281"},"text":"105 Stat. 2281","children":[],"tail":".)"}],"tail":"\n"},{"tag":"notes","attrib":{"type":"uscNote","id":"id5d2e01b0-86b3-11f1-aae1-ab9d2cf5dce1"},"text":"\n","children":[{"tag":"note","attrib":{"role":"crossHeading","topic":"editorialNotes","id":"id5d2e01b1-86b3-11f1-aae1-ab9d2cf5dce1"},"text":null,"children":[{"tag":"heading","attrib":{},"text":null,"children":[{"tag":"b","attrib":{},"text":"Editorial Notes","children":[],"tail":null}],"tail":null}],"tail":"\n"},{"tag":"note","attrib":{"topic":"referencesInText","id":"id5d2e01b2-86b3-11f1-aae1-ab9d2cf5dce1"},"text":"\n","children":[{"tag":"heading","attrib":{},"text":"References in Text","children":[],"tail":null},{"tag":"p","attrib":{},"text":"This subchapter, referred to in text, was in the original “this section”, meaning section 25A of act ","children":[{"tag":"date","attrib":{"date":"1913-12-23"},"text":"Dec. 23, 1913","children":[],"tail":", which is classified to this subchapter (§ 611 et seq.)."}],"tail":"\n"}],"tail":"\n"},{"tag":"note","attrib":{"topic":"codification","id":"id5d2e01b3-86b3-11f1-aae1-ab9d2cf5dce1"},"text":null,"children":[{"tag":"heading","attrib":{},"text":"Codification","children":[],"tail":"\n"},{"tag":"p","attrib":{},"text":"Section is comprised of par. 12 (undesignated) of section 25A of act ","children":[{"tag":"date","attrib":{"date":"1913-12-23"},"text":"Dec. 23, 1913","children":[],"tail":", which comprises this subchapter. For complete classification of section 25A of this Act, see Codification note set out under "},{"tag":"ref","attrib":{"href":"/us/usc/t12/s611"},"text":"section 611 of this title","children":[],"tail":"."}],"tail":"\n"}],"tail":"\n"},{"tag":"note","attrib":{"role":"crossHeading","topic":"statutoryNotes","id":"id5d2e01b4-86b3-11f1-aae1-ab9d2cf5dce1"},"text":null,"children":[{"tag":"heading","attrib":{},"text":null,"children":[{"tag":"b","attrib":{},"text":"Statutory Notes and Related Subsidiaries","children":[],"tail":null}],"tail":null}],"tail":"\n"},{"tag":"note","attrib":{"topic":"changeOfName","id":"id5d2e01b5-86b3-11f1-aae1-ab9d2cf5dce1"},"text":"\n","children":[{"tag":"heading","attrib":{},"text":"Change of Name","children":[],"tail":"\n"},{"tag":"p","attrib":{},"text":"Section 203(a) of act ","children":[{"tag":"date","attrib":{"date":"1935-08-23"},"text":"Aug. 23, 1935","children":[],"tail":", changed name of Federal Reserve Board to Board of Governors of the Federal Reserve System."}],"tail":"\n"}],"tail":"\n"}],"tail":"\n"}],"tail":null}
