{"tag":"section","attrib":{"id":"id5d9bb820-86b3-11f1-aae1-ab9d2cf5dce1","identifier":"/us/usc/t12/s1701z–12"},"text":null,"children":[{"tag":"num","attrib":{"value":"1701z–12"},"text":"§ 1701z–12.","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Housing access","children":[],"tail":null},{"tag":"content","attrib":{},"text":"\n","children":[{"tag":"p","attrib":{},"text":"The Secretary shall require any purchaser of a multifamily housing project owned by the Secretary which is sold on or after ","children":[{"tag":"date","attrib":{"date":"1978-10-01"},"text":"October 1, 1978","children":[],"tail":", to agree not to refuse unreasonably to lease a vacant dwelling unit in the project which rents for an amount not greater than the fair market rent for a comparable unit in the area as determined by the Secretary under "},{"tag":"ref","attrib":{"href":"/us/usc/t42/s1437f"},"text":"section 1437f of title 42","children":[],"tail":" to a holder of a certificate of eligibility under that section solely because of such prospective tenant’s status as a certificate holder."}],"tail":"\n"}],"tail":null},{"tag":"sourceCredit","attrib":{"id":"id5d9bb821-86b3-11f1-aae1-ab9d2cf5dce1"},"text":"(","children":[{"tag":"ref","attrib":{"href":"/us/pl/95/557/tII/s204"},"text":"Pub. L. 95–557, title II, § 204","children":[],"tail":", "},{"tag":"date","attrib":{"date":"1978-10-31"},"text":"Oct. 31, 1978","children":[],"tail":", "},{"tag":"ref","attrib":{"href":"/us/stat/92/2090"},"text":"92 Stat. 2090","children":[],"tail":".)"}],"tail":"\n"},{"tag":"notes","attrib":{"type":"uscNote","id":"id5d9bb822-86b3-11f1-aae1-ab9d2cf5dce1"},"text":"\n","children":[{"tag":"note","attrib":{"role":"crossHeading","topic":"editorialNotes","id":"id5d9bb823-86b3-11f1-aae1-ab9d2cf5dce1"},"text":null,"children":[{"tag":"heading","attrib":{},"text":null,"children":[{"tag":"b","attrib":{},"text":"Editorial Notes","children":[],"tail":null}],"tail":null}],"tail":"\n"},{"tag":"note","attrib":{"topic":"codification","id":"id5d9bb824-86b3-11f1-aae1-ab9d2cf5dce1"},"text":null,"children":[{"tag":"heading","attrib":{},"text":"Codification","children":[],"tail":"\n"},{"tag":"p","attrib":{},"text":"Section was enacted as part of the Housing and Community Development Amendments of 1978, and not as part of the National Housing Act which comprises this chapter.","children":[],"tail":"\n"}],"tail":"\n"}],"tail":"\n"}],"tail":null}
