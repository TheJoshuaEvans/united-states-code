{"tag":"section","attrib":{"id":"id5eca9b5b-86b3-11f1-aae1-ab9d2cf5dce1","identifier":"/us/usc/t12/s2608"},"text":null,"children":[{"tag":"num","attrib":{"value":"2608"},"text":"§ 2608.","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Title companies; liability of seller","children":[],"tail":null},{"tag":"subsection","attrib":{"id":"id5eca9b5c-86b3-11f1-aae1-ab9d2cf5dce1","identifier":"/us/usc/t12/s2608/a"},"text":null,"children":[{"tag":"num","attrib":{"value":"a"},"text":"(a)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" No seller of property that will be purchased with the assistance of a federally related mortgage loan shall require directly or indirectly, as a condition to selling the property, that title insurance covering the property be purchased by the buyer from any particular title company.","children":[],"tail":"\n"}],"tail":"\n"},{"tag":"subsection","attrib":{"id":"id5eca9b5d-86b3-11f1-aae1-ab9d2cf5dce1","identifier":"/us/usc/t12/s2608/b"},"text":null,"children":[{"tag":"num","attrib":{"value":"b"},"text":"(b)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" Any seller who violates the provisions of subsection (a) shall be liable to the buyer in an amount equal to three times all charges made for such title insurance.","children":[],"tail":"\n"}],"tail":"\n"},{"tag":"sourceCredit","attrib":{"id":"id5eca9b5e-86b3-11f1-aae1-ab9d2cf5dce1"},"text":"(","children":[{"tag":"ref","attrib":{"href":"/us/pl/93/533/s9"},"text":"Pub. L. 93–533, § 9","children":[],"tail":", "},{"tag":"date","attrib":{"date":"1974-12-22"},"text":"Dec. 22, 1974","children":[],"tail":", "},{"tag":"ref","attrib":{"href":"/us/stat/88/1728"},"text":"88 Stat. 1728","children":[],"tail":".)"}],"tail":"\n"},{"tag":"notes","attrib":{"type":"uscNote","id":"id5eca9b5f-86b3-11f1-aae1-ab9d2cf5dce1"},"text":"\n","children":[{"tag":"note","attrib":{"role":"crossHeading","topic":"statutoryNotes","id":"id5eca9b60-86b3-11f1-aae1-ab9d2cf5dce1"},"text":null,"children":[{"tag":"heading","attrib":{},"text":null,"children":[{"tag":"b","attrib":{},"text":"Statutory Notes and Related Subsidiaries","children":[],"tail":null}],"tail":null}],"tail":"\n"},{"tag":"note","attrib":{"topic":"effectiveDate","id":"id5eca9b61-86b3-11f1-aae1-ab9d2cf5dce1"},"text":null,"children":[{"tag":"heading","attrib":{},"text":"Effective Date","children":[],"tail":null},{"tag":"p","attrib":{},"text":"Section effective 180 days after ","children":[{"tag":"date","attrib":{"date":"1974-12-22"},"text":"Dec. 22, 1974","children":[],"tail":", see "},{"tag":"ref","attrib":{"href":"/us/pl/93/533/s20"},"text":"section 20 of Pub. L. 93–533","children":[],"tail":", set out as a note under "},{"tag":"ref","attrib":{"href":"/us/usc/t12/s2601"},"text":"section 2601 of this title","children":[],"tail":"."}],"tail":"\n"}],"tail":"\n"}],"tail":"\n"}],"tail":null}
