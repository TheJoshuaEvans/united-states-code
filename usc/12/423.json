{"tag":"section","attrib":{"id":"id5d248b96-86b3-11f1-aae1-ab9d2cf5dce1","identifier":"/us/usc/t12/s423"},"text":null,"children":[{"tag":"num","attrib":{"value":"423"},"text":"§ 423.","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Central bank digital currency","children":[],"tail":null},{"tag":"subsection","attrib":{"id":"id5d248b97-86b3-11f1-aae1-ab9d2cf5dce1","identifier":"/us/usc/t12/s423/a"},"text":null,"children":[{"tag":"num","attrib":{"value":"a"},"text":"(a)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Definitions","children":[],"tail":null},{"tag":"chapeau","attrib":{},"text":"In this section:","children":[],"tail":null},{"tag":"paragraph","attrib":{"id":"id5d248b98-86b3-11f1-aae1-ab9d2cf5dce1","identifier":"/us/usc/t12/s423/a/1"},"text":null,"children":[{"tag":"num","attrib":{"value":"1"},"text":"(1)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Central bank digital currency","children":[],"tail":null},{"tag":"chapeau","attrib":{},"text":"The term “central bank digital currency” means a digital asset that—","children":[],"tail":null},{"tag":"subparagraph","attrib":{"id":"id5d248b99-86b3-11f1-aae1-ab9d2cf5dce1","identifier":"/us/usc/t12/s423/a/1/A"},"text":null,"children":[{"tag":"num","attrib":{"value":"A"},"text":"(A)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" is denominated in United States dollars;","children":[],"tail":"\n"}],"tail":"\n"},{"tag":"subparagraph","attrib":{"id":"id5d248b9a-86b3-11f1-aae1-ab9d2cf5dce1","identifier":"/us/usc/t12/s423/a/1/B"},"text":null,"children":[{"tag":"num","attrib":{"value":"B"},"text":"(B)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" is a United States currency;","children":[],"tail":"\n"}],"tail":"\n"},{"tag":"subparagraph","attrib":{"id":"id5d248b9b-86b3-11f1-aae1-ab9d2cf5dce1","identifier":"/us/usc/t12/s423/a/1/C"},"text":null,"children":[{"tag":"num","attrib":{"value":"C"},"text":"(C)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" is a direct liability of the Federal Reserve System; and","children":[],"tail":"\n"}],"tail":"\n"},{"tag":"subparagraph","attrib":{"id":"id5d248b9c-86b3-11f1-aae1-ab9d2cf5dce1","identifier":"/us/usc/t12/s423/a/1/D"},"text":null,"children":[{"tag":"num","attrib":{"value":"D"},"text":"(D)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" is widely available to the general public.","children":[],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"paragraph","attrib":{"id":"id5d248b9d-86b3-11f1-aae1-ab9d2cf5dce1","identifier":"/us/usc/t12/s423/a/2"},"text":null,"children":[{"tag":"num","attrib":{"value":"2"},"text":"(2)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Digital asset","children":[],"tail":null},{"tag":"content","attrib":{},"text":null,"children":[{"tag":"p","attrib":{},"text":"The term “digital asset” has the meaning given the term in ","children":[{"tag":"ref","attrib":{"href":"/us/usc/t12/s5901"},"text":"section 5901 of this title","children":[],"tail":"."}],"tail":"\n"}],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"subsection","attrib":{"id":"id5d248b9e-86b3-11f1-aae1-ab9d2cf5dce1","identifier":"/us/usc/t12/s423/b"},"text":null,"children":[{"tag":"num","attrib":{"value":"b"},"text":"(b)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Prohibition","children":[],"tail":null},{"tag":"content","attrib":{},"text":null,"children":[{"tag":"p","attrib":{},"text":"Except as provided in subsection (c), the Board of Governors of the Federal Reserve System or a Federal reserve bank may not issue or create a central bank digital currency or any digital asset that is substantially similar to a central bank digital currency directly or indirectly through a financial institution or other intermediary.","children":[],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"subsection","attrib":{"id":"id5d248b9f-86b3-11f1-aae1-ab9d2cf5dce1","identifier":"/us/usc/t12/s423/c"},"text":null,"children":[{"tag":"num","attrib":{"value":"c"},"text":"(c)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Exception","children":[],"tail":null},{"tag":"content","attrib":{},"text":null,"children":[{"tag":"p","attrib":{},"text":"Subsection (b) shall not prohibit any dollar-denominated currency that is open, permissionless, and private, and fully preserves the privacy protections of United States coins and physical currency.","children":[],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"subsection","attrib":{"id":"id5d248ba0-86b3-11f1-aae1-ab9d2cf5dce1","identifier":"/us/usc/t12/s423/d"},"text":null,"children":[{"tag":"num","attrib":{"value":"d"},"text":"(d)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Sunset","children":[],"tail":null},{"tag":"content","attrib":{},"text":null,"children":[{"tag":"p","attrib":{},"text":"This provisions of this section shall cease to be effective on ","children":[{"tag":"date","attrib":{"date":"2030-12-31"},"text":"December 31, 2030","children":[],"tail":"."}],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"subsection","attrib":{"id":"id5d248ba1-86b3-11f1-aae1-ab9d2cf5dce1","identifier":"/us/usc/t12/s423/e"},"text":null,"children":[{"tag":"num","attrib":{"value":"e"},"text":"(e)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Rule of construction","children":[],"tail":null},{"tag":"content","attrib":{},"text":null,"children":[{"tag":"p","attrib":{},"text":"Nothing in this section shall be construed to allow the Board of Governors of the Federal Reserve System to issue a central bank digital currency or any digital asset that is substantially similar to a central bank digital currency directly or indirectly absent authorization by an Act of Congress.","children":[],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"sourceCredit","attrib":{"id":"id5d248ba2-86b3-11f1-aae1-ab9d2cf5dce1"},"text":"(","children":[{"tag":"ref","attrib":{"href":"/us/act/1913-12-23/ch6/s16A"},"text":"Dec. 23, 1913, ch. 6, § 16A","children":[],"tail":", as added "},{"tag":"ref","attrib":{"href":"/us/pl/119/101/tXI/s1101"},"text":"Pub. L. 119–101, title XI, § 1101","children":[],"tail":", "},{"tag":"date","attrib":{"date":"2026-07-11"},"text":"July 11, 2026","children":[],"tail":", "},{"tag":"ref","attrib":{"href":"/us/stat/140/983"},"text":"140 Stat. 983","children":[],"tail":".)"}],"tail":"\n"}],"tail":null}
