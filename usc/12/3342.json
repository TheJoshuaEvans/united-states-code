{"tag":"section","attrib":{"id":"id5eddad38-86b3-11f1-aae1-ab9d2cf5dce1","identifier":"/us/usc/t12/s3342"},"text":null,"children":[{"tag":"num","attrib":{"value":"3342"},"text":"§ 3342.","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Transactions requiring services of State certified appraiser","children":[],"tail":null},{"tag":"subsection","attrib":{"id":"id5eddad39-86b3-11f1-aae1-ab9d2cf5dce1","identifier":"/us/usc/t12/s3342/a"},"text":null,"children":[{"tag":"num","attrib":{"value":"a"},"text":"(a)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" In general","children":[],"tail":null},{"tag":"chapeau","attrib":{},"text":"In determining whether an appraisal in connection with a federally related transaction shall be performed by a State certified appraiser, an agency or instrumentality under this chapter shall consider whether transactions, either individually or collectively, are of sufficient financial or public policy importance to the United States that an individual who performs an appraisal in connection with such transactions should be a State certified appraiser, except that—","children":[],"tail":null},{"tag":"paragraph","attrib":{"id":"id5eddad3a-86b3-11f1-aae1-ab9d2cf5dce1","identifier":"/us/usc/t12/s3342/a/1"},"text":null,"children":[{"tag":"num","attrib":{"value":"1"},"text":"(1)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" a State certified appraiser shall be required for all federally related transactions having a value of $1,000,000 or more; and","children":[],"tail":"\n"}],"tail":"\n"},{"tag":"paragraph","attrib":{"id":"id5eddad3b-86b3-11f1-aae1-ab9d2cf5dce1","identifier":"/us/usc/t12/s3342/a/2"},"text":null,"children":[{"tag":"num","attrib":{"value":"2"},"text":"(2)","children":[],"tail":null},{"tag":"content","attrib":{},"text":" 1-to-4 unit, single family residential appraisals may be performed by State licensed appraisers unless the size and complexity requires a State certified appraiser, where a complex 1-to-4 unit single family residential appraisal means an appraisal for which the property to be appraised, the form of ownership, the property characteristics, or the market conditions are atypical.","children":[],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"subsection","attrib":{"id":"id5eddad3c-86b3-11f1-aae1-ab9d2cf5dce1","identifier":"/us/usc/t12/s3342/b"},"text":null,"children":[{"tag":"num","attrib":{"value":"b"},"text":"(b)","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Use of State credentialed trainee appraisers","children":[],"tail":null},{"tag":"content","attrib":{},"text":null,"children":[{"tag":"p","attrib":{},"text":"In performing an appraisal under this section, a State certified appraiser may use the assistance of a State credentialed trainee appraiser or an unlicensed trainee appraiser, except that the State certified appraiser assisted by a trainee shall be liable for appraisal and valuation work.","children":[],"tail":"\n"}],"tail":"\n"}],"tail":"\n"},{"tag":"sourceCredit","attrib":{"id":"id5eddad3d-86b3-11f1-aae1-ab9d2cf5dce1"},"text":"(","children":[{"tag":"ref","attrib":{"href":"/us/pl/101/73/tXI/s1113"},"text":"Pub. L. 101–73, title XI, § 1113","children":[],"tail":", "},{"tag":"date","attrib":{"date":"1989-08-09"},"text":"Aug. 9, 1989","children":[],"tail":", "},{"tag":"ref","attrib":{"href":"/us/stat/103/514"},"text":"103 Stat. 514","children":[],"tail":"; "},{"tag":"ref","attrib":{"href":"/us/pl/111/203/tXIV/s1473/e/2"},"text":"Pub. L. 111–203, title XIV, § 1473(e)(2)","children":[],"tail":", "},{"tag":"date","attrib":{"date":"2010-07-21"},"text":"July 21, 2010","children":[],"tail":", "},{"tag":"ref","attrib":{"href":"/us/stat/124/2191"},"text":"124 Stat. 2191","children":[],"tail":"; "},{"tag":"ref","attrib":{"href":"/us/pl/119/101/tIV/s403/c/3"},"text":"Pub. L. 119–101, title IV, § 403(c)(3)","children":[],"tail":", "},{"tag":"date","attrib":{"date":"2026-07-11"},"text":"July 11, 2026","children":[],"tail":", "},{"tag":"ref","attrib":{"href":"/us/stat/140/901"},"text":"140 Stat. 901","children":[],"tail":".)"}],"tail":"\n"},{"tag":"notes","attrib":{"type":"uscNote","id":"id5eddad3e-86b3-11f1-aae1-ab9d2cf5dce1"},"text":"\n","children":[{"tag":"note","attrib":{"role":"crossHeading","topic":"editorialNotes","id":"id5eddad3f-86b3-11f1-aae1-ab9d2cf5dce1"},"text":null,"children":[{"tag":"heading","attrib":{},"text":null,"children":[{"tag":"b","attrib":{},"text":"Editorial Notes","children":[],"tail":null}],"tail":null}],"tail":"\n"},{"tag":"note","attrib":{"topic":"amendments","id":"id5eddad40-86b3-11f1-aae1-ab9d2cf5dce1"},"text":null,"children":[{"tag":"heading","attrib":{},"text":"Amendments","children":[],"tail":null},{"tag":"p","attrib":{},"text":"2026—","children":[{"tag":"ref","attrib":{"href":"/us/pl/119/101"},"text":"Pub. L. 119–101","children":[],"tail":" designated existing provisions as subsec. (a), inserted heading, and added subsec. (b)."}],"tail":"\n"},{"tag":"p","attrib":{},"text":"2010—Par. (2). ","children":[{"tag":"ref","attrib":{"href":"/us/pl/111/203"},"text":"Pub. L. 111–203","children":[],"tail":" inserted “, where a complex 1-to-4 unit single family residential appraisal means an appraisal for which the property to be appraised, the form of ownership, the property characteristics, or the market conditions are atypical” before the period."}],"tail":"\n"}],"tail":"\n"},{"tag":"note","attrib":{"role":"crossHeading","topic":"statutoryNotes","id":"id5eddad41-86b3-11f1-aae1-ab9d2cf5dce1"},"text":null,"children":[{"tag":"heading","attrib":{},"text":null,"children":[{"tag":"b","attrib":{},"text":"Statutory Notes and Related Subsidiaries","children":[],"tail":null}],"tail":null}],"tail":"\n"},{"tag":"note","attrib":{"topic":"effectiveDateOfAmendment","id":"id5eddad42-86b3-11f1-aae1-ab9d2cf5dce1"},"text":null,"children":[{"tag":"heading","attrib":{},"text":"Effective Date of 2010 Amendment","children":[],"tail":null},{"tag":"p","attrib":{},"text":"Amendment by ","children":[{"tag":"ref","attrib":{"href":"/us/pl/111/203"},"text":"Pub. L. 111–203","children":[],"tail":" effective on the date on which final regulations implementing that amendment take effect, or on the date that is 18 months after the designated transfer date if such regulations have not been issued by that date, see "},{"tag":"ref","attrib":{"href":"/us/pl/111/203/s1400/c"},"text":"section 1400(c) of Pub. L. 111–203","children":[],"tail":", set out as a note under "},{"tag":"ref","attrib":{"href":"/us/usc/t15/s1601"},"text":"section 1601 of Title 15","children":[],"tail":", Commerce and Trade."}],"tail":"\n"}],"tail":"\n"}],"tail":"\n"}],"tail":null}
