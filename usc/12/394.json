{"tag":"section","attrib":{"id":"id5d221b27-86b3-11f1-aae1-ab9d2cf5dce1","identifier":"/us/usc/t12/s394"},"text":null,"children":[{"tag":"num","attrib":{"value":"394"},"text":"§ 394.","children":[],"tail":null},{"tag":"heading","attrib":{},"text":" Federal reserve banks as depositaries for and fiscal agents of Home Owners’ Loan Corporation","children":[],"tail":null},{"tag":"content","attrib":{},"text":"\n","children":[{"tag":"p","attrib":{},"text":"The Federal Reserve banks are authorized, with the approval of the Secretary of the Treasury, to act as depositaries, custodians, and fiscal agents for the Home Owners’ Loan Corporation.","children":[],"tail":"\n"}],"tail":null},{"tag":"sourceCredit","attrib":{"id":"id5d221b28-86b3-11f1-aae1-ab9d2cf5dce1"},"text":"(","children":[{"tag":"ref","attrib":{"href":"/us/act/1934-04-27/ch168/s8"},"text":"Apr. 27, 1934, ch. 168, § 8","children":[],"tail":", "},{"tag":"ref","attrib":{"href":"/us/stat/48/646"},"text":"48 Stat. 646","children":[],"tail":".)"}],"tail":"\n"},{"tag":"notes","attrib":{"type":"uscNote","id":"id5d221b29-86b3-11f1-aae1-ab9d2cf5dce1"},"text":"\n","children":[{"tag":"note","attrib":{"role":"crossHeading","topic":"statutoryNotes","id":"id5d221b2a-86b3-11f1-aae1-ab9d2cf5dce1"},"text":null,"children":[{"tag":"heading","attrib":{},"text":null,"children":[{"tag":"b","attrib":{},"text":"Statutory Notes and Related Subsidiaries","children":[],"tail":null}],"tail":null}],"tail":"\n"},{"tag":"note","attrib":{"topic":"miscellaneous","id":"id5d221b2b-86b3-11f1-aae1-ab9d2cf5dce1"},"text":"\n","children":[{"tag":"heading","attrib":{},"text":"Abolition of Home Owners’ Loan Corporation","children":[],"tail":"\n"},{"tag":"p","attrib":{},"text":"For dissolution and abolishment of Home Owners’ Loan Corporation, referred to in this section, by ","children":[{"tag":"ref","attrib":{"href":"/us/act/1953-06-30/ch170/s21"},"text":"act June 30, 1953, ch. 170, § 21","children":[],"tail":", "},{"tag":"ref","attrib":{"href":"/us/stat/67/126"},"text":"67 Stat. 126","children":[],"tail":", see note set out under "},{"tag":"ref","attrib":{"href":"/us/usc/t12/s1463"},"text":"section 1463 of this title","children":[],"tail":"."}],"tail":"\n"}],"tail":"\n"}],"tail":"\n"}],"tail":null}
